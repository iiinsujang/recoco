    "다른 사진을 더 선택하면 추천을 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사진을 더 선택하면 추천을 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose more photos to find new suggestions."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери още снимки за нови предложения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte další fotky pro nové návrhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg flere fotos for at få nye forslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle weitere Fotos aus, um darin Vorschläge zu finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε περισσότερες φωτογραφίες για να βρούμε νέες προτάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona más fotos para encontrar nuevas sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uute soovituste leidmiseks vali veel fotosid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse lisää kuvia saadaksesi uusia ehdotuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez d’autres photos pour obtenir de nouvelles suggestions."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh tuilleadh grianghraf chun moltaí nua a fháil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite više fotografija za nove prijedloge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új javaslatokhoz válassz további fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu fleiri myndir til að finna nýjar tillögur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona altre foto per trovare nuovi suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を追加で選ぶと、その中からおすすめを探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirink daugiau nuotraukų naujiems pasiūlymams."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlasi vairāk attēlu, lai atrastu jaunus ieteikumus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel aktar ritratti biex issib suġġerimenti ġodda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg flere bilder for å få nye forslag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies meer foto’s voor nieuwe suggesties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz więcej zdjęć, by znaleźć nowe propozycje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleciona mais fotografias para encontrar novas sugestões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege mai multe poze pentru sugestii noi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte ďalšie fotky a nájdite nové návrhy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nove predloge izberite več fotografij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj fler foton för att få nya förslag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปเพิ่มเพื่อค้นหาคำแนะนำใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thêm ảnh để tìm gợi ý mới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多選一些照片，我們就能從中尋找更多建議。"
          }
        }
      }
    },
    "다른 사진을 선택하면 그 안에서 다시 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사진을 선택하면 그 안에서 다시 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose other photos and we’ll check those for suggestions."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери други снимки и ще потърсим предложения сред тях."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jiné fotky a vyhledáme mezi nimi návrhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg andre fotos, så leder vi efter forslag blandt dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle andere Fotos aus, dann suchen wir dort nach Vorschlägen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε άλλες φωτογραφίες και θα ψάξουμε ανάμεσά τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otras fotos y buscaremos sugerencias entre ellas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali teised fotod, et otsida neist uusi soovitusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse muita kuvia, niin etsimme ehdotuksia niistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez d’autres photos et nous y chercherons des suggestions."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh grianghraif eile agus lorgóimid moltaí iontu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite druge fotografije i među njima ćemo potražiti prijedloge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz más fotókat, és azok között keresünk javaslatot."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu aðrar myndir og við leitum að tillögum meðal þeirra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli altre foto e cercheremo suggerimenti tra quelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の写真を選ぶと、その中からもう一度探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirink kitas nuotraukas, o mes patikrinsime, ką pasiūlyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlies citus attēlus, un meklēsim ieteikumus starp tiem."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel ritratti oħra u nfittxu suġġerimenti fosthom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg andre bilder, så ser vi etter forslag blant dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
