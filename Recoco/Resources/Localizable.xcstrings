        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο έλεγχος του τοπικού χώρου αποθήκευσης. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar el almacenamiento local. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadme salvestusruumi ei saanud kontrollida. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallista tallennustilaa ei voitu tarkistaa. Yritä uudelleen."
