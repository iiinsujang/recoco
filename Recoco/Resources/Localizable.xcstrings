        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er et utkast. Lagre det for å beholde teksten og en liten forhåndsvisning av bildet på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een concept. Bewaar het om de tekst en een klein fotovoorbeeld op dit apparaat te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To szkic. Zapisz go, aby zachować tekst i mały podgląd zdjęcia na urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um rascunho. Guarda-o para manteres o texto e uma pequena pré-visualização da fotografia neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este o ciornă. Salveaz-o pentru a păstra textul și o miniatură a pozei pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je koncept. Uložením v zariadení uchováte text aj malý náhľad fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je osnutek. Če ga shranite, bosta besedilo in majhen predogled fotografije ostala v napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är ett utkast. Spara för att behålla texten och en liten bildförhandsvisning på enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือฉบับร่าง กดบันทึกเพื่อเก็บข้อความและรูปตัวอย่างขนาดเล็กไว้ในเครื่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bản nháp. Hãy lưu để giữ nội dung và ảnh xem trước nhỏ trên thiết bị."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前是草稿。儲存後，文字與照片縮圖會保留在這部裝置上。"
          }
        }
      }
    },
    "아직 필요한 사진인지 살펴보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 필요한 사진인지 살펴보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See if you still need this photo."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Виж дали тази снимка още ти трябва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, jestli tuto fotku ještě potřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, om du stadig har brug for dette foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob du dieses Foto noch brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες αν χρειάζεσαι ακόμη αυτή τη φωτογραφία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si aún necesitas esta foto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaata, kas seda fotot on veel vaja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista, tarvitsetko tätä kuvaa vielä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez si vous avez encore besoin de cette photo."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Féach an bhfuil an grianghraf seo de dhíth ort fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite trebate li još ovu fotografiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg, szükséged van-e még erre a fotóra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu hvort þú þurfir þessa mynd enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda se questa foto ti serve ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ必要な写真か、見直してみましょう。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pažiūrėk, ar šios nuotraukos vis dar reikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudi, vai šis attēls tev joprojām vajadzīgs."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara jekk għadx għandek bżonn dan ir-ritratt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se om du fortsatt trenger dette bildet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk of je deze foto nog nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy nadal potrzebujesz tego zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê se ainda precisas desta fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică dacă mai ai nevoie de această poză."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite sa, či túto fotku ešte potrebujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite, ali to fotografijo še potrebujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se efter om du fortfarande behöver fotot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองดูว่ายังต้องการรูปนี้อยู่ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem liệu bạn còn cần ảnh này không nhé."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看這張照片是否還需要保留。"
          }
        }
      }
    },
    "안내 문구가 있고 촬영 후 %lld일이 지났어요. 일시적인 참고 정보일 수 있지만 사용이 끝났는지는 직접 확인해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안내 문구가 있고 촬영 후 %lld일이 지났어요. 일시적인 참고 정보일 수 있지만 사용이 끝났는지는 직접 확인해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days since you took this photo: %lld. It contains instructions that may have been temporary. Check whether you still need them."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни от заснемането: %lld. Информацията може да е била нужна само за кратко. Провери дали още ти трябва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dní od pořízení: %lld. Pokyny na fotce mohly být jen dočasné. Podívejte se, zda je ještě potřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dage siden optagelsen: %lld. Fotoet viser anvisninger, der kan have været midlertidige. Tjek, om du stadig har brug for dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage seit der Aufnahme: %lld. Die Hinweise auf dem Bild waren vielleicht nur vorübergehend wichtig. Prüfe, ob du sie noch brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ημέρες από τη λήψη: %lld. Η φωτογραφία περιέχει οδηγίες που ίσως χρειάστηκες προσωρινά. Έλεγξε αν τις χρειάζεσαι ακόμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días desde que tomaste la foto: %lld. Contiene indicaciones que quizá solo necesitabas por un tiempo. Comprueba si aún te sirven."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pildistamisest möödunud päevi: %lld. Fotol on juhised, mida võis vaja minna ajutiselt. Vaata, kas neid on veel vaja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päiviä kuvan ottamisesta: %lld. Kuvan ohjeet ovat saattaneet olla tilapäisiä. Tarkista, tarvitsetko niitä vielä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours depuis la prise de vue : %lld. Ces indications étaient peut-être temporaires. Vérifiez si elles vous sont encore utiles."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Laethanta ó tógadh an grianghraf: %lld. Tá treoracha ann a d’fhéadfadh a bheith sealadach. Féach an bhfuil siad de dhíth ort fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dana od snimanja: %lld. Upute na fotografiji možda su bile potrebne samo privremeno. Provjerite trebate li ih još."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel óta eltelt napok: %lld. Lehet, hogy az útmutató csak átmenetileg volt hasznos. Nézd meg, szükséged van-e még rá."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagar frá myndatöku: %lld. Hún inniheldur leiðbeiningar sem kunna að hafa verið tímabundnar. Athugaðu hvort þú þurfir þær enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni dallo scatto: %lld. Le indicazioni potrebbero essere servite solo temporaneamente. Controlla se sono ancora utili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影から%lld日経っています。案内が写っているので、一時的に使った写真かもしれません。まだ必要かどうかご確認ください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienų nuo fotografavimo: %lld. Nuotraukoje yra galimai laikinų nurodymų. Patikrink, ar jų vis dar reikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienas kopš attēla uzņemšanas: %lld. Tajā ir norādījumi, kas, iespējams, bija vajadzīgi tikai uz laiku. Pārbaudi, vai tie vēl vajadzīgi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiem minn meta ttieħed ir-ritratt: %lld. Fih struzzjonijiet li setgħu kienu temporanji. Ara jekk għadx għandek bżonnhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dager siden bildet ble tatt: %lld. Instruksjonene kan ha vært midlertidige. Sjekk om du fortsatt trenger dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen sinds de opname: %lld. De aanwijzingen op de foto waren mogelijk tijdelijk. Controleer of je ze nog nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni od zrobienia zdjęcia: %lld. Zawiera wskazówki, które mogły być potrzebne tylko przez chwilę. Sprawdź, czy są nadal przydatne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias desde a fotografia: %lld. Tem instruções que podem ter sido temporárias. Confirma se ainda precisas delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zile de la fotografiere: %lld. Conține instrucțiuni poate utile doar temporar. Verifică dacă îți mai trebuie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet dní od zhotovenia: %lld. Pokyny na fotke mohli byť len dočasné. Skontrolujte, či ich ešte potrebujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni od nastanka: %lld. Navodila na fotografiji so morda veljala le začasno. Preverite, ali jih še potrebujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagar sedan fotot togs: %lld. Anvisningarna kan ha varit tillfälliga. Kontrollera om du fortfarande behöver dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปนี้ถ่ายไว้เมื่อ %lld วันก่อน มีข้อมูลที่อาจใช้เพียงชั่วคราว ลองดูว่ายังต้องการอยู่ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp cách đây %lld ngày và có hướng dẫn có thể chỉ cần dùng tạm thời. Hãy xem bạn còn cần không."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片已拍了 %lld 天，裡面有可能只用一時的說明資訊。看看你是否還需要它。"
          }
        }
      }
    },
