        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nemáte žádné poznámky. Napište pár slov k fotce, kterou si chcete zapamatovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen noter endnu. Skriv en linje om et foto, du vil huske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Notizen. Schreib etwas zu einem Foto, an das du dich erinnern möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη σημειώσεις. Γράψε μια φράση για μια φωτογραφία που θέλεις να θυμάσαι."
          }
        },
        "es": {
          "stringUnit": {
