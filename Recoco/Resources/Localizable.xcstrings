    "사진 %lld장을 읽지 못했어요. 아래 버튼을 누르면 다시 확인해요. 사진을 따로 고를 필요는 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장을 읽지 못했어요. 아래 버튼을 누르면 다시 확인해요. 사진을 따로 고를 필요는 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos we couldn’t read: %lld. Tap below to try again without selecting them again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Незаредени снимки: %lld. Натисни по-долу, за да опиташ отново, без да ги избираш повторно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřečtené fotky: %lld. Klepnutím níže to zkuste znovu bez nového výběru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, der ikke kunne læses: %lld. Tryk nedenfor for at prøve igen uden at vælge dem på ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht lesbare Fotos: %lld. Tippe unten, um es erneut zu versuchen. Du musst die Fotos nicht neu auswählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίες που δεν διαβάστηκαν: %lld. Πάτησε παρακάτω για νέα προσπάθεια χωρίς να τις επιλέξεις ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que no se han podido leer: %lld. Toca abajo para reintentar sin volver a seleccionarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loetamatuid fotosid: %lld. Uuesti proovimiseks vajuta allolevat nuppu. Fotosid ei pea uuesti valima."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvia, joita ei voitu lukea: %lld. Yritä uudelleen napauttamalla alla. Kuvia ei tarvitse valita uudestaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos illisibles : %lld. Touchez le bouton ci-dessous pour réessayer sans les sélectionner à nouveau."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Grianghraif nárbh fhéidir a léamh: %lld. Tapáil thíos chun triail eile a bhaint as gan iad a roghnú arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neučitane fotografije: %lld. Dodirnite ispod za novi pokušaj bez ponovnog odabira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem olvasható fotók: %lld. Koppints az alábbi gombra az újrapróbáláshoz. Nem kell újra kijelölnöd őket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndir sem tókst ekki að lesa: %lld. Ýttu hér að neðan til að reyna aftur án þess að velja þær aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto illeggibili: %lld. Tocca il pulsante qui sotto per riprovare senza selezionarle di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚の写真を読み込めませんでした。下のボタンで再確認できます。写真を選び直す必要はありません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko perskaityti nuotraukų: %lld. Bakstelėk žemiau ir bandyk dar kartą. Nuotraukų iš naujo rinktis nereikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenolasīto attēlu skaits: %lld. Spied zemāk, lai mēģinātu vēlreiz. Attēli nav jāatlasa atkārtoti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti li ma stajniex naqraw: %lld. Agħfas hawn taħt biex terġa’ tipprova mingħajr ma tagħżilhom mill-ġdid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder som ikke kunne leses: %lld. Trykk nedenfor for å prøve igjen uten å velge dem på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onleesbare foto’s: %lld. Tik hieronder om het opnieuw te proberen. Je hoeft ze niet opnieuw te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać zdjęć: %lld. Dotknij poniżej, by spróbować ponownie bez zmiany wyboru."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias ilegíveis: %lld. Toca no botão abaixo para tentar de novo sem as voltares a selecionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poze care nu au putut fi citite: %lld. Atinge butonul de mai jos pentru a reîncerca fără să le selectezi din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprečítané fotky: %lld. Ťuknutím nižšie to skúste znova bez nového výberu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprebrane fotografije: %lld. Spodaj poskusite znova, ne da bi jih ponovno izbirali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Foton som inte kunde läsas: %lld. Tryck nedan för att försöka igen utan att välja om dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรูปไม่ได้ %lld รูป แตะด้านล่างเพื่อลองอีกครั้งโดยไม่ต้องเลือกใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được %lld ảnh. Chạm bên dưới để thử lại, không cần chọn lại ảnh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
