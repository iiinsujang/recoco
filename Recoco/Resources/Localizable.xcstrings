    "다음 사진도 함께 살펴볼까요? 구독하면 새로운 후보와 이유를 계속 확인할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 사진도 함께 살펴볼까요? 구독하면 새로운 후보와 이유를 계속 확인할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for another look? A subscription lets you see more suggestions and why they were picked."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Искаш да видиш още? Абонаментът предлага още снимки и обяснение защо са избрани."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete projít další fotky? S předplatným uvidíte další návrhy i důvody výběru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du se flere? Med et abonnement får du flere forslag og forklaringen bag dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ein paar Fotos ansehen? Mit einem Abo siehst du weitere Vorschläge und die Gründe dafür."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις να δεις κι άλλες; Με συνδρομή βλέπεις περισσότερες προτάσεις και τους λόγους επιλογής τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te apetece seguir? Con una suscripción puedes ver más sugerencias y por qué se han elegido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovid veel vaadata? Tellimusega näed rohkem soovitusi ja nende põhjuseid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluaisitko katsoa lisää? Tilauksella näet lisää ehdotuksia ja syyt valintoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie de continuer ? Un abonnement permet de voir d’autres suggestions et les raisons de leur sélection."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar mhaith leat tuilleadh a fheiceáil? Le síntiús, feicfidh tú tuilleadh moltaí agus cúis gach ceann acu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite pogledati još fotografija? Pretplata nudi dodatne prijedloge i objašnjenja odabira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytatnád? Előfizetéssel további javaslatokat és indoklásokat láthatsz."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Viltu sjá meira? Áskrift sýnir fleiri tillögur og hvers vegna þær voru valdar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi continuare? Un abbonamento ti permette di vedere altri suggerimenti e il motivo della scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の写真も見てみますか？ サブスクリプションで、新しい候補と選んだ理由を確認できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nori peržiūrėti daugiau? Užsisakęs gali matyti daugiau pasiūlymų ir sužinoti, kodėl jie atrinkti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēlies apskatīt vairāk? Abonements piedāvā papildu ieteikumus un to pamatojumu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tixtieq tara aktar? B’abbonament tista’ tara aktar suġġerimenti u għaliex intgħażlu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du se mer? Med et abonnement får du flere forslag og ser hvorfor de ble valgt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je meer bekijken? Met een abonnement krijg je meer suggesties en zie je waarom ze zijn gekozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz ochotę przejrzeć kolejne zdjęcia? Subskrypcja daje dostęp do dalszych propozycji i ich uzasadnień."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres rever mais? Uma assinatura dá acesso a mais sugestões e aos motivos da escolha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrei să continui? Un abonament îți permite să vezi alte sugestii și motivele alegerii lor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete prezrieť ďalšie fotky? S predplatným uvidíte ďalšie návrhy aj dôvody výberu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bi si ogledali še kakšno fotografijo? Naročnina omogoča dodatne predloge z razlogi za izbor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du se mer? Med en prenumeration får du fler förslag och ser varför de valts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากดูต่อไหม เมื่อสมัครสมาชิกจะดูคำแนะนำเพิ่มเติมพร้อมเหตุผลที่เลือกได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn xem thêm? Gói đăng ký cho phép xem thêm ảnh gợi ý và lý do chọn chúng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還想看看其他照片嗎？訂閱後可繼續查看新建議和挑選的原因。"
          }
        }
      }
    },
