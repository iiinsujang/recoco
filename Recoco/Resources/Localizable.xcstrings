    },
    "사진 %lld장의 원본에 접근이 필요해요. 허용한 사진은 다시 열 때도 iCloud를 사용할 수 있어요. 데이터가 사용될 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장의 원본에 접근이 필요해요. 허용한 사진은 다시 열 때도 iCloud를 사용할 수 있어요. 데이터가 사용될 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Originals needed: %lld. iCloud may load them again when you reopen them, which may use mobile data."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходими оригинали: %lld. При повторно отваряне iCloud може да ги зареди отново с мобилни данни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebné originály: %lld. Při dalším otevření se mohou znovu stáhnout z iCloudu a využít mobilní data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaler, der skal hentes: %lld. iCloud kan hente dem igen næste gang. Det kan bruge mobildata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigte Originale: %lld. iCloud kann sie beim erneuten Öffnen laden und dabei mobile Daten verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρωτότυπα που χρειάζονται: %lld. Το iCloud μπορεί να τα φορτώσει ξανά όταν τα ανοίξεις, χρησιμοποιώντας δεδομένα κινητής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Originales necesarios: %lld. iCloud puede volver a cargarlos al abrirlos, y es posible que use datos móviles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajalikke originaale: %lld. iCloud võib need avamisel uuesti laadida ja kasutada mobiilset andmesidet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvittavia alkuperäiskuvia: %lld. iCloud saattaa ladata ne uudelleen, kun avaat ne. Tämä voi käyttää mobiilidataa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaux nécessaires : %lld. iCloud peut les recharger à la réouverture, ce qui peut utiliser des données mobiles."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunchóipeanna de dhíth: %lld. Seans go luchtóidh iCloud arís iad nuair a osclóidh tú iad. D’fhéadfadh sonraí móibíleacha a bheith in úsáid."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebni izvornici: %lld. Ponovno otvaranje može ih opet učitati s iClouda i upotrijebiti mobilne podatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szükséges eredetik: %lld. Újbóli megnyitáskor az iCloud ismét betöltheti őket, és ehhez mobiladatot használhat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frumrit sem þarf að sækja: %lld. iCloud gæti sótt þau aftur þegar þú opnar þau og notað farsímagögn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Originali necessari: %lld. iCloud potrebbe ricaricarli alla riapertura e utilizzare dati mobili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚の写真の原本が必要です。許可済みの写真でも、再度開くとiCloudから読み込み、モバイルデータ通信を使用する場合があります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reikia originalų: %lld. Atvėrus iš naujo, „iCloud“ gali atsisiųsti juos dar kartą ir naudoti mobiliuosius duomenis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajadzīgo oriģinālu skaits: %lld. Atverot tos vēlreiz, iCloud var ielādēt tos no jauna un izmantot mobilos datus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriġinali meħtieġa: %lld. iCloud jista’ jerġa’ jtellagħhom meta tiftaħhom, possibilment permezz ta’ data mobbli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaler som trengs: %lld. iCloud kan laste dem ned igjen neste gang du åpner dem. Dette kan bruke mobildata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Benodigde originelen: %lld. Bij opnieuw openen kan iCloud ze opnieuw laden. Dat kan mobiele data verbruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne oryginały: %lld. Ponowne otwarcie może wymagać pobrania ich z iCloud i użycia danych komórkowych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Originais necessários: %lld. O iCloud pode voltar a carregá-los ao reabrir as fotografias e usar dados móveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale necesare: %lld. La redeschidere, iCloud le poate încărca din nou, folosind date mobile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebné originály: %lld. Pri ďalšom otvorení sa môžu znova stiahnuť z iCloudu a použiť mobilné dáta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebni izvirniki: %lld. Ob ponovnem odpiranju se lahko spet prenesejo iz iClouda, kar lahko porabi mobilne podatke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Original som behövs: %lld. iCloud kan hämta dem igen nästa gång du öppnar dem. Det kan använda mobildata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้ต้นฉบับ %lld รูป เมื่อเปิดอีกครั้ง iCloud อาจต้องโหลดใหม่และใช้ข้อมูลมือถือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần bản gốc của %lld ảnh. iCloud có thể phải tải lại khi bạn mở ảnh và có thể dùng dữ liệu di động."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要取用 %lld 張原始照片。再次開啟已授權的照片時，仍可能需要透過 iCloud 載入並使用行動數據。"
          }
        }
      }
    },
