            "value": "正在檢查照片 · %lld / %lld 張"
          }
        }
      }
    },
    "사진 상태나 접근 범위가 바뀌었을 수 있어요. 선택을 유지한 채 다시 확인할게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 상태나 접근 범위가 바뀌었을 수 있어요. 선택을 유지한 채 다시 확인할게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos or their access may have changed. We’ll check again and keep your selection."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимките или достъпът може да са се променили. Ще проверим отново и ще запазим избора ти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky nebo oprávnění se mohly změnit. Zkontrolujeme je znovu a výběr zachováme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos eller adgangen kan være ændret. Vi tjekker igen og bevarer dit valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos oder Zugriffsrechte können sich geändert haben. Wir prüfen erneut und behalten deine Auswahl bei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες ή τα δικαιώματα πρόσβασης ίσως άλλαξαν. Θα τις ελέγξουμε ξανά διατηρώντας την επιλογή σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que hayan cambiado las fotos o los permisos. Volveremos a comprobarlo manteniendo tu selección."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotod või nende õigused võivad olla muutunud. Kontrollime uuesti ja jätame sinu valiku alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat tai niiden käyttöoikeudet ovat saattaneet muuttua. Tarkistamme tilanteen uudelleen ja säilytämme valintasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos ou leur accès ont peut-être changé. Nous allons revérifier en conservant votre sélection."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans go bhfuil na grianghraif nó an rochtain athraithe. Seiceálfaimid arís agus coinneoimid do rogha."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije ili dopuštenja možda su se promijenili. Ponovno ćemo provjeriti bez gubitka odabira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehet, hogy megváltoztak a fotók vagy az engedélyek. A kijelölést megtartva újra ellenőrizzük őket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndirnar eða heimildirnar kunna að hafa breyst. Við athugum aftur og höldum valinu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto o i permessi potrebbero essere cambiati. Ricontrolleremo mantenendo la tua selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の状態やアクセス範囲が変わった可能性があります。選択を保ったまま、もう一度確認します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukos ar prieigos teisės galėjo pasikeisti. Patikrinsime dar kartą ir išsaugosime pasirinkimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iespējams, mainījušies attēli vai piekļuve tiem. Pārbaudīsim vēlreiz, saglabājot tavu atlasi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jista’ jkun li nbidlu r-ritratti jew l-aċċess. Nerġgħu niċċekkjaw u nżommu l-għażla tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene eller tilgangen kan ha endret seg. Vi sjekker igjen og beholder valget ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto’s of je toegangsrechten zijn mogelijk gewijzigd. We controleren dit opnieuw en bewaren je selectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia lub uprawnienia mogły się zmienić. Sprawdzimy je ponownie, zachowując wybór."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias ou as permissões podem ter mudado. Vamos verificar novamente, mantendo a seleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil ca pozele sau permisiunile să se fi schimbat. Le vom verifica din nou, păstrând selecția."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky alebo oprávnenia sa mohli zmeniť. Skontrolujeme ich znova a výber zachováme."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije ali dovoljenja so se morda spremenili. Preverili bomo znova in ohranili izbor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotona eller åtkomsten kan ha ändrats. Vi kontrollerar igen och behåller ditt val."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปหรือสิทธิ์เข้าถึงอาจเปลี่ยนไป เราจะตรวจสอบอีกครั้งและเก็บตัวเลือกของคุณไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh hoặc quyền truy cập có thể đã thay đổi. Recoco sẽ kiểm tra lại và giữ các lựa chọn của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片狀態或取用權限可能已變更。我們會保留選取狀態，並重新檢查。"
          }
        }
      }
    },
    "사진 선택창을 열지 못했어요. 설정에서 사진을 추가할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 선택창을 열지 못했어요. 설정에서 사진을 추가할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo picker couldn’t open. You can add photos in Settings."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изборът на снимки не се отвори. Можете да добавите снимки в „Настройки“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výběr fotek se nepodařilo otevřít. Další fotky můžete přidat v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedvælgeren kunne ikke åbnes. Du kan tilføje billeder i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotoauswahl konnte nicht geöffnet werden. Du kannst in den Einstellungen Fotos hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν άνοιξε η επιλογή φωτογραφιών. Μπορείτε να προσθέσετε φωτογραφίες στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el selector de fotos. Puedes añadir fotos en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotode valikut ei saanud avada. Fotosid saad lisada seadetes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvavalitsinta ei voitu avata. Voit lisätä kuvia Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le sélecteur de photos. Vous pouvez ajouter des photos dans Réglages."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an roghnóir grianghraf a oscailt. Is féidir leat grianghraif a chur leis sna Socruithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabir fotografija nije se mogao otvoriti. Fotografije možete dodati u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült megnyitni a fotóválasztót. A Beállításokban hozzáadhatsz fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að opna myndavalið. Þú getur bætt við myndum í Stillingum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire il selettore di foto. Puoi aggiungere foto in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の選択画面を開けませんでした。「設定」から写真を追加できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko atidaryti nuotraukų pasirinkimo lango. Nuotraukų galite pridėti nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās atvērt fotoattēlu izvēli. Fotoattēlus var pievienot iestatījumos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex niftħu l-għażla tar-ritratti. Tista’ żżid ritratti mill-app Settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildevelgeren kunne ikke åpnes. Du kan legge til bilder i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De fotokiezer kon niet worden geopend. Je kunt foto’s toevoegen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć okna wyboru zdjęć. Możesz dodać zdjęcia w Ustawieniach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o seletor de fotografias. Pode adicionar fotografias nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut deschide selectorul de poze. Poți adăuga poze din Configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výber fotiek sa nepodarilo otvoriť. Ďalšie fotky môžete pridať v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbirnika fotografij ni bilo mogoče odpreti. Fotografije lahko dodaš v nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildväljaren kunde inte öppnas. Du kan lägga till bilder i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าต่างเลือกรูปภาพไม่ได้ คุณเพิ่มรูปภาพได้ในการตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở màn hình chọn ảnh. Bạn có thể thêm ảnh trong Cài đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟照片選取畫面。你可以在「設定」中加入照片。"
          }
        }
      }
    },
