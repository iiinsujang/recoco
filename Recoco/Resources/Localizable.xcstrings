    "이 사진으로 남긴 글이 있다면 글은 유지되지만, 기록의 사진은 보이지 않을 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진으로 남긴 글이 있다면 글은 유지되지만, 기록의 사진은 보이지 않을 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you saved a note about this photo, the text will stay, but the photo may no longer appear."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако си запазил бележка за снимката, текстът ще остане, но снимката може да не се показва повече."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jste k fotce uložili poznámku, text zůstane, ale fotka se už nemusí zobrazit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du gemt en note til dette foto, bevares teksten. Fotoet er måske ikke længere synligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz zu diesem Foto bleibt erhalten. Das Foto wird dort möglicherweise nicht mehr angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν έχεις σημείωση για τη φωτογραφία, το κείμενο θα παραμείνει, αλλά η φωτογραφία ενδέχεται να μην εμφανίζεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has guardado una nota sobre esta foto, el texto se conservará, pero es posible que la foto deje de mostrarse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui salvestasid selle foto kohta märke, jääb tekst alles, kuid foto ei pruugi enam nähtav olla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos olet tallentanut kuvasta muistiinpanon, sen teksti säilyy. Kuva ei välttämättä enää näy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez enregistré une note sur cette photo, le texte sera conservé, mais la photo pourrait ne plus s’afficher."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má shábháil tú nóta faoin ngrianghraf seo, fanfaidh an téacs ach seans nach mbeidh an grianghraf le feiceáil ann."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ste uz fotografiju spremili bilješku, tekst ostaje, no fotografija se možda više neće prikazivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha írtál jegyzetet a fotóhoz, a szöveg megmarad, de a fotó lehet, hogy már nem jelenik meg."
