    "로그인 요청이 많아 잠시 멈췄어요. 조금 뒤 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 요청이 많아 잠시 멈췄어요. 조금 뒤 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Please try again shortly."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Твърде много опити за вход. Опитай пак след малко."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho pokusů o přihlášení. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange loginforsøg. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Versuche es in Kürze erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλές προσπάθειες σύνδεσης. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de acceso. Inténtalo de nuevo en unos instantes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liiga palju sisselogimiskatseid. Proovi mõne aja pärast uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta kirjautumisyritystä. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives de connexion. Réessayez dans un instant."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An iomarca iarrachtaí sínithe isteach. Bain triail eile as ar ball."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja prijave. Pokušajte ponovno malo kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok bejelentkezési kísérlet. Próbáld újra kis idő múlva."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Of margar innskráningartilraunir. Reyndu aftur eftir smástund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi di accesso. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインの試行回数が多すぎます。しばらくしてから、もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per daug bandymų prisijungti. Bandyk po kurio laiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārāk daudz pierakstīšanās mēģinājumu. Pēc brīža mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saru wisq tentattivi ta’ dħul. Erġa’ pprova dalwaqt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange innloggingsforsøk. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Probeer het over een ogenblik opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób logowania. Spróbuj ponownie za chwilę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas tentativas de início de sessão. Tenta novamente dentro de instantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de autentificare. Încearcă din nou în curând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priveľa pokusov o prihlásenie. Skúste to o chvíľu znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preveč poskusov prijave. Čez nekaj časa poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många inloggningsförsök. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคำขอลงชื่อเข้ามากเกินไป โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quá nhiều yêu cầu đăng nhập. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入嘗試次數過多，請稍候再試。"
          }
        }
      }
    },
    "로그인 정보를 확인하지 못했어요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 정보를 확인하지 못했어요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify your sign-in details. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните за вход не бяха потвърдени. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlašovací údaje se nepodařilo ověřit. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine loginoplysninger kunne ikke bekræftes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldedaten konnten nicht überprüft werden. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση των στοιχείων σύνδεσης. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido verificar los datos de acceso. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisselogimisandmeid ei saanud kinnitada. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumistietoja ei voitu vahvistaa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les identifiants. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir do shonraí sínithe isteach a dheimhniú. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće potvrditi podatke za prijavu. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a bejelentkezési adatokat. Próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að staðfesta innskráningarupplýsingarnar. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare i dati di accesso. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン情報を確認できませんでした。もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko patvirtinti prisijungimo duomenų. Bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstīšanās datus neizdevās pārbaudīt. Mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex nivverifikaw id-dettalji tad-dħul. Erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innloggingsopplysningene dine kunne ikke bekreftes. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je inloggegevens konden niet worden geverifieerd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić danych logowania. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar os dados de início de sessão. Tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele de autentificare nu au putut fi verificate. Încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlasovacie údaje sa nepodarilo overiť. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavnih podatkov ni bilo mogoče preveriti. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inloggningsuppgifter kunde inte verifieras. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังยืนยันข้อมูลการลงชื่อเข้าไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác minh được thông tin đăng nhập. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證登入資訊，請再試一次。"
          }
        }
      }
    },
