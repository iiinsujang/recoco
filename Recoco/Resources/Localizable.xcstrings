    "내가 고른 사진만 마지막 확인 뒤에 비워요.\n마음이 안 서면 오늘은 모두 남겨도 괜찮아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 고른 사진만 마지막 확인 뒤에 비워요.\n마음이 안 서면 오늘은 모두 남겨도 괜찮아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only photos you select and confirm are deleted.\nNot sure today? You can keep them all."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтриват се само избраните и потвърдени от теб снимки.\nАко се колебаеш, днес можеш да запазиш всички."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažou se jen fotky, které vyberete a potvrdíte. Klidně si dnes nechte všechny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun billeder, du vælger og bekræfter, bliver slettet. Du må også gerne beholde dem alle i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöscht wird nur, was du auswählst und bestätigst.\nDu kannst auch alle Fotos behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφονται μόνο όσες επιλέξεις και επιβεβαιώσεις.\nΑν δεν είσαι σίγουρος, μπορείς να τις κρατήσεις όλες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borran las fotos que elijas y confirmes.\nTambién puedes conservarlas todas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse vaid sinu valitud ja kinnitatud fotod.\nKui sa pole kindel, võid täna kõik alles jätta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain valitsemasi kuvat poistetaan vahvistuksesi jälkeen. Voit myös säilyttää tänään kaikki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les photos choisies sont supprimées, après confirmation.\nVous pouvez aussi toutes les garder."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní scriostar ach na grianghraif a roghnaíonn agus a dheimhníonn tú.\nMura bhfuil tú cinnte, coinnigh iad go léir inniu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se samo fotografije koje odaberete i potvrdite. Danas ih možete i sve zadržati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kijelölt és jóváhagyott fotókat töröljük.\nHa bizonytalan vagy, mindet megtarthatod."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins myndum sem þú velur og staðfestir er eytt.\nEf þú ert óviss máttu geyma þær allar í dag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono eliminate solo le foto che scegli e confermi.\nPuoi anche tenerle tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んで確認した写真だけを削除します。\n迷った日は、全部残しても大丈夫です。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinamos tik tos nuotraukos, kurias pasirenki ir patvirtini.\nJei abejoji, šiandien gali pasilikti visas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek dzēsti tikai attēli, kurus izvēlies un apstiprini.\nJa šaubies, šodien vari paturēt visus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitħassru biss ir-ritratti li tagħżel u tikkonferma.\nJekk m’intix ċert, illum tista’ żżommhom kollha."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare bildene du velger og bekrefter, blir slettet. Du kan også beholde alle i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen foto’s die je selecteert en bevestigt, worden verwijderd. Je kunt ze vandaag ook allemaal bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte zostaną tylko zdjęcia, które wybierzesz i potwierdzisz. Możesz też zostawić dziś wszystkie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são apagadas as fotografias que escolheres e confirmares.\nSe tiveres dúvidas, podes guardá-las todas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se șterg doar pozele pe care le selectezi și le confirmi.\nDacă nu te-ai hotărât, le poți păstra pe toate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažú sa len fotky, ktoré vyberiete a potvrdíte. Pokojne si dnes nechajte všetky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišejo se le fotografije, ki jih izberete in potrdite. Danes lahko tudi vse obdržite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara bilder som du väljer och bekräftar raderas. Du kan också behålla allihop i dag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเฉพาะรูปที่คุณเลือกและยืนยันเท่านั้น\nถ้ายังไม่แน่ใจ วันนี้เก็บไว้ทั้งหมดก็ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những ảnh bạn chọn và xác nhận mới bị xóa.\nNếu còn phân vân, hôm nay cứ giữ lại tất cả."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你選取並確認的照片才會刪除。\n還沒決定，也可以全部留下。"
          }
        }
      }
    },
