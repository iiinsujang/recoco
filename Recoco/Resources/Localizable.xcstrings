        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suvestinėje saugoma su „Recoco“ ištrintų nuotraukų istorija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārskatā tiek saglabāta ar Recoco dzēsto attēlu vēsture."
