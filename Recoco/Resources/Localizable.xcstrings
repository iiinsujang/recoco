    "비운 사진 수와 비움 캘린더를 확인합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비운 사진 수와 비움 캘린더를 확인합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your deletion totals and calendar."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Виж броя на изтритите снимки и календара."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí počty smazaných fotek a kalendář."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se antal slettede fotos og kalenderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzahl gelöschter Fotos und Kalender ansehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες το σύνολο των διαγραμμένων φωτογραφιών και το ημερολόγιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el total de fotos borradas y el calendario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaata kustutatud fotode arvu ja kalendrit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso poistettujen kuvien määrä ja kalenteri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir le nombre de photos supprimées et le calendrier."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Féach ar na hiomláin scriosta agus ar an bhféilire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje broj izbrisanih fotografija i kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törölt fotók számának és a naptárnak a megtekintése."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoðaðu fjölda eyddra mynda og dagatalið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi il totale delle foto eliminate e il calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した写真の数と整理カレンダーを確認します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peržiūrėk ištrintų nuotraukų skaičių ir kalendorių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skati dzēsto attēlu skaitu un kalendāru."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
