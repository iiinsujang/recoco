    "비우기 완료 여부를 확인하지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비우기 완료 여부를 확인하지 못했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t confirm the deletion."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да потвърдим изтриването."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se ověřit smazání fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kunne ikke bekræftes, at billederne blev slettet."
          }
        },
        "de": {
