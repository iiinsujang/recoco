    "시작하면 아래 약관에 동의하게 됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하면 아래 약관에 동의하게 됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By starting, you agree to the following."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Със започването приемаш следните условия."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračováním souhlasíte s následujícími dokumenty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du går i gang, accepterer du følgende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du beginnst, stimmst du Folgendem zu:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινώντας, αποδέχεσαι τα παρακάτω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al empezar, aceptas lo siguiente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alustades nõustud alltooduga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloittamalla hyväksyt seuraavat ehdot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En commençant, vous acceptez les documents suivants."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Trí thosú, aontaíonn tú leis na téarmaí seo a leanas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavkom prihvaćate sljedeće dokumente."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdéssel elfogadod az alábbiakat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Með því að byrja samþykkirðu eftirfarandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniziando, accetti i documenti seguenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始すると、以下の内容に同意したことになります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pradėdamas sutinki su toliau nurodytomis sąlygomis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sākot lietot, tu piekrīti tālāk minētajiem noteikumiem."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta tibda, tkun qed taqbel ma’ dawn il-kundizzjonijiet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å begynne godtar du følgende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door te beginnen ga je akkoord met het volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczynając, akceptujesz poniższe dokumenty."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao começar, aceitas o seguinte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuând, accepți următoarele documente."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračovaním súhlasíte s týmito dokumentmi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z nadaljevanjem soglašate z naslednjimi dokumenti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du börjar godkänner du följande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเริ่มใช้ คุณยอมรับข้อกำหนดต่อไปนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bắt đầu, bạn đồng ý với các điều khoản dưới đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始使用即表示你同意以下條款。"
          }
        }
      }
    },
    "쌓인 사진,\n정리할 것부터 골라드려요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌓인 사진,\n정리할 것부터 골라드려요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos piling up?\nWe’ll find where to start."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимките се трупат?\nЩе ти помогнем да започнеш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho fotek?\nZačněme několika z nich."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange billeder?\nLad os finde et sted at starte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viele Fotos.\nWo anfangen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες πληθαίνουν.\nΑπό πού να αρχίσεις;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acumulan las fotos.\n¿Por dónde empezar?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotod muudkui kogunevad?\nAitame sul alustada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikaa kuvia?\nAloitetaan muutamasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos s’accumulent.\nPar où commencer ?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Grianghraif ag carnadh?\nCabhróimid leat tosú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše fotografija?\nPočnimo s nekoliko njih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyre több a fotó.\nHol kezdj hozzá?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Safnast myndirnar upp?\nVið hjálpum þér að byrja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto si accumulano.\nDa dove iniziare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が増えて、\nどこから整理しよう？"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukos kaupiasi?\nPadėsime rasti, nuo ko pradėti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoattēli krājas?\nPalīdzēsim saprast, ar ko sākt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qed jinġemgħu r-ritratti?\nNgħinuk issib minn fejn tibda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange bilder?\nLa oss begynne med noen få."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel foto’s?\nHier kun je beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo zdjęć?\nZacznijmy od kilku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias acumulam-se.\nPor onde começar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adună pozele.\nDe unde începi?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priveľa fotiek?\nZačnime niekoľkými."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preveč fotografij?\nZačnimo z nekaj posnetki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många bilder?\nVi hittar en början."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปเต็มเครื่องจนไม่รู้จะเริ่มตรงไหน\nให้รีโคโคช่วยเลือกให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh ngày càng nhiều?\nĐể Recoco gợi ý chỗ bắt đầu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片愈來愈多，\n不知從哪裡整理？"
          }
        }
      }
    },
    "쌓인 사진, 세 장부터 가볍게.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌓인 사진, 세 장부터 가볍게."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So many photos? Start with three."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Много снимки? Започни с три."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte spoustu fotek? Začněte třemi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mange fotos? Begynd med tre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Fotos? Fang mit drei an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολλές φωτογραφίες; Ξεκίνα με τρεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Muchas fotos? Empieza con tres."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Palju fotosid? Alusta kolmest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paljon kuvia? Aloita kolmesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de photos ? Commencez par trois."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Grianghraif ag carnadh? Tosaigh le trí cinn."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puno fotografija? Počnite s tri."
