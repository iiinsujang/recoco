            "state": "translated",
            "value": "Impossible de vérifier le stockage local. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an stóras áitiúil a sheiceáil. Bain triail eile as."
