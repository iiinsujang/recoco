    "사진첩의 원본 사진은 그대로 남아요. 삭제한 기록은 되돌릴 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진첩의 원본 사진은 그대로 남아요. 삭제한 기록은 되돌릴 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original photo stays in your library. A deleted note can’t be recovered."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригиналната снимка остава в библиотеката. Изтритата бележка не може да бъде възстановена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Původní fotka zůstane v knihovně. Smazanou poznámku nelze obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalfotoet bliver i dit bibliotek. En slettet note kan ikke gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Originalfoto bleibt in deiner Mediathek. Gelöschte Notizen können nicht wiederhergestellt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αρχική φωτογραφία παραμένει στη βιβλιοθήκη. Μια διαγραμμένη σημείωση δεν ανακτάται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto original seguirá en tu fototeca. Las notas eliminadas no se pueden recuperar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Algfoto jääb fotokogusse. Kustutatud märget ei saa taastada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäinen kuva säilyy kirjastossasi. Poistettua muistiinpanoa ei voi palauttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo originale reste dans votre photothèque. Une note supprimée ne peut pas être récupérée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanfaidh an bunghrianghraf sa leabharlann. Ní féidir nóta scriosta a aisghabháil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvorna fotografija ostaje u medijateci. Izbrisanu bilješku nije moguće vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti fotó a könyvtárban marad. A törölt jegyzet nem állítható vissza."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frummyndin verður áfram í safninu. Ekki er hægt að endurheimta eyddan minnispunkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto originale resta nella libreria. Una nota eliminata non può essere recuperata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真はライブラリに残ります。削除したメモは元に戻せません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Originali nuotrauka lieka galerijoje. Ištrinto užrašo atkurti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriģinālais attēls paliek bibliotēkā. Dzēstu piezīmi nevar atgūt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-ritratt oriġinali jibqa’ fil-librerija. Nota mħassra ma tistax tiġi rkuprata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalbildet blir i biblioteket. Et slettet notat kan ikke gjenopprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De originele foto blijft in je bibliotheek. Een verwijderde notitie kun je niet terughalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalne zdjęcie pozostanie w bibliotece. Usuniętej notatki nie można odzyskać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia original fica na fototeca. Uma nota eliminada não pode ser recuperada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poza originală rămâne în bibliotecă. O notiță ștearsă nu poate fi recuperată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôvodná fotka zostane v knižnici. Vymazanú poznámku nemožno obnoviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvirna fotografija ostane v knjižnici. Izbrisane beležke ni mogoče obnoviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalfotot finns kvar i biblioteket. En raderad anteckning kan inte återskapas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปต้นฉบับยังอยู่ในคลัง บันทึกที่ลบแล้วจะกู้คืนไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh gốc vẫn ở trong thư viện. Ghi chú đã xóa không thể khôi phục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始照片會留在圖庫中，刪除的筆記則無法復原。"
          }
        }
      }
    },
    "삭제 완료를 확인하지 못해 비운 수에 반영하지 않았어요. 사진 상태와 접근 권한을 확인한 뒤 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 완료를 확인하지 못해 비운 수에 반영하지 않았어요. 사진 상태와 접근 권한을 확인한 뒤 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion wasn’t confirmed, so your total hasn’t changed. Check the photos and your access, then try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтриването не е потвърдено и общият брой не е променен. Провери снимките и достъпа, след което опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazání se nepotvrdilo, počet se nezměnil. Zkontrolujte fotky a přístup a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletningen blev ikke bekræftet, så antallet er uændret. Tjek dine fotos og adgangen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen konnte nicht bestätigt werden. Die Anzahl wurde nicht geändert. Prüfe Fotos und Zugriffsrechte und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή δεν επιβεβαιώθηκε, οπότε το σύνολο δεν άλλαξε. Έλεγξε τις φωτογραφίες και την πρόσβαση και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha confirmado el borrado. El total no ha cambiado. Comprueba las fotos y los permisos antes de reintentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutamist ei kinnitatud ja koguarv ei muutunud. Kontrolli fotosid ja juurdepääsu, seejärel proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistamista ei vahvistettu, joten kokonaismäärä ei muuttunut. Tarkista kuvat ja käyttöoikeus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression n’a pas été confirmée. Le total est inchangé. Vérifiez les photos et les autorisations avant de réessayer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor deimhníodh an scriosadh agus níor athraíodh an t-iomlán. Seiceáil na grianghraif agus an rochtain, ansin bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje nije potvrđeno i broj je nepromijenjen. Provjerite fotografije i pristup pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törlést nem sikerült megerősíteni, ezért a számláló nem változott. Ellenőrizd a fotókat és a hozzáférést, majd próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyðingin var ekki staðfest og heildarfjöldinn breyttist ekki. Athugaðu myndirnar og aðganginn og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione non è stata confermata e il totale non è cambiato. Controlla le foto e i permessi prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を確認できなかったため、件数に含めていません。写真の状態とアクセス範囲を確認して、もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrynimas nepatvirtintas, todėl bendras skaičius nepakito. Patikrink nuotraukas bei prieigą ir bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēšana netika apstiprināta, tāpēc kopskaits nav mainījies. Pārbaudi attēlus un piekļuvi un mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tħassir ma ġiex ikkonfermat u t-total ma nbidilx. Iċċekkja r-ritratti u l-aċċess, imbagħad erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettingen ble ikke bekreftet, så antallet er uendret. Sjekk bildene og tilgangen, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen is niet bevestigd. Je totaal is ongewijzigd. Controleer de foto’s en je toegang en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie nie zostało potwierdzone. Licznik się nie zmienił. Sprawdź zdjęcia i dostęp, a potem spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o apagamento, pelo que o total não mudou. Verifica as fotografias e o acesso e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea nu a fost confirmată, deci totalul nu s-a schimbat. Verifică pozele și accesul înainte de a reîncerca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazanie sa nepotvrdilo, počet sa nezmenil. Skontrolujte fotky a prístup a skúste znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje ni bilo potrjeno in število je nespremenjeno. Preverite fotografije in dostop ter poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderingen bekräftades inte. Antalet är oförändrat. Kontrollera fotona och åtkomsten och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังยืนยันการลบไม่ได้ ยอดรวมจึงยังเท่าเดิม ตรวจสอบรูปและสิทธิ์เข้าถึง แล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác nhận được việc xóa nên số liệu chưa thay đổi. Hãy kiểm tra ảnh và quyền truy cập rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認刪除是否完成，因此未計入總數。請確認照片狀態與取用權限後再試一次。"
          }
        }
      }
    },
    "삭제 후 30일 안에 복구할 수 있어요. 그곳에서 영구 삭제한 사진은 복구할 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 후 30일 안에 복구할 수 있어요. 그곳에서 영구 삭제한 사진은 복구할 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have 30 days to recover it. Photos permanently deleted from Recently Deleted can’t be recovered."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имаш 30 дни за възстановяване. Снимките, изтрити окончателно от „Наскоро изтрити“, не могат да се възстановят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obnovení fotek máte 30 dní. Fotky trvale odstraněné z alba Nedávno smazané už nelze obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gendanne fotos inden for 30 dage. Fotos, der er slettet permanent fra Slettet for nylig, kan ikke gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innerhalb von 30 Tagen ist eine Wiederherstellung möglich. Aus „Zuletzt gelöscht“ endgültig gelöschte Fotos lassen sich nicht wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να τις ανακτήσεις μέσα σε 30 ημέρες. Όσες διαγραφούν οριστικά από τις «Πρόσφατες διαγραφές» δεν ανακτώνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes recuperarlas durante 30 días. Las fotos borradas definitivamente de «Eliminado» no se pueden recuperar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastamiseks on 30 päeva. Albumist Hiljuti kustutatud jäädavalt kustutatud fotosid ei saa taastada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palauttaa kuvat 30 päivän kuluessa. Äskettäin poistetut -kokoelmasta pysyvästi poistettuja kuvia ei voi palauttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez 30 jours pour les récupérer. Une photo effacée définitivement de « Supprimées récemment » ne peut plus être récupérée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá 30 lá agat lena aisghabháil. Ní féidir grianghraf a aisghabháil tar éis é a scriosadh go buan as Scriosta le déanaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije možete vratiti u roku od 30 dana. Fotografije trajno izbrisane iz albuma Nedavno obrisano nije moguće vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók 30 napig állíthatók vissza. A Nemrég törölt albumból végleg törölt fotók már nem állíthatók vissza."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur 30 daga til að endurheimta myndina. Myndir sem er eytt endanlega úr Nýlega eytt er ekki hægt að endurheimta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai 30 giorni per recuperarle. Le foto eliminate definitivamente da “Eliminati di recente” non si possono recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除後30日以内なら復元できます。「最近削除した項目」から完全に削除した写真は復元できません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkurti galima per 30 dienų. Visam laikui iš albumo „Neseniai ištrinta“ ištrintų nuotraukų atkurti nebegalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atgūšanai ir 30 dienas. Attēlus, kas neatgriezeniski dzēsti no albuma Nesen dzēstie, nevar atgūt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għandek 30 jum biex tirkuprah. Ritratti mħassra għal dejjem minn Imħassra reċentement ma jistgħux jiġu rkuprati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gjenopprette bilder innen 30 dager. Bilder som er slettet permanent fra Nylig slettet, kan ikke gjenopprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt foto’s binnen 30 dagen terugzetten. Foto’s die je definitief uit ‘Recent verwijderd’ wist, kun je niet terughalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia można odzyskać w ciągu 30 dni. Zdjęć trwale usuniętych z albumu „Ostatnio usunięte” nie można odzyskać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes recuperar as fotografias durante 30 dias. Depois de apagadas definitivamente de «Apagado recentemente», já não podem ser recuperadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai 30 de zile pentru a recupera pozele. Cele șterse definitiv din „Șterse recent” nu mai pot fi recuperate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky sa dajú obnoviť do 30 dní. Fotky natrvalo vymazané z albumu Nedávno vymazané už nemožno obnoviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije lahko obnovite v 30 dneh. Fotografij, trajno izbrisanih iz razdelka Nedavno izbrisano, ni mogoče obnoviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan återskapa foton inom 30 dagar. Foton som raderats permanent från Senast raderade kan inte återskapas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนได้ภายใน 30 วัน หากลบถาวรจากอัลบั้มที่ลบล่าสุด จะกู้คืนไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có 30 ngày để khôi phục. Ảnh đã xóa vĩnh viễn khỏi mục Đã xóa gần đây không thể khôi phục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後的 30 天內可以復原。若已從「最近刪除」永久刪除照片，就無法復原。"
          }
        }
      }
    },
    "삭제는 항상 직접 확인 후 진행돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제는 항상 직접 확인 후 진행돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You always confirm before a photo is deleted."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Винаги потвърждаваш, преди снимката да бъде изтрита."
