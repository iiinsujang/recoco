        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas sul on hetk fotode vaatamiseks?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olisiko hetki aikaa katsoa kuviasi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moment pour trier quelques photos ?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An bhfuil nóiméad agat le féachaint ar do ghrianghraif?"
