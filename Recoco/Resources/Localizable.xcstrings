        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutitko mielesi? Näin palautat kuvan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez changé d’avis ? Comment récupérer une photo"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athrú intinne? Conas grianghraf a aisghabháil"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predomislili ste se? Kako vratiti fotografiju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meggondoltad magad? A visszaállítás módja"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiptirðu um skoðun? Svona endurheimtirðu mynd"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai cambiato idea? Come recuperare una foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻したいときは・復元方法"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Persigalvojai? Kaip atkurti nuotrauką"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārdomāji? Kā atgūt attēlu"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bdilt fehmtek? Kif tirkupra ritratt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du ombestemt deg? Slik gjenoppretter du et bilde"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van gedachten veranderd? Zo zet je een foto terug"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana zdania? Jak odzyskać zdjęcie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudaste de ideias? Como recuperar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te-ai răzgândit? Cum recuperezi o poză"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako obnoviť fotku, ak si to rozmyslíte"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste si premislili? Kako obnovite fotografijo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ångrat dig? Så återskapar du ett foto"
          }
        },
        "th": {
