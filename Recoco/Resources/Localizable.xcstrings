        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú vistaðir minnispunkt við þessa mynd verður textinn áfram en myndin birtist kannski ekki lengur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai salvato una nota su questa foto, il testo resterà, ma la foto potrebbe non essere più visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真に残したメモの文章は残りますが、写真は表示されなくなることがあります。"
