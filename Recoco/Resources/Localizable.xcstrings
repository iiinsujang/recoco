            "value": "Toutes les fonctions sont accessibles sans compte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá gach gné ar fáil gan síniú isteach."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve značajke možete koristiti bez prijave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden funkció elérhető bejelentkezés nélkül."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur notað alla eiginleika án innskráningar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi usare tutte le funzioni senza accedere."
