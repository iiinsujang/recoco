    "오랫동안 보지 않은 사진이에요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오랫동안 보지 않은 사진이에요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven’t viewed this photo in a while."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдавна не си разглеждал тази снимка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto fotku jste už dlouho neotevřeli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke set på dette foto længe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dieses Foto länger nicht angesehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχει καιρό να δεις αυτή τη φωτογραφία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace tiempo que no ves esta foto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa pole seda fotot ammu vaadanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole katsonut kuvaa vähään aikaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas regardé cette photo depuis un moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní fhaca tú an grianghraf seo le tamall."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu fotografiju već dugo niste pogledali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a fotót régen nézted meg."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur ekki skoðað þessa mynd lengi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non guardi questa foto da un po’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく見返していない写真です。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jau kurį laiką neperžiūrėjai šios nuotraukos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo attēlu sen neesi skatījis."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilek ma tara dan ir-ritratt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke sett på dette bildet på en stund."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze foto al een tijd niet bekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od dawna nie oglądano tego zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não vês esta fotografia há algum tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai mai văzut această poză de ceva timp."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto fotku ste už dávno neotvorili."
          }
        },
        "sl": {
          "stringUnit": {
