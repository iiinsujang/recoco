    "더 살펴보고 싶다면 다른 사진을 선택할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 살펴보고 싶다면 다른 사진을 선택할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose other photos if you’d like to keep going."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да продължиш, избери други снимки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li pokračovat, vyberte jiné fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg andre fotos, hvis du vil fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du weitermachen möchtest, wähle weitere Fotos aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε άλλες φωτογραφίες αν θέλεις να συνεχίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quieres continuar, elige otras fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätkamiseks vali teised fotod."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse muita kuvia, jos haluat jatkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, vous pouvez sélectionner d’autres photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh grianghraif eile más mian leat leanúint."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nastavak odaberite druge fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha folytatnád, válassz további fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu aðrar myndir til að halda áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuoi continuare, scegli altre foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかにも見たいときは、別の写真を選べます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei nori tęsti, pasirink kitas nuotraukas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai turpinātu, izvēlies citus attēlus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel ritratti oħra jekk tixtieq tkompli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg andre bilder hvis du vil fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies andere foto’s als je wilt doorgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, wybierz inne zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe outras fotografias se quiseres continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege alte poze dacă vrei să continui."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete pokračovať, vyberte ďalšie fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nadaljevanje izberite druge fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj andra foton om du vill fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากอยากดูต่อ ให้เลือกรูปอื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn ảnh khác nếu muốn tiếp tục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還想看看嗎？可以選擇其他照片。"
          }
        }
      }
    },
    "더 살펴보고 싶다면 이어서 찾아볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 살펴보고 싶다면 이어서 찾아볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep looking if you’d like."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш да прегледаш още, ако искаш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud chcete, můžete hledat dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se flere, hvis du har lyst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du möchtest, kannst du weitersuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν θέλεις, μπορείς να συνεχίσεις την αναζήτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quieres, puedes seguir buscando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovi korral vaata veel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit jatkaa etsimistä, jos haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer la recherche si vous le souhaitez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir leat leanúint más maith leat."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako želite, možete nastaviti tražiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szeretnéd, kereshetsz tovább."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur haldið áfram ef þú vilt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuoi, puoi continuare a cercare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し見たいときは、続けて探せます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei nori, gali tęsti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja vēlies, vari turpināt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tista’ tkompli jekk trid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se mer hvis du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt verder kijken wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz szukać dalej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quiseres, podes continuar a procurar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți continua căutarea dacă vrei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete, môžete hľadať ďalej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite, lahko iščete naprej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsätta om du vill."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากดูต่อก็ดูเพิ่มได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem thêm nếu muốn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還想看看嗎？可以繼續尋找建議。"
          }
        }
      }
    },
    "더 살펴보려면 구독 이용 조건을 먼저 확인해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 살펴보려면 구독 이용 조건을 먼저 확인해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the subscription details to keep going."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да продължиш, виж подробностите за абонамента."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li pokračovat, podívejte se na předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abonnementsvilkårene for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um weiterzumachen, lies zunächst die Aboinformationen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες τους όρους συνδρομής πριν συνεχίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, consulta antes las condiciones de la suscripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätkamiseks vaata tellimuse üksikasju."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista tilauksen ehdot ennen jatkamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, consultez d’abord les modalités de l’abonnement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiceáil sonraí an tsíntiúis chun leanúint."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nastavak pogledajte pojedinosti o pretplati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatás előtt olvasd el az előfizetési feltételeket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoðaðu áskriftarupplýsingar til að halda áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare, controlla prima le condizioni dell’abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに見るには、先にサブスクリプションの内容をご確認ください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdamas tęsti, peržiūrėk prenumeratos informaciją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai turpinātu, apskati abonementa informāciju."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara d-dettalji tal-abbonament biex tkompli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abonnementsvilkårene for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de abonnementsvoorwaarden om verder te gaan."
