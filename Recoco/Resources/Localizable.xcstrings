        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de notes. Écrivez un mot sur une photo dont vous voulez vous souvenir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl nótaí ann fós. Scríobh líne faoi ghrianghraf ba mhaith leat a mheabhrú."
