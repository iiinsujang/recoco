    "Apple 로그인 연결이 아직 준비되지 않았어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인 연결이 아직 준비되지 않았어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple isn’t available yet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Входът с Apple все още не е наличен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení přes Apple zatím není dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med Apple er ikke tilgængeligt endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Mit Apple anmelden“ ist derzeit nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Σύνδεση μέσω Apple δεν είναι ακόμη διαθέσιμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Iniciar sesión con Apple» aún no está disponible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’iga sisselogimine ei ole veel saadaval."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu Applella ei ole vielä käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Se connecter avec Apple » n’est pas disponible pour le moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl síniú isteach le Apple ar fáil fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava putem Applea još nije dostupna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple-lel történő bejelentkezés még nem érhető el."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Innskráning með Apple er ekki tiltæk enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Accedi con Apple” non è ancora disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Appleでサインイン」はまだ利用できません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijungti per „Apple“ kol kas negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstīšanās ar Apple vēl nav pieejama."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Id-dħul b’Apple għadu mhux disponibbli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på med Apple er ikke tilgjengelig ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met Apple is nog niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie z Apple nie jest jeszcze dostępne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão com a Apple ainda não está disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea cu Apple nu este încă disponibilă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie cez Apple zatiaľ nie je dostupné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava z računom Apple še ni na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med Apple är inte tillgängligt än."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่พร้อมให้ลงชื่อเข้าด้วย Apple"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Apple hiện chưa sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚無法使用 Apple 登入。"
          }
        }
      }
    },
