    "사진 접근 권한을 확인한 뒤 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근 권한을 확인한 뒤 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check photo access, then try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери достъпа до снимките и опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte přístup k fotkám a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek adgangen til fotos, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Fotozugriff und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε την πρόσβαση στις φωτογραφίες και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el acceso a las fotos y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli fotoluba ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista kuvien käyttöoikeus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’accès aux photos, puis réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiceáil rochtain ar ghrianghraif agus bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite pristup fotografijama i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a fotóhozzáférést, és próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu aðgang að myndum og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’accesso alle foto e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスを確認して、もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikrink prieigą prie nuotraukų ir bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudi piekļuvi attēliem un mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
