    "하나를 골라주세요. 같은 고민에도 다시 투표할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나를 골라주세요. 같은 고민에도 다시 투표할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one. You can vote for the same topic again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери една тема. Можеш да гласуваш повторно за същата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jedno téma. Můžete pro ně hlasovat znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg ét emne. Du kan stemme på samme emne igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Thema. Du kannst auch mehrmals für dasselbe Thema stimmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε ένα θέμα. Μπορείς να ψηφίσεις ξανά το ίδιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tema. Puedes volver a votar por el mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali üks teema. Sama teema poolt võib uuesti hääletada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yksi aihe. Voit äänestää samaa aihetta uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un thème. Vous pouvez voter plusieurs fois pour le même."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh ceann amháin. Is féidir vótáil don ábhar céanna arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite jednu temu. Za istu temu možete glasati ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy témát. Ugyanarra többször is szavazhatsz."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu eitt. Þú mátt kjósa sama efnið aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un argomento. Puoi votare più volte per lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ選んでください。同じ項目にもう一度投票することもできます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirink vieną temą. Už tą pačią temą gali balsuoti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlies vienu tēmu. Par to pašu tēmu var balsot atkārtoti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel wieħed. Tista’ terġa’ tivvota għall-istess suġġett."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg ett tema. Du kan stemme på det samme igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een onderwerp. Je kunt opnieuw op hetzelfde onderwerp stemmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jeden temat. Możesz zagłosować na niego ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um tema. Podes voltar a votar no mesmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un subiect. Poți vota din nou pentru același subiect."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jednu tému. Môžete za ňu hlasovať znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite eno temo. Za isto temo lahko glasujete znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett ämne. Du kan rösta på samma ämne igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกหนึ่งข้อ กลับมาโหวตเรื่องเดิมได้อีก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mục. Bạn có thể bình chọn lại cho cùng một chủ đề."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一項。你也可以再次投給同一個項目。"
          }
        }
      }
    },
