    "비슷한 여행 사진과 오래된 캡처가 쌓여도,\n앨범을 처음부터 훑을 필요는 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비슷한 여행 사진과 오래된 캡처가 쌓여도,\n앨범을 처음부터 훑을 필요는 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar trip photos and old screenshots add up.\nYou don’t have to scan your whole library."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подобните кадри от пътувания и старите екранни снимки се натрупват.\nНе е нужно да преглеждаш целия албум."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobné fotky z výletů a staré snímky obrazovky se hromadí. Nemusíte procházet celou knihovnu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Feriebilleder, der ligner hinanden, og gamle skærmbilleder hober sig op. Du behøver ikke se hele biblioteket igennem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Urlaubsfotos, alte Screenshots …\nDu musst nicht die ganze Mediathek durchsehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρόμοιες ταξιδιωτικές φωτογραφίες, παλιά στιγμιότυπα…\nΔεν χρειάζεται να δεις όλη τη βιβλιοθήκη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos de viaje parecidas, capturas antiguas…\nNo hace falta repasar toda la fototeca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarnased reisifotod ja vanad kuvatõmmised kuhjuvad.\nSa ei pea kogu fotokogu läbi vaatama."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samankaltaisia matkakuvia ja vanhoja näyttökuvia kertyy helposti. Koko kirjastoa ei tarvitse käydä läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos de voyage similaires, vieilles captures…\nInutile de parcourir toute la photothèque."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnann grianghraif chosúla ó thurais agus sean-seatanna scáileáin.\nNí gá duit an leabharlann ar fad a chuardach."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slične fotografije s putovanja i stare snimke zaslona se gomilaju. Ne morate pregledati cijelu zbirku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasonló nyaralási fotók, régi képernyőképek…\nNem kell végignézned az egész könyvtárat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Svipaðar ferðamyndir og gamlar skjámyndir safnast upp.\nÞú þarft ekki að fara yfir allt myndasafnið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto di viaggio simili, vecchi screenshot…\nNon serve scorrere tutta la libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似た旅行写真や古いスクリーンショット。\n写真を一から見返さなくても大丈夫です。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Panašūs kelionių kadrai ir senos ekrano kopijos kaupiasi.\nNereikia peržiūrėti visos galerijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Līdzīgi ceļojumu fotoattēli un veci ekrānuzņēmumi krājas.\nNav jāpārskata viss albums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti simili mill-vaganzi u screenshots qodma jinġemgħu.\nM’għandekx għalfejn tfittex fil-librerija kollha."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Like feriebilder og gamle skjermbilder hoper seg opp. Du trenger ikke gå gjennom hele biblioteket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkbare vakantiefoto’s en oude schermafbeeldingen stapelen zich op. Je hoeft niet je hele bibliotheek door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobne zdjęcia z podróży i stare zrzuty ekranu łatwo się gromadzą. Nie musisz przeglądać całej biblioteki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias de viagem parecidas, capturas de ecrã antigas…\nNão precisas de percorrer toda a fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poze asemănătoare din vacanță, capturi de ecran vechi…\nNu trebuie să parcurgi toată biblioteca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobné fotky z výletov a staré snímky obrazovky sa hromadia. Nemusíte prechádzať celú knižnicu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobne fotografije s potovanj in stari posnetki zaslona se nabirajo. Ni treba pregledati celotne knjižnice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liknande semesterbilder och gamla skärmavbilder samlas på hög. Du behöver inte gå igenom hela biblioteket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งรูปเที่ยวที่คล้ายกันและภาพหน้าจอเก่า ๆ\nไม่ต้องไล่ดูเองทั้งคลังรูป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh du lịch na ná nhau, ảnh chụp màn hình đã cũ…\nBạn không cần lục lại cả thư viện."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行時連拍的照片、以前留的截圖，\n不用從頭翻遍整個相簿。"
          }
        }
      }
    },
