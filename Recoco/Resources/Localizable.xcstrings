        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est aujourd’hui que vous vouliez revoir cette photo."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Inniu an lá a roghnaigh tú chun an grianghraf seo a sheiceáil arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas je dan koji ste odabrali za ponovni pregled ove fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma van a fotó újbóli átnézésére kijelölt nap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í dag er dagurinn sem þú valdir til að skoða myndina aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è il giorno che hai scelto per rivedere questa foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度確認すると決めた日になりました。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien ta diena, kurią pasirinkai nuotraukai peržiūrėti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodien ir diena, kuru izvēlējies šī attēla atkārtotai apskatei."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Illum il-ġurnata li għażilt biex terġa’ tara dan ir-ritratt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag er dagen du valgte for å se på dette bildet igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de dag die je hebt gekozen om deze foto opnieuw te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś przypada wybrany przez Ciebie dzień ponownego obejrzenia tego zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou o dia que escolheste para rever esta fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A sosit ziua aleasă de tine pentru a revedea poza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes je deň, ktorý ste si vybrali na opätovné prezretie tejto fotky."
