    "사진·비움 내역·기존 기록은 이 기기에 남아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진·비움 내역·기존 기록은 이 기기에 남아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos, cleanup history, and saved notes stay on this device."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимките, историята на разчистването и запазените бележки ще останат на устройството."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, historie úklidu a uložené poznámky zůstanou v tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos, din oprydningshistorik og dine gemte noter bliver på enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos, der Verlauf und gespeicherte Notizen bleiben auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες, το ιστορικό και οι αποθηκευμένες σημειώσεις παραμένουν σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos, el historial y las notas guardadas seguirán en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu fotod, korrastamisajalugu ja salvestatud märkmed jäävad sellesse seadmesse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvasi, siivoushistoriasi ja tallennetut muistiinpanosi säilyvät tällä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos, votre historique et vos notes enregistrées restent sur cet appareil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanfaidh do ghrianghraif, do stair ghlantacháin agus do nótaí sábháilte ar an ngléas seo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, povijest čišćenja i bilješke ostaju na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotóid, a rendrakási előzmények és a mentett jegyzetek az eszközön maradnak."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndir, tiltektarsaga og vistaðir minnispunktar verða áfram á þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto, la cronologia e le note salvate resteranno su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、整理の履歴、保存したメモはこの端末に残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukos, tvarkymo istorija ir išsaugoti užrašai liks šiame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēli, kārtošanas vēsture un saglabātās piezīmes paliks šajā ierīcē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-ritratti, l-istorja tat-tindif u n-noti salvati jibqgħu fuq dan l-apparat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene, oppryddingshistorikken og de lagrede notatene dine blir på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s, opruimgeschiedenis en bewaarde notities blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia, historia porządków i zapisane notatki pozostaną na tym urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias, o histórico de limpeza e as notas guardadas ficam neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele, istoricul curățeniei și notițele salvate rămân pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, história upratovania a uložené poznámky zostanú v tomto zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, zgodovina pospravljanja in beležke ostanejo v tej napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina foton, din rensningshistorik och dina sparade anteckningar finns kvar på enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูป ประวัติการจัดรูป และบันทึกที่เก็บไว้จะยังอยู่บนเครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh, lịch sử dọn ảnh và ghi chú đã lưu vẫn nằm trên thiết bị này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、整理紀錄和已儲存的筆記都會保留在這部裝置上。"
          }
        }
      }
    },
