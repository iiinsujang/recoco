    "계정 정보가 삭제돼요. 이 기기의 사진과 비움 내역은 그대로 남아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 정보가 삭제돼요. 이 기기의 사진과 비움 내역은 그대로 남아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account information will be deleted. Photos and cleanup history will stay on this device."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните на акаунта ще бъдат изтрити. Снимките и историята на разчистването ще останат на устройството."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje účtu budou smazány. Fotky a historie úklidu v tomto zařízení zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine kontooplysninger slettes. Billeder og oprydningshistorik bliver på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Account wird gelöscht. Fotos und Aufräumverlauf bleiben auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία του λογαριασμού θα διαγραφούν. Οι φωτογραφίες και το ιστορικό παραμένουν σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los datos de tu cuenta. Tus fotos y el historial de limpieza seguirán en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto andmed kustutatakse. Fotod ja korrastamisajalugu jäävad sellesse seadmesse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi tiedot poistetaan. Kuvat ja siivoushistoria jäävät tähän laitteeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de votre compte seront supprimées. Vos photos et votre historique de tri resteront sur cet appareil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scriosfar eolas an chuntais. Fanfaidh do ghrianghraif agus do stair ghlantacháin ar an ngléas seo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci vašeg računa bit će izbrisani. Fotografije i povijest čišćenja ostaju na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókadatok törlődnek. A fotóid és a rendrakási előzmények ezen az eszközön maradnak."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Reikningsupplýsingum verður eytt. Myndir og tiltektarsaga verða áfram á þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del tuo account verranno eliminati. Le foto e la cronologia del riordino resteranno su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント情報を削除します。写真と整理の履歴はこの端末に残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paskyros duomenys bus ištrinti. Nuotraukos ir tvarkymo istorija liks šiame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta informācija tiks dzēsta. Attēli un kārtošanas vēsture paliks šajā ierīcē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-informazzjoni tal-kont titħassar. Ir-ritratti u l-istorja tat-tindif jibqgħu fuq dan l-apparat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoopplysningene dine blir slettet. Bildene og ryddehistorikken blir på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je accountgegevens worden verwijderd. Je foto’s en opruimgeschiedenis blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane konta zostaną usunięte. Zdjęcia i historia porządków pozostaną na tym urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados da conta serão eliminados. As fotografias e o histórico de limpeza ficam neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele contului vor fi șterse. Pozele și istoricul rămân pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje účtu sa vymažú. Fotky a história upratovania zostanú v tomto zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki vašega računa bodo izbrisani. Fotografije in zgodovina čiščenja ostanejo v tej napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina kontouppgifter raderas. Bilder och rensningshistorik finns kvar på den här enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลบัญชีจะถูกลบ ส่วนรูปและประวัติการจัดรูปจะยังอยู่บนเครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin tài khoản sẽ bị xóa. Ảnh và lịch sử dọn ảnh vẫn được giữ trên thiết bị này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號資料將會刪除，照片和整理紀錄仍會保留在這部裝置上。"
          }
        }
      }
    },
    "계정 정보는 삭제되며 복구할 수 없어요.\n이 기기의 사진과 이용 내역은 유지돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 정보는 삭제되며 복구할 수 없어요.\n이 기기의 사진과 이용 내역은 유지돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account is permanent.\nYour photos and activity stay on this device."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтритият акаунт не може да бъде възстановен.\nСнимките и историята ти остават на устройството."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazání účtu je nevratné.\nFotky a aktivita zůstanou na tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto slettes permanent.\nDine fotos og din aktivitet bliver på enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gelöschter Account lässt sich nicht wiederherstellen.\nDeine Fotos und Aktivitäten bleiben auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή του λογαριασμού είναι οριστική.\nΟι φωτογραφίες και η δραστηριότητά σου παραμένουν σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás recuperar la cuenta una vez eliminada.\nTus fotos y tu actividad seguirán en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatud kontot ei saa taastada.\nSinu fotod ja tegevuste ajalugu jäävad seadmesse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin poistaminen on pysyvää.\nKuvasi ja toimintasi säilyvät tällä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du compte est définitive.\nVos photos et votre activité restent sur cet appareil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir cuntas scriosta a aisghabháil.\nFanfaidh do ghrianghraif agus do ghníomhaíocht ar an ngléas seo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje računa je trajno.\nFotografije i aktivnosti ostaju na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fióktörlés végleges.\nA fotóid és az előzmények ezen az eszközön maradnak."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er hægt að endurheimta reikning sem hefur verið eytt.\nMyndir og virkni verða áfram á þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione dell’account è definitiva.\nLe foto e le attività resteranno su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除すると元に戻せません。\n写真と利用履歴はこの端末に残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrintos paskyros atkurti nepavyks.\nNuotraukos ir veiklos istorija liks šiame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēstu kontu nevar atgūt.\nAttēli un darbību vēsture paliks ierīcē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kont imħassar ma jistax jiġi rkuprat.\nIr-ritratti u l-attività tiegħek jibqgħu fuq dan l-apparat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen din slettes permanent.\nBildene og aktiviteten din blir på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account wordt definitief verwijderd.\nJe foto’s en activiteit blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie konta jest trwałe.\nZdjęcia i aktywność pozostaną na tym urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A eliminação da conta é definitiva.\nAs fotografias e a atividade ficam neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea contului este definitivă.\nPozele și activitatea rămân pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazanie účtu je trvalé.\nFotky a aktivita zostávajú v tomto zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbris računa je trajen.\nFotografije in dejavnost ostanejo v tej napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto raderas permanent.\nDina foton och din aktivitet finns kvar på enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อลบบัญชีแล้วจะกู้คืนไม่ได้\nรูปและประวัติการใช้งานยังอยู่บนเครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản đã xóa không thể khôi phục.\nẢnh và lịch sử sử dụng vẫn nằm trên thiết bị này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除帳號後無法復原。\n照片和使用紀錄會保留在這部裝置上。"
          }
        }
      }
    },
    "계정 정보를 확인하지 못했어요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 정보를 확인하지 못했어요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify your account information. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да потвърдим данните на акаунта. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje o účtu se nepodařilo ověřit. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontooplysningerne kunne ikke bekræftes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Accountdaten konnten nicht bestätigt werden. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση των στοιχείων του λογαριασμού. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido verificar los datos de tu cuenta. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto andmeid ei saanud kinnitada. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi tietoja ei voitu vahvistaa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les informations du compte. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir eolas do chuntais a dheimhniú. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće potvrditi podatke o računu. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a fiók adatait. Próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að staðfesta reikningsupplýsingar. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare i dati dell’account. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント情報を確認できませんでした。もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko patvirtinti paskyros duomenų. Bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta informāciju neizdevās pārbaudīt. Mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex nivverifikaw l-informazzjoni tal-kont. Erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoopplysningene kunne ikke bekreftes. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je accountgegevens konden niet worden geverifieerd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić danych konta. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar os dados da conta. Tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele contului nu au putut fi verificate. Încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje o účte sa nepodarilo overiť. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatkov o računu ni bilo mogoče preveriti. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontouppgifterna kunde inte verifieras. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังยืนยันข้อมูลบัญชีไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác minh được thông tin tài khoản. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證帳號資料，請再試一次。"
          }
        }
      }
    },
    "계정 확인 화면을 열지 못했어요. 잠시 후 다시 시도해주세요.": {
