        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna analyseras på den här enheten. Originalen skickas inte till någon server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบรูปบนเครื่องนี้ โดยไม่ส่งรูปต้นฉบับไปยังเซิร์ฟเวอร์ของเรา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được kiểm tra ngay trên thiết bị. Ảnh gốc không được gửi đến máy chủ của Recoco."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會在裝置上分析，原始照片不會上傳到伺服器。"
          }
        }
      }
    },
    "기기의 사용 제한이나 관리 설정을 확인해주세요. 비움 내역은 리포트에서 볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 사용 제한이나 관리 설정을 확인해주세요. 비움 내역은 리포트에서 볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your device restrictions or management settings. You can still view your report."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери ограниченията или настройките за управление на устройството. Все още можеш да отвориш отчета."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte omezení nebo správu zařízení. Přehled zůstává dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek enhedens begrænsninger eller administrationsindstillinger. Du kan stadig se rapporten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Einschränkungen oder Verwaltungsprofile deines Geräts. Dein Bericht bleibt verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε τους περιορισμούς ή τις ρυθμίσεις διαχείρισης της συσκευής. Η αναφορά παραμένει διαθέσιμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba las restricciones o los ajustes de gestión del dispositivo. Puedes seguir viendo el informe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli seadme piiranguid või haldusseadeid. Ülevaadet saad ikka vaadata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista laitteen rajoitukset tai hallinta-asetukset. Voit silti avata raportin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les restrictions ou les réglages de gestion de l’appareil. Votre bilan reste disponible."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiceáil srianta nó socruithe bainistíochta an ghléis. Is féidir an tuairisc a fheiceáil fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite ograničenja ili postavke upravljanja uređajem. Pregled je i dalje dostupan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd az eszköz korlátozásait és felügyeleti beállításait. A jelentés továbbra is elérhető."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu takmarkanir eða tækjastjórnun. Þú getur enn skoðað yfirlitið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le restrizioni o le impostazioni di gestione del dispositivo. Il resoconto resta disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の制限や管理設定を確認してください。整理の履歴はレポートで見られます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikrink įrenginio apribojimus ar valdymo nuostatas. Suvestinę vis tiek gali peržiūrėti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudi ierīces ierobežojumus vai pārvaldības iestatījumus. Pārskats joprojām ir pieejams."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iċċekkja r-restrizzjonijiet jew is-settings tal-ġestjoni tal-apparat. Xorta tista’ tara r-rapport."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk begrensningene eller administrasjonsinnstillingene på enheten. Rapporten er fortsatt tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de beperkingen of beheerinstellingen van je apparaat. Je kunt je overzicht nog bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź ograniczenia lub profil zarządzania urządzeniem. Raport nadal jest dostępny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica as restrições ou a gestão do dispositivo. Continuas a poder ver o relatório."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică restricțiile sau configurările de gestionare ale dispozitivului. Raportul rămâne disponibil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte obmedzenia alebo správu zariadenia. Prehľad zostáva dostupný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite omejitve ali nastavitve upravljanja naprave. Pregled je še vedno na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera enhetens begränsningar eller hanteringsinställningar. Du kan fortfarande se rapporten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อจำกัดหรือการตั้งค่าการจัดการอุปกรณ์ คุณยังดูรายงานได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra cài đặt giới hạn hoặc quản lý thiết bị. Bạn vẫn xem được báo cáo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查裝置的使用限制或管理設定。你仍可在報告查看整理紀錄。"
          }
        }
      }
    },
    "기기의 사용 제한이나 관리 설정을 확인해주세요. 선택 상태와 기록은 유지돼요.": {
