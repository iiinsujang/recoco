    "비울 후보만 삭제하고, 남길 사진은 그대로 두어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비울 후보만 삭제하고, 남길 사진은 그대로 두어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the suggested photo will be deleted. The other photo will stay."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще бъде изтрита само предложената снимка. Другата ще остане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže se jen navržená fotka. Druhá zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun det foreslåede foto slettes. Det andet bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das vorgeschlagene Foto wird gelöscht. Das andere bleibt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα διαγραφεί μόνο η προτεινόμενη φωτογραφία. Η άλλη θα διατηρηθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borrará la foto propuesta. La otra se conservará."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse ainult soovitatud foto. Teine foto jääb alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ehdotettu kuva poistetaan. Toinen kuva säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la photo proposée sera supprimée. L’autre sera conservée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní scriosfar ach an grianghraf molta. Fanfaidh an ceann eile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše se samo predložena fotografija. Druga ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a javasolt fotó törlődik. A másik megmarad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins myndinni sem lögð er til verður eytt. Hin verður áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eliminata solo la foto proposta. L’altra sarà conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するのは候補の写真だけです。残す写真はそのままです。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus ištrinta tik pasiūlyta nuotrauka. Kita liks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks dzēsts tikai ieteiktais attēls. Otrs paliks."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitħassar biss ir-ritratt suġġerit. L-ieħor jibqa’."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare det foreslåtte bildet slettes. Det andre beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de voorgestelde foto wordt verwijderd. De andere blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuniemy tylko wskazane zdjęcie. Drugie pozostanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a fotografia sugerida será apagada. A outra mantém-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar poza propusă va fi ștearsă. Cealaltă va fi păstrată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže sa len navrhnutá fotka. Druhá zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisana bo le predlagana fotografija. Druga ostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast det föreslagna fotot raderas. Det andra finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเฉพาะรูปที่แนะนำให้ลบ ส่วนอีกรูปจะยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ảnh được gợi ý xóa mới bị xóa. Ảnh còn lại vẫn được giữ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有列為刪除對象的照片會被刪除，另一張會保留。"
          }
        }
      }
    },
    "비움 내역은 리포트에 남아 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비움 내역은 리포트에 남아 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your deletion history is in the report."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Историята на изтриването е в отчета."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historii smazaných fotek najdete v přehledu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du finder din slettehistorik i rapporten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Verlauf findest du im Bericht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό σου βρίσκεται στην αναφορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de limpieza está en el informe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutamise ajalugu on ülevaates."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistohistoriasi näkyy raportissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique de tri se trouve dans le bilan."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá do stair scriosta sa tuairisc."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povijest brisanja nalazi se u izvješću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előzményeket a jelentésben találod."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyðingarsagan er í yfirlitinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovi la cronologia del riordino nel resoconto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理の履歴はレポートに残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrynimų istoriją rasi suvestinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēšanas vēsture ir pārskatā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-istorja tat-tħassir tinsab fir-rapport."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettehistorikken din ligger i rapporten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verwijdergeschiedenis staat in je overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historię usuniętych zdjęć znajdziesz w raporcie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico está no relatório."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul este în raport."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Históriu vymazaných fotiek nájdete v prehľade."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgodovino brisanja najdete v poročilu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din raderingshistorik finns i rapporten."
          }
        },
        "th": {
