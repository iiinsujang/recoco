    "설정에서 접근을 허용하면 다시 확인해요. 선택 상태와 기록은 유지돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 접근을 허용하면 다시 확인해요. 선택 상태와 기록은 유지돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access in Settings to check again. Your selection and notes are saved."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши достъпа в Настройки, за да проверим отново. Изборът и бележките ти са запазени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup v Nastavení. Výběr a poznámky zůstávají uložené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang i Indstillinger for at tjekke igen. Dit valg og dine noter bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff in den Einstellungen, um erneut zu prüfen. Auswahl und Notizen bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την πρόσβαση στις Ρυθμίσεις για επανέλεγχο. Η επιλογή και οι σημειώσεις διατηρούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso en Ajustes para volver a comprobarlo. Tu selección y tus notas se conservarán."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuesti kontrollimiseks luba seadetes juurdepääs. Sinu valik ja märkmed on alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli pääsy asetuksissa tarkistusta varten. Valintasi ja muistiinpanosi säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès dans Réglages pour revérifier. Votre sélection et vos notes sont conservées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh rochtain sna Socruithe chun seiceáil arís. Tá do rogha agus do nótaí sábháilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite pristup u Postavkama. Odabir i bilješke su sačuvani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újbóli ellenőrzéshez engedélyezd a hozzáférést a Beállításokban. A kijelölés és a jegyzetek megmaradnak."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu aðgang í Stillingum til að athuga aftur. Valið og minnispunktarnir eru vistuð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso in Impostazioni per ricontrollare. La selezione e le note vengono conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でアクセスを許可すると再確認できます。選択やメモは残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk prieigą nuostatose, kad galėtume patikrinti dar kartą. Tavo pasirinkimas ir užrašai išsaugoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai pārbaudītu vēlreiz, atļauj piekļuvi iestatījumos. Tava atlase un piezīmes ir saglabātas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ħalli l-aċċess fis-Settings biex nerġgħu niċċekkjaw. L-għażla u n-noti tiegħek huma salvati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang i Innstillinger for å sjekke igjen. Valget og notatene dine blir beholdt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang in Instellingen om opnieuw te controleren. Je selectie en notities blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp w Ustawieniach. Wybór i notatki są zachowane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso nas Definições para verificar novamente. Mantemos a seleção e as notas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul în Configurări pentru a reîncerca. Selecția și notițele rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte prístup v Nastaveniach. Výber a poznámky zostávajú uložené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite dostop v nastavitvah. Izbor in beležke so ohranjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst i Inställningar för att kontrollera igen. Ditt val och dina anteckningar finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงรูปในการตั้งค่าเพื่อตรวจสอบอีกครั้ง ตัวเลือกและบันทึกยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập trong Cài đặt để kiểm tra lại. Các lựa chọn và ghi chú của bạn vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中允許取用後，就能重新檢查。選取狀態和筆記都會保留。"
          }
        }
      }
    },
