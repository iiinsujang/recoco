    "이전 초안을 읽지 못해 저장을 멈췄어요. 작성한 글을 선택해 따로 복사해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 초안을 읽지 못해 저장을 멈췄어요. 작성한 글을 선택해 따로 복사해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read your earlier draft. Saving has stopped. Select and copy your text to keep it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предишната чернова не беше прочетена и записването спря. Маркирай и копирай текста, за да го запазиш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncept se nepodařilo přečíst. Ukládání se zastavilo. Označte a zkopírujte text, abyste o něj nepřišli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tidligere kladde kunne ikke læses. Lagringen er stoppet. Markér og kopiér teksten for at beholde den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der frühere Entwurf ist nicht lesbar. Das Speichern wurde angehalten. Markiere und kopiere deinen Text, um ihn zu behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το προηγούμενο πρόχειρο δεν διαβάστηκε. Η αποθήκευση σταμάτησε. Επίλεξε και αντέγραψε το κείμενο για να το κρατήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el borrador anterior. El guardado se ha detenido. Selecciona y copia tu texto para conservarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Varasemat mustandit ei saanud lugeda. Salvestamine peatati. Teksti alleshoidmiseks vali ja kopeeri see."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemman luonnoksen lukeminen ei onnistunut, joten tallennus pysäytettiin. Valitse ja kopioi teksti talteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien brouillon est illisible. L’enregistrement a été interrompu. Sélectionnez et copiez votre texte pour le conserver."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an sean-dréacht a léamh. Stopadh an sábháil. Roghnaigh agus cóipeáil do théacs chun é a choinneáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicu nije moguće pročitati. Spremanje je zaustavljeno. Označite i kopirajte tekst da biste ga sačuvali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korábbi piszkozat nem olvasható. A mentés leállt. A szöveg megőrzéséhez jelöld ki és másold ki."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að lesa fyrri drög. Vistun hefur stöðvast. Veldu og afritaðu textann til að geyma hann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la bozza precedente. Il salvataggio è stato interrotto. Seleziona e copia il testo per conservarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の下書きを読み込めず、保存を中断しました。文章を選んでコピーしておいてください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko perskaityti ankstesnio juodraščio, todėl įrašymas sustabdytas. Pažymėk ir nukopijuok tekstą, kad jį išsaugotum."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepriekšējo melnrakstu neizdevās nolasīt. Saglabāšana apturēta. Iezīmē un nokopē tekstu, lai to paturētu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex naqraw l-abbozz ta’ qabel u waqafna milli nsalvaw. Agħżel u kkopja t-test biex iżżommu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det forrige utkastet kunne ikke leses. Lagringen er stoppet. Marker og kopier teksten for å beholde den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerdere concept kon niet worden gelezen. Opslaan is gestopt. Selecteer en kopieer je tekst om die te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać szkicu. Zapis wstrzymano. Zaznacz i skopiuj tekst, by go zachować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o rascunho anterior. A gravação foi interrompida. Seleciona e copia o texto para o manter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciorna anterioară nu a putut fi citită. Salvarea s-a oprit. Selectează și copiază textul ca să îl păstrezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncept sa nepodarilo prečítať. Ukladanie sa zastavilo. Označte a skopírujte text, aby ste ho nestratili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osnutka ni bilo mogoče prebrati. Shranjevanje je ustavljeno. Označite in kopirajte besedilo, da ga ohranite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt tidigare utkast kunde inte läsas. Sparandet avbröts. Markera och kopiera texten för att behålla den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านฉบับร่างก่อนหน้าไม่ได้ จึงหยุดบันทึกไว้ก่อน โปรดเลือกและคัดลอกข้อความเพื่อเก็บไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được bản nháp trước nên đã dừng lưu. Hãy chọn và sao chép nội dung để giữ lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取先前的草稿，已暫停儲存。請選取並拷貝文字以保留內容。"
          }
        }
      }
    },
    "이전 초안을 읽지 못했어요. 원본은 그대로 보관하고 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 초안을 읽지 못했어요. 원본은 그대로 보관하고 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open your previous draft. The original has been kept."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предишната чернова не се отвори. Оригиналът е запазен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí koncept se nepodařilo otevřít. Původní verze zůstala zachovaná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tidligere kladde kunne ikke åbnes. Originalen er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Entwurf konnte nicht geöffnet werden. Das Original bleibt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν άνοιξε το προηγούμενο πρόχειρο. Το αρχικό κείμενο διατηρήθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el borrador anterior. El original se ha conservado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Varasemat mustandit ei saanud avada. Algne versioon on alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemman luonnoksen avaaminen ei onnistunut. Alkuperäinen on tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le brouillon précédent. L’original a été conservé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor osclaíodh an sean-dréacht. Tá an leagan bunaidh coinnithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prethodnu skicu nije moguće otvoriti. Izvornik je sačuvan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előző piszkozat nem nyitható meg. Az eredeti megmaradt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að opna fyrri drög. Frumritið er enn til."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la bozza precedente. L’originale è stato conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の下書きを開けませんでした。元の文章は保存されています。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko atverti ankstesnio juodraščio. Originalas išsaugotas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepriekšējo melnrakstu neizdevās atvērt. Oriģināls ir saglabāts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex niftħu l-abbozz ta’ qabel. L-oriġinal għadu hemm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det forrige utkastet kunne ikke åpnes. Originalen er beholdt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerdere concept kon niet worden geopend. Het origineel is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć poprzedniego szkicu. Oryginał jest zachowany."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o rascunho anterior. O original foi guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciorna anterioară nu a putut fi deschisă. Originalul a fost păstrat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predošlý koncept sa nepodarilo otvoriť. Pôvodná verzia zostala zachovaná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejšnjega osnutka ni bilo mogoče odpreti. Izvirnik je ohranjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt tidigare utkast kunde inte öppnas. Originalet finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดฉบับร่างก่อนหน้าไม่ได้ ต้นฉบับยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được bản nháp trước. Bản gốc vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟先前的草稿，原文仍然保留著。"
          }
        }
      }
    },
    "인터넷 연결을 확인한 뒤 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 연결을 확인한 뒤 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your internet connection and try again."
          }
        },
        "bg": {
