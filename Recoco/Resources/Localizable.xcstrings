            "state": "translated",
            "value": "Turi minutę peržiūrėti nuotraukas?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai tev ir brīdis, lai apskatītu savus attēlus?"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għandek minuta biex tagħti daqqa t’għajn lir-ritratti tiegħek?"
