    "반영 여부를 확인 중인 표가 있어요. 같은 표로 다시 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반영 여부를 확인 중인 표가 있어요. 같은 표로 다시 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vote is waiting for confirmation. Check that vote again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Един глас изчаква потвърждение. Провери отново същия глас."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden hlas čeká na potvrzení. Zkontrolujte znovu stejný hlas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stemme afventer bekræftelse. Tjek den samme stemme igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stimme wartet auf Bestätigung. Prüfe diese Stimme erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ψήφος περιμένει επιβεβαίωση. Έλεγξε ξανά την ίδια ψήφο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un voto pendiente de confirmación. Vuelve a comprobar ese voto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks hääl ootab kinnitust. Kontrolli sama häält uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi ääni odottaa vahvistusta. Tarkista sama ääni uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vote attend sa confirmation. Vérifiez à nouveau ce vote."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá vóta ag fanacht le deimhniú. Seiceáil an vóta céanna arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan glas čeka potvrdu. Ponovno provjerite taj glas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy szavazat megerősítésre vár. Ellenőrizd újra ugyanazt a szavazatot."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitt atkvæði bíður staðfestingar. Athugaðu sama atkvæði aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voto è in attesa di conferma. Verifica di nuovo lo stesso voto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ちの投票があります。その投票をもう一度確認してください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienas balsas laukia patvirtinimo. Dar kartą patikrink tą patį balsą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viena balss gaida apstiprinājumu. Pārbaudi to pašu balsi vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemm vot li qed jistenna konferma. Erġa’ ċċekkja dak l-istess vot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En stemme venter på bekreftelse. Sjekk samme stemme på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stem wacht op bevestiging. Controleer die stem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos czeka na potwierdzenie. Sprawdź ponownie ten sam głos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um voto a aguardar confirmação. Verifica novamente esse mesmo voto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vot așteaptă confirmarea. Verifică din nou același vot."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden hlas čaká na potvrdenie. Skontrolujte znova ten istý hlas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "En glas čaka na potrditev. Ponovno preverite isti glas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En röst väntar på bekräftelse. Kontrollera samma röst igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคะแนนที่รอยืนยันอยู่ โปรดตรวจสอบคะแนนเดิมอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lượt bình chọn đang chờ xác nhận. Hãy kiểm tra lại lượt đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一票正在等待確認，請再次查詢同一票。"
          }
        }
      }
    },
