    "로그아웃을 완료하지 못했어요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃을 완료하지 못했어요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t sign you out. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Излизането не успя. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášení se nezdařilo. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kunne ikke logges ud. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden fehlgeschlagen. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποσύνδεση. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cerrar la sesión. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljalogimine ebaõnnestus. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloskirjautuminen ei onnistunut. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vous déconnecter. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir tú a shíniú amach. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava nije uspjela. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült kijelentkezni. Próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að skrá þig út. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile uscire dall’account. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトできませんでした。もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko atsijungti. Bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās izrakstīties. Mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex noħorġuk mill-kont. Erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke logge deg ut. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitloggen is niet gelukt. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wylogować. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível terminar a sessão. Tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut face deconectarea. Încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásenie sa nepodarilo. Skúste znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava ni uspela. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att logga ut. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังลงชื่อออกไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đăng xuất được. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法登出，請再試一次。"
          }
        }
      }
    },
