          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lettere måde\nat rydde op i dine fotos på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stück für Stück\nFotos aufräumen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τακτοποίησε τις φωτογραφίες σου\nπιο εύκολα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena tus fotos\npoco a poco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta fotode korrastamist\nväikese sammuga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevyempi tapa\njärjestää kuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Triez vos photos\nen toute simplicité."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tús éasca\nle glanadh do ghrianghraf."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostavniji način\nda uredite fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendszerezd könnyedén\na fotóidat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Byrjaðu smátt\ná myndasafninu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina le tue foto\nun po’ alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しずつ、\n写真を整理しよう。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pradėk tvarkyti nuotraukas\nnuo mažo žingsnio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sāc kārtot attēlus\npa vienam solim."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibda ordna r-ritratti\nftit ftit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En enklere måte\nå rydde i bildene dine på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lichtere manier\nom je foto’s op te ruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostszy sposób\nna porządek w zdjęciach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma forma simples\nde organizar fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mod mai ușor\nde a-ți sorta pozele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednoduchší spôsob,\nako si upratať fotky."
          }
        },
        "sl": {
