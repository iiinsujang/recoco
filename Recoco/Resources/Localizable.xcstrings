    "내 사진에서\n살펴볼 이유를 찾아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사진에서\n살펴볼 이유를 찾아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reason to take\nanother look."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повод да погледнеш\nоще веднъж."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Důvod podívat se\nještě jednou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En grund til at se\npå dine fotos igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos verdienen\neinen zweiten Blick."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αφορμή να ξαναδείς\nτις φωτογραφίες σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una razón para\nvolver a ver tus fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Põhjus veel\nkord vaadata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syy katsoa kuviasi\nuudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre regard\nsur vos photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cúis le féachaint\narís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razlog za još\njedan pogled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézz rá újra\na fotóidra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ástæða til að\nlíta aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro sguardo\nalle tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を見直す\nきっかけを探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Priežastis pažvelgti\ndar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemesls paskatīties\nvēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raġuni biex\nterġa’ tagħti daqqa t’għajn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En grunn til å se\npå bildene dine igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een reden om je foto’s\nnog eens te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warto spojrzeć\njeszcze raz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um motivo para rever\nas tuas fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motiv să-ți revezi\npozele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dôvod pozrieť sa\nešte raz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razlog za še\nen pogled."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En anledning att titta\npå dina foton igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชวนกลับมาดูรูป\nอีกสักครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đôi khi cũng nên\nxem lại ảnh cũ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你的照片裡，\n找出值得再看一眼的畫面。"
          }
        }
      }
    },
    "내 사진을 살펴보려면 접근이 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사진을 살펴보려면 접근이 필요해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to review your photos."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши достъпа, за да прегледаш снимките си."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup, abyste mohli procházet fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang for at gennemgå dine fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Fotozugriff, um deine Fotos durchzusehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την πρόσβαση για να δεις τις φωτογραφίες σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso para revisar tus fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba fotode vaatamiseks juurdepääs."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kuvien käyttö, jotta voit tarkastella niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à vos photos pour les trier."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh rochtain chun do ghrianghraif a fheiceáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite pristup da biste pregledali fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotóid átnézéséhez engedélyezd a hozzáférést."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu aðgang til að skoða myndirnar þínar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso per rivedere le tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を見直すには、アクセスを許可してください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk pasiekti nuotraukas, kad galėtum jas peržiūrėti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj piekļuvi, lai pārskatītu attēlus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ħalli aċċess biex tara r-ritratti tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang for å se gjennom bildene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang om je foto’s te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp, by przejrzeć zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso para reveres as tuas fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul pentru a-ți revedea pozele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte prístup, aby ste mohli prejsť fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite dostop za pregled fotografij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst för att gå igenom dina foton."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงรูปเพื่อเริ่มดูรูป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập để xem lại ảnh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許取用照片，讓我們幫你整理。"
          }
        }
      }
    },
