            "state": "translated",
            "value": "削除の前には、必ずご自身で確認できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš ištrinant nuotrauką visada prašoma patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms attēla dzēšanas vienmēr jāsniedz apstiprinājums."
