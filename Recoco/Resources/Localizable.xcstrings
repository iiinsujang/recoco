        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēli tiek pārbaudīti tavā ierīcē. Oriģināli netiek sūtīti uz mūsu serveriem."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-ritratti jiġu ċċekkjati fuq l-apparat tiegħek. L-oriġinali ma jintbagħtux fuq is-servers tagħna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene analyseres på denne enheten. Originalene sendes ikke til en server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De analyse gebeurt op dit apparaat. Originele foto’s worden niet naar een server gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza odbywa się na tym urządzeniu. Oryginały nie są wysyłane na serwer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
