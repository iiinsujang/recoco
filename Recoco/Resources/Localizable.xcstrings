            "value": "No se ha podido abrir la verificación de identidad. Inténtalo de nuevo en unos instantes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto kinnitamise vaadet ei saanud avada. Proovi veidi hiljem."
          }
        },
        "fi": {
          "stringUnit": {
