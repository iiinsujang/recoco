    "기기 저장 상태를 확인하지 못했어요. 기존 데이터는 그대로예요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 저장 상태를 확인하지 못했어요. 기존 데이터는 그대로예요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify local storage. Your data is safe. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да проверим локалното хранилище. Данните ти са запазени. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní úložiště se nepodařilo ověřit. Vaše data jsou v bezpečí. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lokale lager kunne ikke bekræftes. Dine data er bevaret. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Speicher konnte nicht geprüft werden. Deine Daten sind erhalten. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο έλεγχος του τοπικού χώρου αποθήκευσης. Τα δεδομένα σου παραμένουν ασφαλή. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar el almacenamiento local. Tus datos siguen guardados. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadme salvestusruumi ei saanud kontrollida. Andmed on alles. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallista tallennustilaa ei voitu vahvistaa. Tietosi ovat tallessa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier le stockage local. Vos données sont conservées. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an stóras áitiúil a dheimhniú. Tá do shonraí slán. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće provjeriti lokalnu pohranu. Vaši su podaci sačuvani. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a helyi tárhelyet. Az adataid megvannak. Próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að staðfesta geymslu tækisins. Gögnin þín eru óhult. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l’archivio locale. I dati sono conservati. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の保存状態を確認できませんでした。データは残っています。もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko patikrinti vietinės saugyklos. Tavo duomenys liko. Bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās pārbaudīt ierīces krātuvi. Tavi dati ir saglabāti. Mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex nivverifikaw il-ħażna lokali. Id-data tiegħek għadha hemm. Erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal lagring kunne ikke bekreftes. Dataene dine er beholdt. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale opslag kon niet worden geverifieerd. Je gegevens blijven behouden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić pamięci urządzenia. Twoje dane są bezpieczne. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o armazenamento local. Os dados mantêm-se. Tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocarea locală nu a putut fi verificată. Datele sunt în siguranță. Încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestne úložisko sa nepodarilo overiť. Vaše údaje sú v bezpečí. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne shrambe ni bilo mogoče preveriti. Vaši podatki so varni. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala lagringen kunde inte verifieras. Dina data finns kvar. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
