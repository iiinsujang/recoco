    "나중에 다시 보여드릴게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 다시 보여드릴게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll show this again later."
          }
