        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法切換為裝置儲存。紀錄仍然保留著，請再試一次。"
          }
        }
      }
    },
    "기기에 있는 현재 이미지 파일의 전체 데이터가 같아요. 아래 비교 사진은 남겨두고, 이 사진만 비울 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 있는 현재 이미지 파일의 전체 데이터가 같아요. 아래 비교 사진은 남겨두고, 이 사진만 비울 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image files on your device are identical. You can delete this photo and keep the copy shown below."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файловете на устройството са напълно еднакви. Можеш да изтриеш тази снимка и да запазиш копието отдолу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory fotek v zařízení jsou shodné. Tuto fotku můžete smazat a kopii níže si ponechat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedfilerne på enheden er identiske. Du kan slette dette foto og beholde kopien nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bilddateien auf deinem Gerät sind identisch. Du kannst dieses Foto löschen und die unten gezeigte Kopie behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία εικόνας στη συσκευή είναι πανομοιότυπα. Μπορείς να διαγράψεις αυτή τη φωτογραφία και να κρατήσεις το αντίγραφο που φαίνεται παρακάτω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de imagen de tu dispositivo son idénticos. Puedes borrar esta foto y conservar la copia que aparece abajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadmes olevad pildifailid on identsed. Võid selle foto kustutada ja jätta alles all näidatud koopia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteella olevat kuvatiedostot ovat identtiset. Voit poistaa tämän kuvan ja säilyttää alla näkyvän kopion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sur votre appareil sont identiques. Vous pouvez supprimer cette photo et garder la copie affichée ci-dessous."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá na comhaid íomhá ar do ghléas díreach mar an gcéanna. Is féidir an grianghraf seo a scriosadh agus an chóip thíos a choinneáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke fotografija na uređaju su jednake. Možete izbrisati ovu fotografiju i zadržati kopiju prikazanu ispod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön tárolt képfájlok tartalma azonos. Ezt a fotót törölheted, a lent látható másolat pedig megmarad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndskrárnar á tækinu eru nákvæmlega eins. Þú getur eytt þessari mynd og geymt afritið sem sést fyrir neðan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file immagine sul dispositivo sono identici. Puoi eliminare questa foto e conservare la copia mostrata sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にある画像ファイルの中身は同じです。下の比較用の写真を残して、この写真だけを削除できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaizdo failai įrenginyje yra identiški. Gali ištrinti šią nuotrauką ir pasilikti toliau rodomą kopiją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēlu faili ierīcē ir identiski. Šo attēlu vari dzēst un paturēt zemāk redzamo kopiju."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-fajls tal-immaġni fuq l-apparat tiegħek huma identiċi. Tista’ tħassar dan ir-ritratt u żżomm il-kopja li tidher hawn taħt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildefilene på enheten er identiske. Du kan slette dette bildet og beholde kopien nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De fotobestanden op je apparaat zijn identiek. Je kunt deze foto verwijderen en de kopie hieronder bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki zdjęć na urządzeniu są identyczne. Możesz usunąć to zdjęcie i zachować kopię pokazaną poniżej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros de imagem no dispositivo são idênticos. Podes apagar esta fotografia e manter a cópia apresentada abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele de imagine de pe dispozitiv sunt identice. Poți șterge această poză și păstra copia afișată mai jos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbory fotiek v zariadení sú zhodné. Túto fotku môžete vymazať a kópiu nižšie si nechať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteki fotografij v napravi sta enaki. To fotografijo lahko izbrišete in obdržite spodaj prikazano kopijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildfilerna på enheten är identiska. Du kan radera det här fotot och behålla kopian nedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์รูปบนเครื่องเหมือนกันทุกอย่าง ลบรูปนี้และเก็บสำเนาด้านล่างไว้ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai tệp ảnh trên thiết bị giống hệt nhau. Bạn có thể xóa ảnh này và giữ lại bản bên dưới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置上的兩個影像檔案內容完全相同。你可以保留下方供比較的照片，只刪除這一張。"
          }
        }
      }
    },
    "기기에서 분석해요. 원본은 서버로 보내지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 분석해요. 원본은 서버로 보내지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are checked on your device. Originals aren’t sent to our servers."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимките се проверяват на устройството ти. Оригиналите не се изпращат до нашите сървъри."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky se analyzují v tomto zařízení. Originály se neposílají na server."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billederne analyseres på denne enhed. Originalerne sendes ikke til en server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse erfolgt auf deinem Gerät. Originale werden nicht an unsere Server gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες ελέγχονται στη συσκευή σου. Τα πρωτότυπα δεν αποστέλλονται στους διακομιστές μας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se analizan en tu dispositivo. Los originales no se envían a nuestros servidores."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotosid kontrollitakse sinu seadmes. Algfotosid meie serveritesse ei saadeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat analysoidaan tällä laitteella. Alkuperäisiä kuvia ei lähetetä palvelimelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse a lieu sur votre appareil. Les originaux ne sont pas envoyés à nos serveurs."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiceáiltear na grianghraif ar do ghléas. Ní sheoltar na bunchóipeanna chuig ár bhfreastalaithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije se analiziraju na ovom uređaju. Izvornici se ne šalju na poslužitelj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotókat az eszközödön elemezzük. Az eredeti képeket nem küldjük a szervereinkre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndir eru skoðaðar á tækinu þínu. Frummyndir eru ekki sendar á netþjóna okkar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono analizzate sul tuo dispositivo. Gli originali non vengono inviati ai nostri server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で分析します。写真の原本はサーバーに送りません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukos tikrinamos tavo įrenginyje. Originalai į mūsų serverius nesiunčiami."
