        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije se brišu tek nakon vaše potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlés előtt mindig te erősíted meg a döntést."
