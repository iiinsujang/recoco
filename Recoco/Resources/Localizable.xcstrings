          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s worden alleen verwijderd nadat je dit hebt bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwanie zdjęć zawsze wymaga Twojego potwierdzenia."
