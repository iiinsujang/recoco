    "공유를 취소했어요. 기록은 저장되어 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유를 취소했어요. 기록은 저장되어 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing canceled. Your note is still saved."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Споделянето е отменено. Бележката е запазена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení zrušeno. Poznámka je stále uložená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling annulleret. Din note er stadig gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen abgebrochen. Deine Notiz ist weiterhin gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κοινοποίηση ακυρώθηκε. Η σημείωση παραμένει αποθηκευμένη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cancelado la acción de compartir. La nota sigue guardada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagamine katkestati. Märge on alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaminen peruttiin. Muistiinpano on tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage annulé. Votre note reste enregistrée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cealaíodh an roinnt. Tá an nóta fós sábháilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje je otkazano. Bilješka je i dalje spremljena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megosztás megszakítva. A jegyzet továbbra is megvan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hætt var við deilingu. Minnispunkturinn er enn vistaður."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivisione annullata. La nota resta salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有をキャンセルしました。メモは保存されています。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendrinimas atšauktas. Užrašas liko išsaugotas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopīgošana atcelta. Piezīme joprojām ir saglabāta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-qsim ġie kkanċellat. In-nota għadha salvata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling avbrutt. Notatet er fortsatt lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen geannuleerd. Je notitie is nog bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano udostępnianie. Notatka jest nadal zapisana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha cancelada. A nota continua guardada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajarea a fost anulată. Notița este în continuare salvată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľanie zrušené. Poznámka je stále uložená."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deljenje je preklicano. Beležka je še vedno shranjena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delningen avbröts. Anteckningen finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการแชร์แล้ว บันทึกยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy chia sẻ. Ghi chú của bạn vẫn được lưu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消分享，筆記仍然保留著。"
          }
        }
      }
    },
