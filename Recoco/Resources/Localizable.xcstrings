    "공유하지 못했어요. 저장한 기록에서 다시 시도할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하지 못했어요. 저장한 기록에서 다시 시도할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t share. Try again from your saved note."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Споделянето не успя. Опитай отново от запазената бележка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení se nezdařilo. Zkuste to znovu z uložené poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke dele. Prøv igen fra din gemte note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen fehlgeschlagen. Versuche es von der gespeicherten Notiz aus erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κοινοποίηση απέτυχε. Δοκίμασε ξανά από την αποθηκευμένη σημείωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido compartir. Inténtalo de nuevo desde la nota guardada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagamine ebaõnnestus. Proovi uuesti salvestatud märkest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaminen ei onnistunut. Voit yrittää uudelleen tallennetusta muistiinpanosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du partage. Réessayez depuis la note enregistrée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir é a roinnt. Bain triail eile as ón nóta sábháilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje nije uspjelo. Pokušajte ponovno iz spremljene bilješke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült megosztani. Próbáld újra a mentett jegyzetből."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að deila. Reyndu aftur úr vistaða minnispunktinum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivisione non riuscita. Riprova dalla nota salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できませんでした。「保存したメモ」からもう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko bendrinti. Bandyk dar kartą iš išsaugoto užrašo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās kopīgot. Mēģini vēlreiz no saglabātās piezīmes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex naqsmu n-nota. Erġa’ pprova min-nota salvata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke dele. Prøv igjen fra det lagrede notatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen is niet gelukt. Probeer het opnieuw vanuit je bewaarde notitie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się udostępnić. Spróbuj ponownie z zapisanej notatki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível partilhar. Tenta novamente a partir da nota guardada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajarea a eșuat. Încearcă din nou din notița salvată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľanie zlyhalo. Skúste to znova z uloženej poznámky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deljenje ni uspelo. Poskusite znova iz shranjene beležke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att dela. Försök igen från din sparade anteckning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังแชร์ไม่ได้ ลองอีกครั้งจากบันทึกที่เก็บไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể chia sẻ. Hãy thử lại từ ghi chú đã lưu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法分享。請從「已儲存的筆記」再試一次。"
          }
        }
      }
    },
    "공유했어요. 저장한 기록은 그대로 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유했어요. 저장한 기록은 그대로 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared. Your saved note is unchanged."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Споделено. Запазената бележка не е променена."
          }
        },
        "cs": {
          "stringUnit": {
