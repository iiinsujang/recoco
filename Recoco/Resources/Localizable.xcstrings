        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune suggestion pour le moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl grianghraif le moladh faoi láthair."
