    "일치하는 기록이 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 기록이 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching notes."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма съвпадащи бележки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné odpovídající poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen matchende noter."
          }
