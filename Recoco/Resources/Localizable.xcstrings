    "읽지 못한 사진은 잠시 두고, 다른 사진에서 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽지 못한 사진은 잠시 두고, 다른 사진에서 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll skip the photos we couldn’t read and look through the others."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще пропуснем незаредените снимки и ще прегледаме другите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, které nelze načíst, přeskočíme a projdeme ostatní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi springer ulæselige fotos over og tjekker de andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir überspringen vorerst die nicht lesbaren Fotos und sehen uns die übrigen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα παραλείψουμε τις φωτογραφίες που δεν μπορέσαμε να διαβάσουμε και θα ψάξουμε στις υπόλοιπες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaremos de lado las fotos que no se han podido leer y buscaremos entre las demás."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätame loetamatud fotod vahele ja vaatame teisi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohitamme kuvat, joita ei voitu lukea, ja etsimme muista kuvista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous laissons de côté les photos illisibles pour examiner les autres."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scipeálfaimid na grianghraif nárbh fhéidir linn a léamh agus seiceálfaimid na cinn eile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preskočit ćemo fotografije koje ne možemo učitati i pregledati ostale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nem olvasható fotókat kihagyjuk, és a többi között keresünk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við sleppum myndunum sem tókst ekki að lesa og skoðum hinar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora saltiamo le foto illeggibili e cerchiamo tra le altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めなかった写真はいったん置いて、別の写真から探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Praleisime neperskaitytas nuotraukas ir peržiūrėsime kitas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izlaidīsim attēlus, kurus neizdevās nolasīt, un pārskatīsim citus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naqbżu r-ritratti li ma stajniex naqraw u naraw l-oħrajn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hopper over bildene som ikke kan leses, og ser gjennom resten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We slaan onleesbare foto’s over en bekijken de andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominiemy nieczytelne zdjęcia i przejrzymy pozostałe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos deixar de lado as fotografias que não conseguimos ler e procurar nas restantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom omite pozele ilizibile și vom căuta printre celelalte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, ktoré sa nedajú načítať, preskočíme a prezrieme ostatné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, ki jih ni mogoče prebrati, bomo preskočili in pregledali druge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hoppar över foton som inte kan läsas och granskar de andra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะข้ามรูปที่ยังอ่านไม่ได้ แล้วดูรูปอื่นก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoco sẽ bỏ qua những ảnh chưa đọc được và xem những ảnh khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先略過無法讀取的照片，從其他照片中尋找建議。"
          }
        }
      }
    },
