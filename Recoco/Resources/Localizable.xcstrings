    "‘남긴 기록’에 글을 보관했어요. 사진 원본은 따로 저장하지 않았어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘남긴 기록’에 글을 보관했어요. 사진 원본은 따로 저장하지 않았어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your text is in Saved notes. No separate copy of the original photo was saved."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът е в запазените бележки. Не е създадено отделно копие на оригиналната снимка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text je v uložených poznámkách. Samostatná kopie původní fotky nevznikla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten er gemt i dine noter. Der er ikke gemt en ekstra kopi af det originale foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Text ist in den gespeicherten Notizen. Das Originalfoto wurde nicht zusätzlich kopiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο βρίσκεται στις αποθηκευμένες σημειώσεις. Δεν αποθηκεύτηκε ξεχωριστό αντίγραφο της αρχικής φωτογραφίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto está en las notas guardadas. No se ha guardado una copia aparte de la foto original."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst on salvestatud märgetes. Algfotost ei salvestatud eraldi koopiat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti löytyy tallennetuista muistiinpanoista. Alkuperäisestä kuvasta ei tallennettu erillistä kopiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte figure dans les notes enregistrées. Aucune copie distincte de la photo originale n’a été créée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an téacs faoi Nótaí sábháilte. Níor cruthaíodh cóip eile den bhunghrianghraf."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst je spremljen u bilješke. Nije spremljena zasebna kopija izvorne fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveged a mentett jegyzetek között található. Az eredeti fotóról nem készült külön másolat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textinn er í Vistuðum minnispunktum. Ekkert aukaafrit af frummyndinni var vistað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo è nelle note salvate. La foto originale non è stata salvata in una copia separata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章は「保存したメモ」にあります。元の写真のコピーは保存されていません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstas yra išsaugotuose užrašuose. Atskira originalios nuotraukos kopija neišsaugota."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksts ir saglabātajās piezīmēs. Atsevišķa oriģinālā fotoattēla kopija netika saglabāta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-test jinsab fin-Noti salvati. Ma ġietx salvata kopja oħra tar-ritratt oriġinali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten er lagret i notatene dine. Ingen egen kopi av originalbildet ble lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tekst staat bij je bewaarde notities. Er is geen extra kopie van de originele foto bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst zapisano w notatkach. Nie zapisano osobnej kopii oryginalnego zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto está nas notas guardadas. Não foi criada uma cópia da fotografia original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul se află în notițele salvate. Nu a fost salvată o copie separată a pozei originale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text je v uložených poznámkach. Samostatná kópia pôvodnej fotky nevznikla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besedilo je shranjeno v beležkah. Ločena kopija izvirne fotografije ni bila shranjena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten finns i dina sparade anteckningar. Ingen separat kopia av originalfotot sparades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความอยู่ในบันทึกที่เก็บไว้ โดยไม่ได้ทำสำเนารูปต้นฉบับแยกไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung nằm trong Ghi chú đã lưu. Không có bản sao riêng của ảnh gốc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字已存入「已儲存的筆記」，未另存原始照片。"
          }
        }
      }
    },
    "‘남긴 기록’에서 글과 사진 미리보기를 다시 볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘남긴 기록’에서 글과 사진 미리보기를 다시 볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your text and photo preview in Saved notes."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът и прегледът на снимката са в запазените бележки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text a náhled fotky najdete v uložených poznámkách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du finder teksten og det lille billede i dine gemte noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text und Fotovorschau findest du in den gespeicherten Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο και η προεπισκόπηση βρίσκονται στις αποθηκευμένες σημειώσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto y la vista previa de la foto están en las notas guardadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti ja foto eelvaate leiad salvestatud märgetest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydät tekstin ja kuvan esikatselun tallennetuista muistiinpanoista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez le texte et l’aperçu de la photo dans les notes enregistrées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an téacs agus an réamhamharc faoi Nótaí sábháilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst i pregled fotografije pronaći ćete u spremljenim bilješkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveget és a fotó előnézetét a mentett jegyzetek között találod."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textinn og forskoðun myndar eru í Vistuðum minnispunktum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo e l’anteprima della foto sono nelle note salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章と写真のプレビューは「保存したメモ」で見られます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstą ir nuotraukos peržiūrą rasi išsaugotuose užrašuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksts un attēla priekšskatījums atrodami saglabātajās piezīmēs."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-test u l-previżjoni tar-ritratt jinsabu fin-Noti salvati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du finner teksten og forhåndsvisningen i de lagrede notatene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vindt je tekst en het fotovoorbeeld bij je bewaarde notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst i podgląd zdjęcia znajdziesz w zapisanych notatkach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto e a pré-visualização da fotografia estão em «Notas guardadas»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul și previzualizarea pozei se află în „Notițe salvate”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text a náhľad fotky nájdete v uložených poznámkach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besedilo in predogled fotografije najdete v shranjenih beležkah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten och bildförhandsvisningen finns i dina sparade anteckningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูข้อความและรูปตัวอย่างได้ในบันทึกที่เก็บไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem nội dung và ảnh xem trước trong Ghi chú đã lưu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在「已儲存的筆記」查看文字與照片預覽。"
          }
        }
      }
    },
    "‘사진 다시 확인하기’를 누르면 읽지 못한 사진을 다시 확인해요. 사진을 따로 고를 필요는 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘사진 다시 확인하기’를 누르면 읽지 못한 사진을 다시 확인해요. 사진을 따로 고를 필요는 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Check photos again” to retry. You don’t need to select the photos again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни „Провери снимките отново“. Не е нужно да ги избираш повторно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte fotky znovu. Nemusíte je znovu vybírat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på »Tjek fotos igen« for at prøve igen. Du behøver ikke vælge dem på ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Fotos erneut prüfen“. Du musst die Fotos nicht noch einmal auswählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε «Επανέλεγχος φωτογραφιών» για νέα προσπάθεια. Δεν χρειάζεται να τις επιλέξεις ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Volver a comprobar las fotos». No hace falta que vuelvas a seleccionarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali „Kontrolli fotosid uuesti“, et uuesti proovida. Fotosid ei pea uuesti valima."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritä uudelleen valitsemalla ”Tarkista kuvat uudelleen”. Kuvia ei tarvitse valita uudestaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Revérifier les photos ». Inutile de les sélectionner à nouveau."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil “Seiceáil na grianghraif arís” chun triail eile a bhaint as. Ní gá iad a roghnú arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno provjerite fotografije. Ne morate ih opet odabrati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd a „Fotók újbóli ellenőrzése” lehetőséget. A fotókat nem kell újból kijelölnöd."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á „Athuga myndir aftur“. Þú þarft ekki að velja myndirnar aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca “Ricontrolla le foto”. Non serve selezionarle di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真をもう一度確認」をタップすると、読み込めなかった写真を再確認します。選び直す必要はありません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėk „Patikrinti nuotraukas dar kartą“. Nuotraukų iš naujo pasirinkti nereikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spied “Pārbaudīt attēlus vēlreiz”. Attēli nav jāatlasa no jauna."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas “Erġa’ ċċekkja r-ritratti”. M’hemmx għalfejn terġa’ tagħżilhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «Sjekk bilder igjen» for å prøve på nytt. Du trenger ikke velge dem igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ‘Controleer foto’s opnieuw’ om het nog eens te proberen. Je hoeft de foto’s niet opnieuw te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź zdjęcia ponownie. Nie musisz ich jeszcze raz wybierać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em «Verificar fotografias de novo» para repetir. Não precisas de as selecionar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge „Verifică din nou pozele” pentru a reîncerca. Nu trebuie să le selectezi din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte fotky znova. Nemusíte ich opäť vyberať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova preverite fotografije. Ni jih treba znova izbirati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Kontrollera foton igen” för att försöka igen. Du behöver inte välja om dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ “ตรวจสอบรูปอีกครั้ง” เพื่อลองใหม่ โดยไม่ต้องเลือกรูปซ้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm “Kiểm tra lại ảnh” để thử lại. Bạn không cần chọn lại ảnh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「重新檢查照片」即可再次檢查未能讀取的照片，不用重新選取。"
          }
        }
      }
    },
    "‘사진 더 선택하기’에서 접근할 사진을 추가하거나, ‘다른 사진부터 살펴보기’로 지금 접근 가능한 사진에서 추천을 찾아보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘사진 더 선택하기’에서 접근할 사진을 추가하거나, ‘다른 사진부터 살펴보기’로 지금 접근 가능한 사진에서 추천을 찾아보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Select more photos” to allow more, or “Review other photos” to find suggestions among the photos already available."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни „Избери още снимки“, за да разрешиш достъп до още, или „Прегледай други“, за да потърсиш сред достъпните."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte další fotky pro rozšíření přístupu nebo projděte jiné mezi již dostupnými."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på »Vælg flere fotos« for at give adgang til flere. Vælg »Gennemgå andre fotos« for at søge blandt dem, der allerede er adgang til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Weitere Fotos auswählen“ kannst du Fotos freigeben. Mit „Andere Fotos durchsehen“ suchst du unter bereits verfügbaren Fotos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε «Επιλογή περισσότερων φωτογραφιών» για να επιτρέψεις πρόσβαση και σε άλλες ή «Έλεγχος άλλων φωτογραφιών» για αναζήτηση στις ήδη διαθέσιμες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Seleccionar más fotos» para ampliar el acceso, o «Revisar otras fotos» para buscar entre las que ya están disponibles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali „Vali veel fotosid“, et lubada ligipääs uutele fotodele, või „Vaata teisi fotosid“, et otsida juba lubatute seast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää sallittuja kuvia valitsemalla ”Valitse lisää kuvia”. Voit hakea ehdotuksia jo sallituista kuvista valitsemalla ”Tarkastele muita kuvia”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Sélectionner d’autres photos » pour élargir l’accès, ou « Examiner d’autres photos » pour parcourir les photos déjà accessibles."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil “Roghnaigh tuilleadh grianghraf” chun tuilleadh rochtana a cheadú, nó “Féach ar ghrianghraif eile” chun na grianghraif atá ar fáil a chuardach."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite još fotografija da biste im dopustili pristup ili pregledajte druge među već dostupnima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „További fotók kijelölése” újabb fotókhoz ad hozzáférést. A „Más fotók átnézése” a már elérhető fotók között keres."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á „Velja fleiri myndir“ til að veita meiri aðgang eða „Skoða aðrar myndir“ til að leita meðal þeirra sem þegar eru tiltækar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca “Seleziona altre foto” per ampliare l’accesso oppure “Rivedi altre foto” per cercare tra quelle già disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真を追加で選ぶ」でアクセスできる写真を増やすか、「別の写真から探す」で今見られる写真から探せます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėk „Pasirinkti daugiau nuotraukų“, jei nori išplėsti prieigą, arba „Peržiūrėti kitas“, kad ieškotum tarp jau prieinamų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spied “Atlasīt vēl attēlus”, lai paplašinātu piekļuvi, vai “Skatīt citus attēlus”, lai meklētu starp jau pieejamajiem."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas “Agħżel aktar ritratti” biex tagħti aktar aċċess, jew “Ara ritratti oħra” biex tfittex fost ir-ritratti diġà disponibbli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «Velg flere bilder» for å gi tilgang til flere. Velg «Se gjennom andre bilder» for å søke blant bildene du allerede har gitt tilgang til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ‘Selecteer meer foto’s’ om meer foto’s toe te staan. Met ‘Bekijk andere foto’s’ vind je suggesties binnen de huidige selectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz więcej zdjęć, aby udostępnić kolejne, lub przejrzyj inne, aby znaleźć propozycje wśród już dostępnych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em «Selecionar mais fotografias» para dar acesso a outras, ou em «Rever outras fotografias» para procurar entre as que já estão disponíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge „Selectează alte poze” pentru a extinde accesul sau „Verifică alte poze” pentru a căuta printre pozele deja accesibile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte ďalšie fotky a rozšírte prístup alebo prejdite iné z už dostupných fotiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite več fotografij za razširitev dostopa ali preglejte druge med že dostopnimi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Välj fler foton” för att ge åtkomst till fler. Välj ”Granska andra foton” för att söka bland dem du redan gett åtkomst till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ “เลือกรูปเพิ่ม” เพื่ออนุญาตรูปเพิ่มเติม หรือ “ดูรูปอื่น” เพื่อค้นหาจากรูปที่อนุญาตแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm “Chọn thêm ảnh” để cấp quyền cho ảnh khác, hoặc “Xem các ảnh khác” để tìm gợi ý trong những ảnh đã cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「選取更多照片」來增加可取用的照片，或點「從其他照片尋找」，從目前可取用的照片中尋找建議。"
          }
        }
      }
    },
    "가까운 시간에 찍은 비슷한 사진이 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 시간에 찍은 비슷한 사진이 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s a similar photo taken around the same time."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Има подобна снимка, направена почти по същото време."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobná fotka byla pořízena přibližně ve stejnou dobu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lignende foto blev taget på næsten samme tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ähnliches Foto entstand fast zur gleichen Zeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει παρόμοια φωτογραφία που τραβήχτηκε σχεδόν την ίδια στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una foto parecida tomada casi al mismo tiempo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "On veel üks sarnane foto, mis on tehtud peaaegu samal ajal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samankaltainen kuva otettiin lähes samaan aikaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo similaire a été prise presque au même moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá grianghraf cosúil leis ann a tógadh thart ar an am céanna."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slična fotografija snimljena je otprilike u isto vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasonló fotó készült majdnem ugyanakkor."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Til er svipuð mynd tekin um svipað leyti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è una foto simile scattata quasi nello stesso momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近い時間に撮った、よく似た写真があります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Yra panaši nuotrauka, padaryta beveik tuo pačiu metu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir līdzīgs attēls, kas uzņemts gandrīz tajā pašā laikā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemm ritratt simili li ttieħed madwar l-istess ħin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lignende bilde ble tatt omtrent samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een vergelijkbare foto die rond dezelfde tijd is genomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobne zdjęcie zostało zrobione niemal w tym samym czasie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma fotografia parecida tirada quase ao mesmo tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există o poză asemănătoare făcută cam în același timp."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobná fotka vznikla približne v rovnakom čase."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobna fotografija je bila posneta približno ob istem času."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett liknande foto togs vid ungefär samma tidpunkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีรูปคล้ายกันที่ถ่ายในเวลาใกล้กัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có một tấm tương tự được chụp gần như cùng lúc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一張相似的照片，拍攝時間很接近。"
          }
        }
      }
    },
    "가장 선명해요.": {
