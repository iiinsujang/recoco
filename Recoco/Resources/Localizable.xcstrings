    "지난해 같은 날짜에서 앞뒤 7일 안에 찍은 사진이에요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난해 같은 날짜에서 앞뒤 7일 안에 찍은 사진이에요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken within a week of this date last year."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заснета е около същата дата миналата година, с разлика до седмица."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka vznikla loni, nejvýš týden před nebo po tomto datu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taget inden for en uge før eller efter denne dato sidste år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto entstand etwa um diese Zeit im letzten Jahr, mit bis zu sieben Tagen Abstand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήχτηκε πέρσι, έως επτά ημέρες πριν ή μετά από τη σημερινή ημερομηνία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto se tomó el año pasado, en los siete días anteriores o posteriores a esta fecha."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pildistatud eelmisel aastal selle kuupäeva lähedal, kuni nädalase vahega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva otettiin viime vuonna enintään viikko ennen tätä päivämäärää tai sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a été prise à moins de sept jours de cette date l’an dernier."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tógadh é gar don dáta seo anuraidh, laistigh de sheachtain."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimljeno lani, najviše tjedan dana prije ili poslije ovog datuma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavaly ilyenkor készült, ettől a dátumtól legfeljebb hét nap eltéréssel."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekin um þetta leyti í fyrra, innan viku frá sömu dagsetningu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto risale all’anno scorso, nei sette giorni prima o dopo questa data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨年の同じ日から前後7日以内に撮った写真です。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padaryta maždaug šiuo metu pernai, ne daugiau kaip savaitės skirtumu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzņemts ap šo pašu datumu pērn, ar ne vairāk kā nedēļas starpību."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ittieħed qrib din id-data s-sena l-oħra, b’differenza ta’ mhux aktar minn ġimgħa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatt innen en uke før eller etter denne datoen i fjor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemaakt rond deze datum vorig jaar, maximaal een week eerder of later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie zrobione w zeszłym roku, w ciągu tygodnia od tej daty."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi tirada no ano passado, até sete dias antes ou depois desta data."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Făcută în intervalul de șapte zile înainte sau după această dată, anul trecut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka vznikla vlani, najviac týždeň pred týmto dátumom alebo po ňom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posneto lani, največ teden dni pred tem datumom ali po njem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taget inom en vecka före eller efter det här datumet förra året."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายช่วงใกล้วันเดียวกันของปีที่แล้ว ห่างไม่เกินหนึ่งสัปดาห์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được chụp trong khoảng một tuần trước hoặc sau ngày này năm ngoái."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片拍於去年同一天的前後七天內。"
          }
        }
      }
    },
