          "stringUnit": {
            "state": "translated",
            "value": "Säilitamiseks valitud foto jääb alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytettäväksi valitsemasi kuva jää talteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo que vous avez choisi de garder sera conservée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanfaidh an grianghraf a roghnaigh tú le coinneáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija odabrana za zadržavanje ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megtartásra kijelölt fotó megmarad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndin sem þú valdir að geyma verður áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto che hai scelto di tenere verrà conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残すと決めた1枚は、そのまま残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka, kurią pasirinkai pasilikti, liks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēls, kuru izvēlējies paturēt, paliks."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-ritratt li għażilt li żżomm jibqa’."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet du valgte å beholde blir igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto die je wilt bewaren blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie wybrane do zachowania pozostanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia que escolheste manter fica na fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poza pe care ai ales să o păstrezi rămâne în bibliotecă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka vybraná na ponechanie zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija, ki ste jo izbrali za ohranitev, ostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot du valde att behålla finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่คุณเลือกเก็บไว้จะยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh bạn đã chọn giữ sẽ còn nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你決定留下的那張照片會保留。"
          }
        }
      }
    },
    "남길 사진과 비교": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남길 사진과 비교"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with the copy to keep"
