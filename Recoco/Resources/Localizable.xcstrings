        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema bilježaka. Napišite nekoliko riječi o fotografiji koju želite zapamtiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek jegyzeteid. Írj egy sort egy emlékezetes fotóhoz."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engir minnispunktar enn. Skrifaðu línu um mynd sem þú vilt minnast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna nota. Scrivi una frase su una foto che vuoi ricordare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモはまだありません。覚えておきたい写真にひとこと残してみましょう。"
