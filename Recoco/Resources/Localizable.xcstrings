    "최근 사진부터 골랐어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 사진부터 골랐어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We started with a recent photo."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започнахме с наскоро направена снимка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začali jsme nedávnou fotkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi begyndte med et nyere foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben mit einem neueren Foto begonnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήσαμε με μια πρόσφατη φωτογραφία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos empezado por una foto reciente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alustasime ühest hiljutisest fotost."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitimme äskettäin otetusta kuvasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons commencé par une photo récente."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Thosaíomar le grianghraf le déanaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počeli smo s nedavnom fotografijom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy friss fotóval kezdtük."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við byrjuðum á nýlegri mynd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo iniziato da una foto recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の写真から選びました。"
          }
        },
        "lt": {
