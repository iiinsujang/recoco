    "사진 앱에서 ‘최근 삭제된 항목’을 열고, 사진을 선택한 뒤 ‘복구’를 눌러주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에서 ‘최근 삭제된 항목’을 열고, 사진을 선택한 뒤 ‘복구’를 눌러주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Photos, open Recently Deleted, select a photo, then tap Recover."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В „Снимки“ отвори „Наскоро изтрити“, избери снимка и натисни „Възстанови“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Fotkách otevřete Nedávno smazané, vyberte fotku a klepněte na Obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Slettet for nylig i Fotos, vælg et foto, og tryk på Gendan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Zuletzt gelöscht“ in Fotos, wähle ein Foto und tippe auf „Wiederherstellen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις Φωτογραφίες άνοιξε τις «Πρόσφατες διαγραφές», διάλεξε τη φωτογραφία και πάτησε «Ανάκτηση»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Fotos, abre «Eliminado», selecciona una foto y toca «Recuperar»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava rakenduses Fotod album Hiljuti kustutatud, vali foto ja puuduta nuppu Taasta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Kuvat-apissa Äskettäin poistetut, valitse kuva ja napauta Palauta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Photos, ouvrez « Supprimées récemment », choisissez une photo et touchez « Récupérer »."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "In Grianghraif, oscail Scriosta le déanaí, roghnaigh grianghraf agus tapáil Aisghabh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U aplikaciji Foto otvorite Nedavno obrisano, odaberite fotografiju i dodirnite Obnovi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Fotók app Nemrég törölt albumát, válassz egy fotót, majd koppints a Visszaállítás gombra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu Nýlega eytt í Myndum, veldu mynd og ýttu á Endurheimta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Foto, apri “Eliminati di recente”, scegli una foto e tocca “Recupera”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリで「最近削除した項目」を開き、写真を選んで「復元」をタップしてください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukų programoje atverk „Neseniai ištrinta“, pasirink nuotrauką ir bakstelėk „Atkurti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotnē Fotoattēli atver Nesen dzēstie, atlasi attēlu un spied Atgūt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fl-app Ritratti, iftaħ Imħassra reċentement, agħżel ritratt u agħfas Irkupra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Nylig slettet i Bilder, velg et bilde og trykk på Gjenopprett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ‘Recent verwijderd’ in Foto’s, kies een foto en tik op ‘Zet terug’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W aplikacji Zdjęcia otwórz Ostatnio usunięte, wybierz zdjęcie i stuknij Odzyskaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na app Fotografias, abre «Apagado recentemente», seleciona a fotografia e toca em «Recuperar»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Poze, deschide „Șterse recent”, selectează poza și atinge „Recuperează”."
