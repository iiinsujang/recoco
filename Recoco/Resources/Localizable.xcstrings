    "비운 날을 누르면 사진 수를 볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비운 날을 누르면 사진 수를 볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a day to see how many photos you cleared."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни ден, за да видиш колко снимки си изтрил."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na den zobrazíte počet smazaných fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en dag for at se, hvor mange fotos du slettede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Tag, um zu sehen, wie viele Fotos du gelöscht hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μια ημερομηνία για να δεις πόσες φωτογραφίες διέγραψες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un día para ver cuántas fotos borraste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta päeva, et näha, mitu fotot kustutasid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta päivää, niin näet poistettujen kuvien määrän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une date pour voir combien de photos vous avez supprimées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil lá chun líon na ngrianghraf a scrios tú a fheiceáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite dan da biste vidjeli broj izbrisanih fotografija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy napra a törölt fotók számának megtekintéséhez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á dag til að sjá hve mörgum myndum þú eyddir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una data per vedere quante foto hai eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付をタップすると、削除した写真の数がわかります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėk dieną ir pamatysi ištrintų nuotraukų skaičių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskaries dienai, lai redzētu dzēsto attēlu skaitu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas fuq ġurnata biex tara kemm ħassart ritratti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en dag for å se hvor mange bilder du slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een dag om te zien hoeveel foto’s je hebt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dzień, aby sprawdzić liczbę usuniętych zdjęć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num dia para veres quantas fotografias apagaste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o zi pentru a vedea câte poze ai șters."
