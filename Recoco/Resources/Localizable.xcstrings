    "다음에 정리하고 싶은 항목을 고를 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 정리하고 싶은 항목을 고를 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what you’d like to tidy next."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери какво искаш да подредиш следващия път."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, co chcete příště uspořádat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvad du vil rydde op i næste gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, was du als Nächstes aufräumen möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε τι θα ήθελες να τακτοποιήσεις στη συνέχεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué te gustaría ordenar a continuación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, mida soovid järgmisena korrastada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitä haluaisit järjestellä seuraavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que vous aimeriez trier ensuite."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh cad ba mhaith leat a ghlanadh ina dhiaidh seo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite što biste sljedeće htjeli urediti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mit rendeznél legközelebb."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu hverju þú vilt taka til í næst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa vorresti riordinare dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に整理したいものを選んでください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirink, ką norėtum tvarkyti toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlies, ko vēlies kārtot nākamreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel dak li tixtieq tirranġa d-darba li jmiss."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hva du vil rydde opp i neste gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wat je hierna wilt opruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
