    "켜기·끄기는 바로 적용돼요. 시간만 바꾸면 저장해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜기·끄기는 바로 적용돼요. 시간만 바꾸면 저장해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders turn on or off right away. Save any changes to the time."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напомнянията се включват и изключват веднага. Ако промениш часа, запази го."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky se zapínají a vypínají ihned. Změněný čas uložte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelser slås straks til eller fra. Husk at gemme et ændret tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein- und Ausschalten wirkt sofort. Eine neue Uhrzeit musst du speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενεργοποίηση ή απενεργοποίηση γίνεται αμέσως. Αποθήκευσε τυχόν αλλαγές στην ώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se activan o desactivan al instante. Guarda los cambios de hora."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeldetuletused lülituvad kohe sisse või välja. Kui muudad kellaaega, salvesta see."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutukset kytkeytyvät heti päälle tai pois. Jos muutat kellonaikaa, tallenna se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels s’activent ou se désactivent immédiatement. Enregistrez les changements d’heure."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagann meabhrúcháin ar siúl nó múchtar iad láithreach. Sábháil an t-am má athraíonn tú é."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici se uključuju ili isključuju odmah. Promijenjeno vrijeme spremite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A be- és kikapcsolás azonnal érvénybe lép. Ha az időpontot módosítod, mentsd el."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kveikt eða slökkt er strax. Vistaðu tímann ef þú breytir honum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attivazione e la disattivazione sono immediate. Salva le modifiche all’orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン・オフの切り替えはすぐに反映されます。時刻を変えたら保存してください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Priminimai įjungiami arba išjungiami iškart. Pakeistą laiką išsaugok."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atgādinājumi tiek ieslēgti vai izslēgti uzreiz. Ja maini laiku, saglabā to."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tfakkiriet jinxtegħlu jew jintfew minnufih. Jekk tibdel il-ħin, salvah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser slås av eller på med en gang. Lagre tidspunktet hvis du endrer det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen gaan direct aan of uit. Bewaar wijzigingen in het tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia włączają się i wyłączają od razu. Zmienioną godzinę trzeba zapisać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ativação ou desativação é imediata. Guarda as alterações à hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activarea sau dezactivarea este imediată. Salvează modificările orei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky sa zapínajú a vypínajú hneď. Zmenený čas uložte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki se vklopijo ali izklopijo takoj. Spremenjeni čas shranite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser slås på eller av direkt. Spara tiden om du ändrar den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหรือปิดได้ทันที หากเปลี่ยนเวลา ให้กดบันทึกด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt có hiệu lực ngay. Nếu đổi giờ, hãy chạm lưu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉提醒會立即生效。更改時間後，請記得儲存。"
          }
        }
      }
    },
    "탈퇴 전 확인해주세요.": {
      "extractionState": "manual",
