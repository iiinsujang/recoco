    "로그인한 계정이 바뀌었어요. 현재 계정을 확인한 뒤 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 계정이 바뀌었어요. 현재 계정을 확인한 뒤 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has changed. Check which account you’re using and try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Акаунтът е променен. Провери кой акаунт използваш и опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet se změnil. Zkontrolujte aktuální účet a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen er ændret. Tjek, hvilken konto du bruger, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der angemeldete Account hat sich geändert. Prüfe deinen aktuellen Account und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός άλλαξε. Έλεγξε ποιον χρησιμοποιείς και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta ha cambiado. Comprueba qué cuenta estás usando y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto on vahetunud. Kontrolli, millist kontot kasutad, ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tili on vaihtunut. Tarkista, mitä tiliä käytät, ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte connecté a changé. Vérifiez le compte utilisé, puis réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an cuntas athraithe. Seiceáil cén cuntas atá in úsáid agat agus bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun se promijenio. Provjerite kojim se računom koristite pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók megváltozott. Ellenőrizd, melyik fiókot használod, és próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Reikningurinn hefur breyst. Athugaðu hvaða reikning þú notar og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account è cambiato. Verifica quale account stai usando e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中のアカウントが変わりました。現在のアカウントを確認して、もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paskyra pasikeitė. Patikrink, kurią paskyrą naudoji, ir bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konts ir mainījies. Pārbaudi, kuru kontu izmanto, un mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kont inbidel. Iċċekkja liema kont qed tuża u erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen er endret. Kontroller hvilken konto du bruker, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is gewijzigd. Controleer met welk account je bent ingelogd en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto się zmieniło. Sprawdź, którego konta używasz, i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta mudou. Verifica a conta que estás a usar e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul s-a schimbat. Verifică ce cont folosești și încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet sa zmenil. Skontrolujte aktuálny účet a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun se je spremenil. Preverite trenutni račun in poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontot har ändrats. Kontrollera vilket konto du använder och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีเปลี่ยนไปแล้ว โปรดตรวจสอบบัญชีที่ใช้อยู่แล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản đã thay đổi. Hãy kiểm tra tài khoản đang dùng rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入的帳號已變更。請確認目前的帳號後再試一次。"
          }
        }
      }
    },
