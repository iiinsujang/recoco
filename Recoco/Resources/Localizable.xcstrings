    "30일 뒤 다시 확인": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 뒤 다시 확인"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again in 30 days"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери след 30 дни"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolovat za 30 dní"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek igen om 30 dage"
          }
        },
        "de": {
          "stringUnit": {
