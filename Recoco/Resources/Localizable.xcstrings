    "사진 정리,\n가볍게 시작해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 정리,\n가볍게 시작해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lighter way to\nsort your photos."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започни да подреждаш снимките\nмалко по малко."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
