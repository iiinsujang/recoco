    "새 사진이 생기면 다시 살펴볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 사진이 생기면 다시 살펴볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back when you have new photos."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Върни се, когато имаш нови снимки."
          }
        },
        "cs": {
          "stringUnit": {
