    "사진을 비우기 전에 다시 확인이 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 비우기 전에 다시 확인이 필요해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check these photos again before deleting."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери отново тези снимки, преди да ги изтриеш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před smazáním tyto fotky znovu zkontrolujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek disse fotos igen, før du sletter dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Fotos vor dem Löschen noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε ξανά αυτές τις φωτογραφίες πριν τις διαγράψεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba estas fotos antes de borrarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli neid fotosid enne kustutamist uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista kuvat vielä ennen poistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ces photos avant de les supprimer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiceáil na grianghraif seo arís sula scriosfaidh tú iad."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije brisanja još jednom provjerite ove fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlés előtt ellenőrizd újra a fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu þessar myndir aftur áður en þú eyðir þeim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla queste foto prima di eliminarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除する前に、写真をもう一度確認してください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš ištrinant dar kartą patikrink šias nuotraukas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms dzēšanas vēlreiz pārbaudi šos attēlus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erġa’ ċċekkja dawn ir-ritratti qabel tħassarhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk disse bildene igjen før du sletter dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer deze foto’s opnieuw voordat je ze verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed usunięciem sprawdź te zdjęcia ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a verificar estas fotografias antes de as apagar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică din nou pozele înainte de a le șterge."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred vymazaním tieto fotky znova skontrolujte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred brisanjem še enkrat preverite te fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera fotona igen innan du raderar dem."
          }
