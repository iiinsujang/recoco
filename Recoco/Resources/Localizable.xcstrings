    "시작 상태를 저장하지 못했어요. 기존 기록은 그대로 있어요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 상태를 저장하지 못했어요. 기존 기록은 그대로 있어요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save your progress. Your records are safe. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напредъкът не беше запазен. Бележките ти са запазени. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postup se nepodařilo uložit. Vaše záznamy jsou v bezpečí. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fremskridt kunne ikke gemmes. Dine optegnelser er bevaret. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortschritt konnte nicht gespeichert werden. Deine Einträge sind erhalten. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αποθηκεύτηκε η πρόοδος. Οι καταγραφές σου διατηρούνται. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar tu progreso. Tus registros siguen guardados. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Edenemist ei saanud salvestada. Sinu märkmed on alles. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edistymistä ei voitu tallentaa. Tietosi ovat tallessa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer votre progression. Vos données sont conservées. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor sábháladh do dhul chun cinn. Tá do nótaí slán. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napredak nije moguće spremiti. Vaši su zapisi sačuvani. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült menteni a haladást. A feljegyzéseid megvannak. Próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vista stöðuna. Minnispunktarnir þínir eru óhultir. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i progressi. I tuoi dati sono conservati. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行状況を保存できませんでした。記録は残っています。もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko išsaugoti eigos. Tavo užrašai liko. Bandyk dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresu neizdevās saglabāt. Tavas piezīmes ir saglabājušās. Mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex insalvaw il-progress. In-noti tiegħek għadhom hemm. Erġa’ pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremdriften kunne ikke lagres. Opplysningene dine er beholdt. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voortgang kon niet worden bewaard. Je gegevens blijven behouden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać postępu. Twoje dane są bezpieczne. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o progresso. Os registos mantêm-se. Tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresul nu a putut fi salvat. Înregistrările sunt păstrate. Încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Postup sa nepodarilo uložiť. Vaše záznamy sú v bezpečí. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napredka ni bilo mogoče shraniti. Vaši zapisi so varni. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina framsteg kunde inte sparas. Dina uppgifter finns kvar. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังบันทึกการเริ่มใช้งานไม่ได้ บันทึกเดิมยังอยู่ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu được trạng thái bắt đầu. Ghi chú cũ vẫn còn. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存進度。紀錄仍然保留著，請再試一次。"
          }
        }
      }
    },
    "시작 상태를 저장하지 못했어요. 다시 시도해주세요.": {
      "extractionState": "manual",
