    "윤곽과 밝기 차이가 작고 글자·얼굴이 검출되지 않았어요. 촬영 실수일 수도, 의도한 장면일 수도 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윤곽과 밝기 차이가 작고 글자·얼굴이 검출되지 않았어요. 촬영 실수일 수도, 의도한 장면일 수도 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s little contrast, and we found no text or faces. It might be an accidental shot or a scene you meant to capture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрастът е слаб и не открихме текст или лица. Може да е случаен кадър или гледка, която си искал да уловиш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrast je nízký a nenašli jsme text ani obličeje. Může jít o náhodnou fotku i záměrný záběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrasten er lav, og vi fandt hverken tekst eller ansigter. Fotoet kan være taget ved en fejl eller helt med vilje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontrast ist gering und es wurden weder Text noch Gesichter erkannt. Es könnte eine versehentliche oder eine bewusst so aufgenommene Szene sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αντίθεση είναι χαμηλή και δεν εντοπίστηκαν πρόσωπα ή κείμενο. Ίσως ήταν τυχαία λήψη ή μια σκηνή που θέλησες να κρατήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay poco contraste y no se han detectado textos ni caras. Puede ser una foto accidental o una escena que quisiste captar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastsus on madal ning me ei leidnud teksti ega nägusid. See võib olla juhuslik kaader või tahtlikult jäädvustatud vaade."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrasti on pieni, eikä tekstiä tai kasvoja löytynyt. Kyse voi olla vahinkolaukauksesta tai tarkoituksella tällaisesta kuvasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contraste est faible. Aucun texte ni visage n’a été détecté. Il peut s’agir d’un cliché accidentel ou d’une scène photographiée volontairement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an chodarsnacht íseal agus níor aimsíomar téacs ná aghaidheanna. B’fhéidir gur tógadh de thaisme é, nó gur theastaigh uait an radharc a ghabháil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrast je nizak i nismo pronašli tekst ni lica. Snimka može biti slučajna ili namjerna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevés a kontraszt, arcot és szöveget sem találtunk. Lehet véletlen felvétel, vagy egy szándékosan megörökített jelenet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Birtuskil eru lítil og við fundum hvorki texta né andlit. Hún gæti hafa verið tekin fyrir slysni eða þú gætir hafa viljað fanga augnablikið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contrasto è basso e non sono stati rilevati testi né volti. Potrebbe essere uno scatto accidentale o una scena che hai scelto di fotografare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輪郭や明暗の差が小さく、文字や顔も検出されませんでした。うっかり撮った1枚か、意図して撮った場面か、ご確認ください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastas nedidelis, neradome teksto ar veidų. Tai gali būti netyčinis kadras arba vaizdas, kurį norėjai įamžinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrasts ir zems, un neatradām tekstu vai sejas. Iespējams, tas ir nejaušs kadrs vai aina, kuru vēlējies iemūžināt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kuntrast huwa baxx u ma sibniex kitba jew uċuħ. Forsi ttieħed bi żball, jew forsi ridt iżżomm dik ix-xena."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrasten er lav, og vi fant verken tekst eller ansikter. Bildet kan være tatt ved en feil eller med vilje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is weinig contrast en we vonden geen tekst of gezichten. Misschien is de foto per ongeluk gemaakt, of juist bewust zo genomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrast jest niski. Nie wykryliśmy tekstu ani twarzy. Może to być przypadkowe zdjęcie lub celowy kadr."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contraste é baixo e não foram detetados rostos nem texto. Pode ser uma fotografia acidental ou uma cena que quiseste guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrastul este redus și nu s-au detectat fețe sau text. Poate fi o fotografie accidentală sau o scenă pe care ai vrut să o surprinzi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrast je nízky a nenašli sme text ani tváre. Môže ísť o náhodnú fotku aj zámerný záber."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrast je šibek, besedila ali obrazov nismo našli. Posnetek je lahko naključen ali nameren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrasten är låg och vi hittade varken text eller ansikten. Fotot kan vara taget av misstag eller avsiktligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปนี้มีความเปรียบต่างต่ำ และไม่พบข้อความหรือใบหน้า อาจถ่ายโดยไม่ตั้งใจ หรืออาจเป็นภาพที่ตั้งใจเก็บไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh ít tương phản và Recoco không tìm thấy chữ hay khuôn mặt. Có thể bạn vô tình bấm máy, hoặc chủ ý chụp khung cảnh này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片的輪廓和明暗對比都不明顯，也沒辨識到文字或人臉。它可能是誤拍的，也可能是你刻意留下的畫面。"
          }
        }
      }
    },
    "윤곽과 밝기 차이가 작은 사진": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윤곽과 밝기 차이가 작은 사진"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo with faint outlines and low contrast"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимка с неясни контури и слаб контраст"
          }
