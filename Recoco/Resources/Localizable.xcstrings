    "조금 더 걸리고 있어요. 잠시 멈춰도 괜찮아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 더 걸리고 있어요. 잠시 멈춰도 괜찮아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is taking a little longer. You can pause if you like."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще отнеме малко повече време. Можеш да направиш пауза."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvá to o něco déle. Hledání můžete pozastavit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tager lidt længere tid. Du kan holde en pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es dauert etwas länger. Du kannst die Suche pausieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζεται λίγος ακόμη χρόνος. Μπορείς να κάνεις παύση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tardando un poco más. Puedes hacer una pausa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See võtab veidi kauem aega. Soovi korral võid teha pausi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vie hieman tavallista kauemmin. Voit pitää tauon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend un peu plus de temps. Vous pouvez faire une pause."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá sé seo ag glacadh níos faide. Is féidir sos a ghlacadh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo traje malo dulje. Ako želite, možete pauzirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez most kicsit tovább tart. Ha szeretnéd, szüneteltetheted."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tekur aðeins lengri tíma. Þú getur gert hlé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci vuole un po’ più di tempo. Puoi mettere in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し時間がかかりそうです。一時停止しても大丈夫です。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiek tiek užtruks. Jei nori, gali pristabdyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas aizņem nedaudz ilgāku laiku. Ja vēlies, vari ieturēt pauzi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
