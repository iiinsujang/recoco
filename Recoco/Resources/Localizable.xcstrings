    "직접 정한 %@에 다시 꺼냈어요. 필요하면 계속 보관하세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 정한 %@에 다시 꺼냈어요. 필요하면 계속 보관하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You picked %@ to revisit this photo. Keep it if you still need it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избра %@ за повторен преглед на снимката. Запази я, ако още ти трябва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolené datum připomenutí: %@. Pokud fotku potřebujete, ponechte si ji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du valgte %@ til at gense fotoet. Behold det, hvis du stadig har brug for det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wolltest dieses Foto am %@ erneut ansehen. Behalte es, wenn du es noch brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επέλεξες την ημερομηνία %@ για να ξαναδείς τη φωτογραφία. Κράτησέ τη αν τη χρειάζεσαι ακόμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste el %@ para volver a ver esta foto. Consérvala si todavía la necesitas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valisid uuesti vaatamise kuupäevaks %@. Jäta foto alles, kui seda veel vajad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsit tämän kuvan uuteen tarkasteluun ajankohtana %@. Säilytä se, jos tarvitset sitä vielä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aviez choisi le %@ pour revoir cette photo. Gardez-la si vous en avez encore besoin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh tú %@ chun féachaint ar an ngrianghraf seo arís. Coinnigh é má tá sé de dhíth ort."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrani datum ponovnog pregleda: %@. Zadržite fotografiju ako je još trebate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a dátumot választottad az újranézéshez: %@. Ha még szükséged van a fotóra, tartsd meg."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú valdir %@ til að skoða þessa mynd aftur. Geymdu hana ef þú þarft hana enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai scelto il giorno %@ per rivedere questa foto. Conservala se ti serve ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身で選んだ%@になったので、もう一度ご案内しています。必要ならそのまま残せます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šią nuotrauką pasirinkai vėl peržiūrėti %@. Jei jos vis dar reikia, pasilik."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī attēla atkārtotai apskatei izvēlējies %@. Ja attēls vēl vajadzīgs, paturi to."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għażilt %@ biex terġa’ tara dan ir-ritratt. Żommu jekk għad għandek bżonnu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du valgte %@ for å se på bildet igjen. Behold det hvis du fortsatt trenger det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je koos %@ om deze foto opnieuw te bekijken. Bewaar de foto als je die nog nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana data ponownego obejrzenia: %@. Zachowaj zdjęcie, jeśli nadal go potrzebujesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolheste %@ para rever esta fotografia. Mantém-na se ainda precisares dela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai ales data de %@ ca să revezi poza. Păstreaz-o dacă îți mai trebuie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný dátum pripomenutia: %@. Ak fotku ešte potrebujete, nechajte si ju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrani datum za ponovni ogled: %@. Obdržite fotografijo, če jo še potrebujete."
