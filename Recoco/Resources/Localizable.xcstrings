        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes je dan, ki ste ga izbrali za ponoven ogled fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag är dagen du valde för att titta på fotot igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คือวันที่คุณเลือกไว้ให้กลับมาดูรูปนี้"
