        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að athuga geymslu tækisins. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l’archivio locale. Riprova."
          }
