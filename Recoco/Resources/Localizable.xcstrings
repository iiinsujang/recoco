        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við höfum ekki skoðað allar myndirnar enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo ancora esaminato tutte le foto."
