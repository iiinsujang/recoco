        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bruke alle funksjoner uten å logge på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt alle functies gebruiken zonder in te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie funkcje są dostępne bez logowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes usar todas as funcionalidades sem iniciar sessão."
          }
        },
        "ro": {
