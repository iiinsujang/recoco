    "기기 저장 상태를 확인하지 못했어요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 저장 상태를 확인하지 못했어요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check local storage. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да проверим локалното хранилище. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní úložiště se nepodařilo zkontrolovat. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lokale lager kunne ikke tjekkes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Speicher konnte nicht geprüft werden. Versuche es erneut."
