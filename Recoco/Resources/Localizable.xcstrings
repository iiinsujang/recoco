    "아직 초안이에요. 글만 저장하면 사진 미리보기는 보관되지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 초안이에요. 글만 저장하면 사진 미리보기는 보관되지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a draft. Saving just the text will not keep the photo preview."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е чернова. Ако запазиш само текста, прегледът на снимката няма да се съхрани."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je koncept. Při uložení samotného textu se náhled fotky neuchová."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en kladde. Hvis du kun gemmer teksten, gemmes eksempelbilledet ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Entwurf. Wenn du nur den Text speicherst, bleibt die Fotovorschau nicht erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό είναι πρόχειρο. Αν αποθηκεύσεις μόνο το κείμενο, δεν θα διατηρηθεί η προεπισκόπηση της φωτογραφίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un borrador. Si guardas solo el texto, no se conservará la vista previa de la foto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on mustand. Ainult teksti salvestamisel ei jää foto eelvaade alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on luonnos. Jos tallennat vain tekstin, kuvan esikatselua ei tallenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un brouillon. Si vous enregistrez uniquement le texte, l’aperçu de la photo ne sera pas conservé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Dréacht atá anseo. Má shábhálann tú an téacs amháin, ní choinneofar an réamhamharc."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je skica. Ako spremite samo tekst, pregled fotografije neće se sačuvati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy piszkozat. Ha csak a szöveget mented, a fotó előnézete nem marad meg."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta eru drög. Ef þú vistar eingöngu textann fylgir forskoðun myndarinnar ekki með."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una bozza. Se salvi solo il testo, l’anteprima della foto non verrà conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ下書きです。文章だけを保存すると、写真のプレビューは残りません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai juodraštis. Jei išsaugosi tik tekstą, nuotraukos peržiūra neišliks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis ir melnraksts. Saglabājot tikai tekstu, attēla priekšskatījums netiks paturēts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan huwa abbozz. Jekk issalva t-test biss, il-previżjoni tar-ritratt ma tinżammx."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er et utkast. Hvis du bare lagrer teksten, blir ikke forhåndsvisningen av bildet lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een concept. Als je alleen de tekst bewaart, wordt het fotovoorbeeld niet opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To szkic. Zapisanie samego tekstu nie zachowa podglądu zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um rascunho. Se guardares apenas o texto, a pré-visualização da fotografia não será mantida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este o ciornă. Dacă salvezi doar textul, previzualizarea pozei nu se va păstra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je koncept. Pri uložení samotného textu sa náhľad fotky neuchová."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je osnutek. Če shranite le besedilo, se predogled fotografije ne ohrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är ett utkast. Om du bara sparar texten sparas inte bildförhandsvisningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือฉบับร่าง หากบันทึกเฉพาะข้อความ รูปตัวอย่างจะไม่ถูกเก็บไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bản nháp. Nếu chỉ lưu chữ, ảnh xem trước sẽ không được lưu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前是草稿。若只儲存文字，就不會保留照片預覽。"
          }
        }
      }
    },
    "아직 초안이에요. 저장하면 글과 작은 사진 미리보기를 이 기기에 보관해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 초안이에요. 저장하면 글과 작은 사진 미리보기를 이 기기에 보관해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a draft. Save it to keep the text and a small photo preview on this device."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е чернова. Запази я, за да останат текстът и умалено копие на снимката на устройството."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je koncept. Uložením v zařízení uchováte text a malý náhled fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
