    "최근 추천한 사진은 30일 동안 다시 권하지 않아요. 새 후보가 있는지 내일 다시 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 추천한 사진은 30일 동안 다시 권하지 않아요. 새 후보가 있는지 내일 다시 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We wait 30 days before suggesting the same photo again. Come back tomorrow for new picks."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще предложим същата снимка отново най-рано след 30 дни. Върни се утре за нов подбор."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejnou fotku doporučíme znovu nejdřív za 30 dní. Zítra se podívejte na nové návrhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det samme foto foreslås først igen efter 30 dage. Kom tilbage i morgen for at se nye forslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Foto schlagen wir frühestens nach 30 Tagen wieder vor. Schau morgen nach neuen Vorschlägen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ίδια φωτογραφία μπορεί να προταθεί ξανά μετά από 30 ημέρες. Επίστρεψε αύριο για νέες προτάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejamos pasar 30 días antes de sugerir la misma foto. Vuelve mañana para ver nuevas sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama fotot soovitame uuesti kõige varem 30 päeva pärast. Tule homme tagasi uute soovituste järele."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samaa kuvaa ehdotetaan uudelleen aikaisintaan 30 päivän kuluttua. Palaa huomenna katsomaan uusia ehdotuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous attendons 30 jours avant de proposer à nouveau la même photo. Revenez demain pour de nouvelles suggestions."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanann muid 30 lá sula molaimid an grianghraf céanna arís. Tar ar ais amárach le haghaidh moltaí nua."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Istu fotografiju predlažemo ponovno tek nakon 30 dana. Svratite sutra za nove prijedloge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanazt a fotót leghamarabb 30 nap elteltével javasoljuk újra. Nézz vissza holnap az új javaslatokért."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við bíðum í 30 daga áður en við mælum aftur með sömu mynd. Komdu aftur á morgun eftir nýjum tillögum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspettiamo 30 giorni prima di suggerire di nuovo la stessa foto. Torna domani per altre proposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度おすすめした写真は30日間表示しません。明日また新しい候補を探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tą pačią nuotrauką vėl pasiūlysime ne anksčiau kaip po 30 dienų. Rytoj užsuk naujų pasiūlymų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienu un to pašu attēlu atkal ieteiksim ne agrāk kā pēc 30 dienām. Atgriezies rīt pēc jauniem ieteikumiem."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nistennew 30 jum qabel nerġgħu nissuġġerixxu l-istess ritratt. Erġa’ ejja għada għal suġġerimenti ġodda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme bilde foreslås tidligst igjen etter 30 dager. Kom tilbake i morgen for nye forslag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We stellen dezelfde foto pas na 30 dagen weer voor. Kijk morgen of er nieuwe suggesties zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To samo zdjęcie proponujemy ponownie dopiero po 30 dniach. Wróć jutro po nowe propozycje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma fotografia só volta a ser sugerida após 30 dias. Volta amanhã para ver novas sugestões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceeași poză poate fi sugerată din nou după 30 de zile. Revino mâine pentru sugestii noi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú istú fotku odporučíme znova najskôr o 30 dní. Zajtra si pozrite nové návrhy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto fotografijo znova predlagamo šele po 30 dneh. Jutri preverite nove predloge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma foto föreslås igen tidigast efter 30 dagar. Kom tillbaka i morgon för nya förslag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะเว้น 30 วันก่อนแนะนำรูปเดิมอีกครั้ง พรุ่งนี้กลับมาดูรูปแนะนำใหม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoco chờ 30 ngày mới gợi ý lại cùng một ảnh. Hãy quay lại ngày mai để xem gợi ý mới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天內不會重複推薦同一張照片。明天再來看看有沒有新建議。"
          }
        }
      }
    },
