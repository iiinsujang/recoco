            "value": "Vuelve cuando tengas nuevas fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tule tagasi, kui sul on uusi fotosid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa, kun sinulla on uusia kuvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez lorsque vous aurez de nouvelles photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar ar ais nuair a bheidh grianghraif nua agat."
