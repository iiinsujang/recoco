    "지금은 추천할 사진이 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 추천할 사진이 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photos to suggest right now."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В момента няма снимки за предлагане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nemáme žádné fotky k doporučení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen forslag lige nu."
          }
        },
        "de": {
