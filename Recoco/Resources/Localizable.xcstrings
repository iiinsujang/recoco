    "조금 더 살펴보려면 구독이 필요해요. 이용 조건을 먼저 확인해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 더 살펴보려면 구독이 필요해요. 이용 조건을 먼저 확인해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subscription lets you review more photos. Check the details before continuing."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Абонаментът позволява да разгледаш още снимки. Виж условията, преди да продължиш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S předplatným můžete projít další fotky. Nejdřív si přečtěte podrobnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et abonnement kan du gennemgå flere fotos. Læs vilkårene, før du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Abo kannst du weitere Fotos durchsehen. Lies zuerst die Aboinformationen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με συνδρομή μπορείς να δεις περισσότερες φωτογραφίες. Έλεγξε τους όρους πριν συνεχίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción permite revisar más fotos. Consulta las condiciones antes de continuar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellimusega saad vaadata rohkem fotosid. Enne jätkamist kontrolli tingimusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksella voit tarkastella lisää kuvia. Tarkista ehdot ennen kuin jatkat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement permet de revoir davantage de photos. Consultez les modalités avant de continuer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Le síntiús is féidir tuilleadh grianghraf a athbhreithniú. Seiceáil na sonraí ar dtús."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz pretplatu možete pregledati još fotografija. Najprije provjerite pojedinosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfizetéssel több fotót nézhetsz át. Folytatás előtt olvasd el a feltételeket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Áskrift gerir þér kleift að skoða fleiri myndir. Skoðaðu skilmálana áður en þú heldur áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un abbonamento puoi rivedere altre foto. Controlla le condizioni prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに見るにはサブスクリプションが必要です。先に内容をご確認ください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Su prenumerata galėsi peržiūrėti daugiau nuotraukų. Prieš tęsdamas peržiūrėk informaciją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar abonementu var pārskatīt vairāk attēlu. Pirms turpināšanas iepazīsties ar informāciju."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "B’abbonament tista’ tara aktar ritratti. Iċċekkja d-dettalji qabel tkompli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et abonnement kan du se gjennom flere bilder. Les vilkårene før du fortsetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een abonnement kun je meer foto’s bekijken. Lees de voorwaarden voordat je doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja pozwala przeglądać więcej zdjęć. Najpierw sprawdź szczegóły."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura permite rever mais fotografias. Consulta as condições antes de continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonament îți permite să verifici mai multe poze. Consultă condițiile înainte de a continua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S predplatným môžete prezerať ďalšie fotky. Najskôr si pozrite podrobnosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z naročnino si lahko ogledate več fotografij. Najprej preverite podrobnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en prenumeration kan du granska fler foton. Läs villkoren innan du fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมาชิกดูรูปเพิ่มเติมได้ ดูรายละเอียดก่อนดำเนินการต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký cho phép xem thêm ảnh. Hãy xem thông tin trước khi tiếp tục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若想查看更多照片，需要訂閱。請先確認訂閱內容。"
          }
        }
      }
    },
