    "함께 고른 정리 고민": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 고른 정리 고민"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What people want to tidy"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво искат да подредят другите?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chtějí ostatní uspořádat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil andre gerne rydde op i"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was andere aufräumen möchten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι θέλει να τακτοποιήσει ο κόσμος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que la gente quiere ordenar"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida teised soovivad korrastada?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä muut haluavat järjestellä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les autres veulent trier"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cad ba mhaith le daoine a ghlanadh?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što drugi žele urediti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit rendszereznének mások?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í hverju vill fólk taka til?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vorrebbero riordinare gli altri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんなが整理したいもの"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką žmonės nori sutvarkyti?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko citi vēlas sakārtot?"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "X’jixtiequ jirranġaw in-nies?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil andre rydde opp i"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat anderen willen opruimen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co inni chcą uporządkować"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que as pessoas querem organizar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce vor oamenii să organizeze"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo chcú ostatní usporiadať"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaj želijo urediti drugi"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här vill andra rensa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนอยากจัดอะไรบ้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người muốn dọn gì?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大家想整理的項目"
          }
        }
      }
    },
    "허용한 사진 %lld장을 확인했어요. 사진을 더 선택하면 그 안에서 다시 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 사진 %lld장을 확인했어요. 사진을 더 선택하면 그 안에서 다시 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos checked: %lld. Choose more photos and we’ll look through those, too."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверени снимки: %lld. Избери още и ще потърсим сред тях."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolované fotky: %lld. Vyberte další a projdeme i ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjekkede fotos: %lld. Vælg flere, så tjekker vi også dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüfte Fotos: %lld. Wähle weitere Fotos aus, um darin Vorschläge zu finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίες που ελέγχθηκαν: %lld. Διάλεξε κι άλλες και θα τις ελέγξουμε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos revisadas: %lld. Selecciona más y las revisaremos también."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollitud fotosid: %lld. Vali veel fotosid, et neidki kontrollida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistettuja kuvia: %lld. Valitse lisää kuvia, niin tarkistamme nekin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos vérifiées : %lld. Sélectionnez-en d’autres pour chercher de nouvelles suggestions."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Grianghraif a seiceáladh: %lld. Roghnaigh tuilleadh grianghraf lena seiceáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledane fotografije: %lld. Odaberite još pa ćemo pregledati i njih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrzött fotók: %lld. Válassz továbbiakat, és azokat is megnézzük."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndir skoðaðar: %lld. Veldu fleiri og við skoðum þær líka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto controllate: %lld. Selezionane altre e controlleremo anche quelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可された写真を%lld枚確認しました。写真を追加で選ぶと、その中から探せます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikrinta nuotraukų: %lld. Pasirink daugiau ir peržiūrėsime jas taip pat."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudīto attēlu skaits: %lld. Atlasi vēl attēlus, un pārbaudīsim arī tos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti ċċekkjati: %lld. Agħżel aktar u naraw dawk ukoll."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder sjekket: %lld. Velg flere, så sjekker vi dem også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerde foto’s: %lld. Kies meer foto’s om die ook te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzone zdjęcia: %lld. Możesz wybrać kolejne do sprawdzenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias verificadas: %lld. Seleciona mais e vamos verificá-las também."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poze verificate: %lld. Alege altele și le vom verifica și pe acelea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolované fotky: %lld. Vyberte ďalšie a prezrieme aj tie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledane fotografije: %lld. Izberite še druge in pregledali bomo tudi te."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerade foton: %lld. Välj fler så granskar vi även dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจแล้ว %lld รูป เลือกเพิ่มได้ แล้วเราจะค้นหาต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kiểm tra %lld ảnh. Bạn có thể chọn thêm để Recoco tìm tiếp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢查你允許取用的 %lld 張照片。可以選取更多照片，讓我們繼續尋找。"
          }
        }
      }
    },
    "허용한 사진 안에서\n매일 새 후보를 최대 세 장 찾아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 사진 안에서\n매일 새 후보를 최대 세 장 찾아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day, we’ll find up to three new picks\nfrom the photos you allow."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки ден подбираме до три нови снимки\nизмежду тези, до които разрешиш достъп."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den vybereme z povolených fotek\naž tři nové návrhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver dag finder vi op til tre forslag\nblandt de fotos, du giver adgang til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den freigegebenen Fotos wählen wir\ntäglich bis zu drei neue Vorschläge aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε μέρα προτείνουμε έως τρεις φωτογραφίες\nαπό όσες μας επιτρέπεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día te sugerimos hasta tres fotos\nentre las que nos permitas revisar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valime iga päev kuni kolm uut fotot\nnende seast, mida meil näha lubad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsimme päivittäin enintään kolme ehdotusta\nkuvista, joihin sallit pääsyn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour, nous proposons jusqu’à trois photos\nparmi celles auxquelles vous donnez accès."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Gach lá, roghnóimid suas le trí ghrianghraf nua\nas na cinn a cheadaíonn tú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki dan među dopuštenim fotografijama\npronaći ćemo do tri nova prijedloga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naponta legfeljebb három fotót ajánlunk\naz engedélyezettek közül."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Á hverjum degi veljum við allt að þrjár nýjar myndir\núr þeim sem þú veitir aðgang að."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno ti proponiamo fino a tre foto\ntra quelle a cui consenti l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可された写真から、\n毎日最大3枚の新しい候補を探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasdien atrinksime iki trijų naujų nuotraukų\niš tų, kurias leidi peržiūrėti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katru dienu izvēlēsimies līdz trim jauniem attēliem\nno tiem, kam atļāvi piekļuvi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuljum nagħżlu sa tliet ritratti ġodda\nfost dawk li tippermetti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver dag finner vi opptil tre forslag\nblant bildene du gir tilgang til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke dag zoeken we maximaal drie foto’s\nbinnen de toegang die je geeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codziennie spośród udostępnionych zdjęć\nwybierzemy do trzech nowych propozycji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dias sugerimos até três fotografias\nentre as que autorizares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În fiecare zi îți propunem cel mult trei poze\ndintre cele pe care ni le permiți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý deň vyberieme z povolených fotiek\naž tri nové návrhy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak dan bomo med dovoljenimi fotografijami\nizbrali do tri nove predloge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje dag hittar vi upp till tre förslag\nbland fotona du ger oss åtkomst till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละวันเราจะคัดให้ไม่เกินสามรูป\nจากรูปที่คุณอนุญาต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngày, Recoco gợi ý tối đa ba ảnh mới\ntừ những ảnh bạn cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天從你允許取用的照片中，\n最多挑出三張適合整理的照片。"
          }
        }
      }
    },
    "허용한 사진 중 다시 살펴보도록 골랐어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 사진 중 다시 살펴보도록 골랐어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We picked this from the photos you allowed for another look."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избрахме тази за повторен преглед измежду снимките, до които разреши достъп."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto fotku jsme vybrali z povolených fotek k dalšímu prohlédnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi valgte dette foto blandt dem, du gav adgang til, så du kan se det igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto stammt aus deiner Auswahl und ist einen zweiten Blick wert."
          }
        },
        "el": {
