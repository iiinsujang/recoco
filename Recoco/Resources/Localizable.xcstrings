        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số ngày trước khi ảnh này có thể được gợi ý lại: %lld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天後，這張照片會重新列入整理候選清單。"
