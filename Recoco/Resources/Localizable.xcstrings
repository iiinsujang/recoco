    "같은 사진이나 연달아 찍은\n비슷한 장면을 찾아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 사진이나 연달아 찍은\n비슷한 장면을 찾아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I look for duplicates and similar shots\ntaken close together."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търся еднакви и подобни кадри,\nнаправени един след друг."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledám duplikáty a podobné záběry pořízené krátce po sobě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg finder dubletter og billeder, der ligner hinanden og er taget lige efter hinanden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich suche nach Duplikaten und ähnlichen Bildern,\ndie kurz nacheinander entstanden sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ψάχνω διπλότυπα και παρόμοιες φωτογραφίες\nπου τραβήχτηκαν με μικρή χρονική διαφορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busco duplicados y fotos parecidas\ntomadas con poca diferencia de tiempo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsin korduvaid ja sarnaseid kaadreid,\nmis on tehtud lühikese vahega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsin kaksoiskappaleita ja peräkkäin otettuja samankaltaisia kuvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je cherche les doublons et les photos similaires\nprises à quelques instants d’intervalle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorgaím dúblaigh agus grianghraif chosúla\na tógadh i ndiaidh a chéile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tražim duplikate i slične prizore snimljene ubrzo jedan za drugim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másolatokat és rövid időn belül készült,\nhasonló fotókat keresek."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég leita að eins myndum og svipuðum myndum\nsem voru teknar með stuttu millibili."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerco duplicati e scatti simili\nfatti a poca distanza di tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ写真や、近い時間に撮った\nよく似た写真を探すよ。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieškau vienodų ir panašių kadrų,\nkurie buvo padaryti vienas po kito."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meklēju dublikātus un līdzīgus kadrus,\nkas uzņemti ar nelielu laika starpību."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Infittex kopji u ritratti simili\nli ttieħdu wara xulxin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg ser etter duplikater og lignende bilder tatt like etter hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zoek naar dubbele foto’s en vergelijkbare opnamen die kort na elkaar zijn gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukam duplikatów i podobnych ujęć zrobionych w krótkim odstępie czasu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Procuro duplicados e fotografias parecidas\ntiradas com pouco tempo de diferença."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caut duplicate și poze asemănătoare\nfăcute la scurt timp una de alta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadám duplikáty a podobné zábery zhotovené krátko po sebe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiščem dvojnike in podobne prizore, posnete v kratkem zaporedju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag letar efter dubbletter och liknande bilder som tagits tätt efter varandra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะมองหารูปที่ซ้ำกัน หรือรูปคล้ายกัน\nที่ถ่ายต่อเนื่องในเวลาใกล้กัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình tìm những tấm trùng nhau và những cảnh\ngiống nhau được chụp liên tiếp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我會找出重複的照片，或是\n短時間內拍下的相似照片。"
          }
        }
      }
    },
