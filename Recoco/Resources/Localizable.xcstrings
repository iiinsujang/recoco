    "사진 %lld장 비웠어요. 최근 삭제된 항목에서 복구할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장 비웠어요. 최근 삭제된 항목에서 복구할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos deleted: %lld. You can recover them in Recently Deleted."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтрити снимки: %lld. Можеш да ги възстановиш от „Наскоро изтрити“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazáno: %lld. Fotky můžete obnovit v albu Nedávno smazané."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede fotos: %lld. Du kan gendanne dem fra Slettet for nylig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos gelöscht: %lld. Du kannst sie unter „Zuletzt gelöscht“ wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίες που διαγράφηκαν: %lld. Μπορείς να τις ανακτήσεις από τις «Πρόσφατες διαγραφές»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos borradas: %lld. Puedes recuperarlas en «Eliminado»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatud fotosid: %lld. Saad need taastada albumist Hiljuti kustutatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistettuja kuvia: %lld. Voit palauttaa ne Äskettäin poistetut -kokoelmasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos supprimées : %lld. Vous pouvez les récupérer dans « Supprimées récemment »."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Grianghraif a scriosadh: %lld. Is féidir iad a aisghabháil faoi Scriosta le déanaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisano: %lld. Fotografije možete vratiti iz albuma Nedavno obrisano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölt fotók: %lld. A Nemrég törölt albumból visszaállíthatod őket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndum eytt: %lld. Þú getur endurheimt þær í Nýlega eytt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto eliminate: %lld. Puoi recuperarle in “Eliminati di recente”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を%lld枚削除しました。「最近削除した項目」から復元できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinta nuotraukų: %lld. Jas gali atkurti iš albumo „Neseniai ištrinta“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēsto attēlu skaits: %lld. Tos var atgūt albumā Nesen dzēstie."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti mħassra: %lld. Tista’ tirkuprahom fl-album Imħassra reċentement."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede bilder: %lld. Du kan gjenopprette dem fra Nylig slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde foto’s: %lld. Je kunt ze terugzetten vanuit ‘Recent verwijderd’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto: %lld. Zdjęcia możesz odzyskać w albumie Ostatnio usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias apagadas: %lld. Podes recuperá-las em «Apagado recentemente»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poze șterse: %lld. Le poți recupera din „Șterse recent”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazané: %lld. Fotky môžete obnoviť v albume Nedávno vymazané."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisano: %lld. Fotografije lahko obnovite v albumu Nedavno izbrisano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderade foton: %lld. Du kan återskapa dem från Senast raderade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแล้ว %lld รูป กู้คืนได้ในอัลบั้มที่ลบล่าสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa %lld ảnh. Bạn có thể khôi phục trong mục Đã xóa gần đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除 %lld 張照片，你可以從「最近刪除」復原。"
          }
        }
      }
    },
    "사진 %lld장 중 한 장을 남겨요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장 중 한 장을 남겨요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep one from this group of %lld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери една за запазване от тази група от %lld снимки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet fotek ve skupině: %lld. Jednu si ponechte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold ét foto fra denne gruppe på %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte ein Foto aus dieser Gruppe (%lld)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε μία από αυτή την ομάδα των %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva una foto de este grupo de %lld."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali sellest rühmast üks foto alleshoidmiseks. Fotosid kokku: %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä yksi kuva %lld kuvan ryhmästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une photo de ce groupe de %lld."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh ceann le coinneáil as grúpa de %lld."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj fotografija u skupini: %lld. Zadržite jednu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebből a %lld fotóból tarts meg egyet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu eina mynd til að geyma úr hópi með %lld myndum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva una foto da questo gruppo di %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚の中から1枚を残します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iš šios grupės pasirink vieną nuotrauką pasilikti. Iš viso: %lld."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlies vienu attēlu, ko paturēt. Grupā kopā: %lld."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel ritratt wieħed biex iżżomm minn dan il-grupp ta’ %lld."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold ett bilde fra denne gruppen på %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar één foto uit deze groep van %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj jedno zdjęcie z grupy liczącej %lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém uma fotografia deste grupo de %lld."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează o poză din acest grup de %lld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet fotiek v skupine: %lld. Jednu si nechajte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Število fotografij v skupini: %lld. Eno obdržite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll ett foto från gruppen på %lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเก็บหนึ่งรูปจากกลุ่มนี้ที่มี %lld รูป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một tấm để giữ trong nhóm %lld ảnh này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從這 %lld 張照片中留下一張。"
          }
        }
      }
    },
    "사진 %lld장에 접근할 수 없어요. 접근 범위를 바꾸거나 다른 사진에서 추천을 찾을 수 있어요. 이전 선택과 기록은 남아 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장에 접근할 수 없어요. 접근 범위를 바꾸거나 다른 사진에서 추천을 찾을 수 있어요. 이전 선택과 기록은 남아 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos we can’t access: %lld. Change photo access or look for other suggestions. Your selection and notes are saved."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостъпни снимки: %lld. Промени достъпа или потърси други предложения. Изборът и бележките са запазени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupné fotky: %lld. Změňte přístup nebo vyhledejte jiné návrhy. Výběr i poznámky zůstanou zachované."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos uden adgang: %lld. Skift adgangen, eller søg efter andre forslag. Dit valg og dine noter bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf %lld Fotos. Ändere die Zugriffsrechte oder suche nach anderen Vorschlägen. Auswahl und Notizen bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη προσβάσιμες φωτογραφίες: %lld. Άλλαξε την πρόσβαση ή αναζήτησε άλλες προτάσεις. Η επιλογή και οι σημειώσεις σου διατηρούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos sin acceso: %lld. Cambia los permisos o busca otras sugerencias. Tu selección y tus notas se conservarán."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligipääsmatuid fotosid: %lld. Muuda fotoluba või otsi teisi soovitusi. Valik ja märkmed on alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvia, joihin ei ole pääsyä: %lld. Muuta käyttöoikeutta tai etsi muita ehdotuksia. Valintasi ja muistiinpanosi säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos inaccessibles : %lld. Modifiez l’accès ou cherchez d’autres suggestions. Votre sélection et vos notes sont conservées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Grianghraif nach féidir a oscailt: %lld. Athraigh an rochtain nó cuardaigh moltaí eile. Tá do rogha agus do nótaí sábháilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupne fotografije: %lld. Promijenite pristup ili potražite druge prijedloge. Odabir i bilješke su spremljeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem elérhető fotók: %lld. Módosítsd a hozzáférést, vagy keress más javaslatokat. A kijelölés és a jegyzetek megmaradnak."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Óaðgengilegar myndir: %lld. Breyttu aðgangi eða leitaðu að fleiri tillögum. Valið og minnispunktarnir eru vistuð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto non accessibili: %lld. Modifica i permessi o cerca altri suggerimenti. La selezione e le note vengono conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚の写真にアクセスできません。アクセス範囲を変えるか、別の写真から探せます。これまでの選択やメモは残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepasiekiamų nuotraukų: %lld. Pakeisk prieigą arba ieškok kitų pasiūlymų. Pasirinkimas ir užrašai išsaugoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepieejamo attēlu skaits: %lld. Maini piekļuvi vai meklē citus ieteikumus. Atlase un piezīmes ir saglabātas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti mhux aċċessibbli: %lld. Ibdel l-aċċess jew fittex suġġerimenti oħra. L-għażla u n-noti tiegħek huma salvati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder uten tilgang: %lld. Endre tilgangen eller se etter andre forslag. Valget og notatene dine beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s zonder toegang: %lld. Wijzig de toegang of zoek naar andere suggesties. Je selectie en notities blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne zdjęcia: %lld. Zmień dostęp lub poszukaj innych propozycji. Wybór i notatki są zachowane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias inacessíveis: %lld. Altera o acesso ou procura outras sugestões. A seleção e as notas mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poze inaccesibile: %lld. Schimbă accesul sau caută alte sugestii. Selecția și notițele rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupné fotky: %lld. Zmeňte prístup alebo hľadajte iné návrhy. Výber aj poznámky zostanú zachované."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostopne fotografije: %lld. Spremenite dostop ali poiščite druge predloge. Izbor in beležke so ohranjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Foton utan åtkomst: %lld. Ändra åtkomsten eller sök efter andra förslag. Ditt val och dina anteckningar finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงรูปไม่ได้ %lld รูป เปลี่ยนสิทธิ์หรือดูคำแนะนำอื่น ตัวเลือกและบันทึกยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không truy cập được %lld ảnh. Hãy đổi quyền truy cập hoặc xem gợi ý khác. Các lựa chọn và ghi chú vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 張照片無法取用。你可以變更權限，或從其他照片尋找建議。先前的選取和筆記都會保留。"
          }
        }
      }
    },
