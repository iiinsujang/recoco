    "권한이 설정되지 않았어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 설정되지 않았어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven’t chosen a photo access setting yet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още не си избрал настройка за достъп до снимките."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsah přístupu k fotkám ještě není nastavený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har endnu ikke valgt, hvilke fotos Recoco må se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch keinen Fotozugriff festgelegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχεις επιλέξει ακόμη επίπεδο πρόσβασης στις φωτογραφίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has elegido el nivel de acceso a las fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa ei ole veel fotode juurdepääsu määranud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä valinnut kuvien käyttöoikeutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas encore choisi le niveau d’accès aux photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor roghnaigh tú socrú rochtana ar ghrianghraif fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još niste odabrali razinu pristupa fotografijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem állítottad be a fotóhozzáférést."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur ekki enn valið aðgang að myndum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora scelto il livello di accesso alle foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセス範囲はまだ設定されていません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar nepasirinkai prieigos prie nuotraukų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vēl neesi iestatījis piekļuvi fotoattēliem."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadek ma għażiltx setting tal-aċċess għar-ritratti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke valgt hvilke bilder Recoco kan se ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog niet gekozen welke foto’s Recoco mag bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano jeszcze zakresu dostępu do zdjęć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não escolheste o nível de acesso às fotografias."
          }
        },
        "ro": {
