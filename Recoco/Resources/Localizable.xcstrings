    "인터넷에 연결한 뒤 ‘iCloud에서 사진 불러오기’를 누르면 원본을 받아 다시 확인해요. 사진 앱에서 따로 찾지 않아도 돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에 연결한 뒤 ‘iCloud에서 사진 불러오기’를 누르면 원본을 받아 다시 확인해요. 사진 앱에서 따로 찾지 않아도 돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet, then tap “Load photos from iCloud” to check the originals. No need to find them in Photos."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържи се с интернет и натисни „Зареди от iCloud“, за да провериш оригиналите. Няма нужда да ги търсиш в „Снимки“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se k internetu a načtěte originály z iCloudu. Nemusíte je hledat ve Fotkách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til internettet, og tryk på »Hent fotos fra iCloud«. Du behøver ikke finde originalerne i Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle eine Internetverbindung her und tippe auf „Fotos aus iCloud laden“. Recoco prüft die Originale, ohne dass du sie in Fotos suchen musst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέσου στο διαδίκτυο και πάτησε «Φόρτωση από iCloud» για έλεγχο των πρωτοτύπων. Δεν χρειάζεται να τα αναζητήσεις στις Φωτογραφίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet y toca «Cargar fotos de iCloud». Se comprobarán los originales sin que tengas que buscarlos en Fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendu internetiga ja vali „Laadi fotod iCloudist“, et kontrollida originaale. Neid ei pea rakendusest Fotod ise otsima."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muodosta internetyhteys ja valitse ”Lataa kuvat iCloudista”. Alkuperäisiä ei tarvitse etsiä Kuvat-apista erikseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Internet et touchez « Charger depuis iCloud ». Les originaux seront vérifiés sans que vous ayez à les chercher dans Photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceangail leis an idirlíon agus tapáil “Luchtaigh grianghraif ó iCloud” chun na bunchóipeanna a sheiceáil. Ní gá iad a lorg in Grianghraif."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite se s internetom pa učitajte izvornike s iClouda. Ne morate ih tražiti u aplikaciji Foto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolódj az internethez, majd válaszd a „Betöltés az iCloudból” lehetőséget az eredetik ellenőrzéséhez. Nem kell megkeresned őket a Fotókban."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengstu netinu og ýttu á „Sækja myndir úr iCloud“ til að athuga frumritin. Þú þarft ekki að finna þau í Myndum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet e tocca “Carica foto da iCloud”. Gli originali verranno controllati senza doverli cercare in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続して「iCloudから写真を読み込む」をタップすると、原本を取得して確認します。写真アプリで探し直す必要はありません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunk prie interneto ir bakstelėk „Įkelti iš iCloud“, kad patikrintum originalus. Jų nereikia ieškoti nuotraukų programoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveido savienojumu ar internetu un spied “Ielādēt no iCloud”, lai pārbaudītu oriģinālus. Tie nav jāmeklē lietotnē Fotoattēli."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qabbad mal-internet u agħfas “Tella’ r-ritratti minn iCloud” biex tiċċekkja l-oriġinali. M’għandekx għalfejn tfittixhom f’Ritratti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til internett og trykk på «Last ned bilder fra iCloud». Du trenger ikke finne originalene i Bilder selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met internet en tik op ‘Foto’s downloaden uit iCloud’. Je hoeft de originelen niet zelf op te zoeken in Foto’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z internetem i wybierz pobieranie z iCloud, aby sprawdzić oryginały. Nie trzeba ich szukać w Zdjęciach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga-te à internet e toca em «Carregar do iCloud» para verificar os originais. Não precisas de os procurar na app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la internet și atinge „Încarcă din iCloud” pentru a verifica originalele. Nu trebuie să le cauți în Poze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte sa na internet a načítajte originály z iCloudu. Nemusíte ich hľadať vo Fotkách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite se z internetom in naložite izvirnike iz iClouda. Ni jih treba iskati v aplikaciji Fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till internet och tryck på ”Hämta foton från iCloud”. Du behöver inte leta upp originalen i Bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่ออินเทอร์เน็ตแล้วแตะ “โหลดรูปจาก iCloud” เพื่อตรวจสอบต้นฉบับ ไม่ต้องไปค้นหาเองในแอปรูปภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết nối mạng rồi chạm “Tải ảnh từ iCloud” để kiểm tra bản gốc. Bạn không cần tự tìm trong ứng dụng Ảnh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連上網路後，點「從 iCloud 載入照片」來取得原始照片並重新檢查。你不必到「照片」裡另外尋找。"
          }
        }
      }
    },
    "일부 사진에 접근할 수 없어요.": {
