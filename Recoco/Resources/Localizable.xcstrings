        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du valde %@ för att titta på fotot igen. Behåll det om du fortfarande behöver det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเลือกกลับมาดูรูปนี้เมื่อ %@ หากยังต้องการก็เก็บไว้ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã hẹn xem lại ảnh này vào %@. Nếu vẫn cần, cứ giữ lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選擇在%@再次查看。還需要的話，就把它留下。"
          }
        }
      }
