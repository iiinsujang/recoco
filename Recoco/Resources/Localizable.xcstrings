    "잠깐, 사진을 살펴볼까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐, 사진을 살펴볼까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a moment to look through your photos?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имаш ли минутка да разгледаш снимките си?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte chvilku projít si fotky?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du et øjeblik til at kigge på dine fotos?"
