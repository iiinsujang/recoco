    "남기고 싶은 사진은\n그대로 두세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남기고 싶은 사진은\n그대로 두세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the photos\nthat matter to you."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запази снимките,\nкоито са важни за теб."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte si fotky,\nna kterých vám záleží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold de billeder,\nder betyder noget for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte die Fotos,\ndie dir etwas bedeuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε τις φωτογραφίες\nπου έχουν σημασία για σένα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva las fotos\nque más te importan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäta alles fotod,\nmis on sulle tähtsad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä kuvat,\njotka ovat sinulle tärkeitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les photos\nqui comptent pour vous."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Coinnigh na grianghraif\nis ansa leat."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite fotografije\nkoje su vam važne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Őrizd meg a neked\nfontos fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymdu myndirnar\nsem skipta þig máli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva le foto\na cui tieni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な写真は、\n手元に残そう。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasilik nuotraukas,\nkurios tau svarbios."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paturi attēlus,\nkas tev ir svarīgi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm ir-ritratti\nli jgħoddu għalik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold bildene\nsom betyr noe for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de foto’s\ndie je dierbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj zdjęcia,\nktóre są dla Ciebie ważne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as fotografias\nque são importantes para ti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează pozele\ncare contează pentru tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte si fotky,\nna ktorých vám záleží."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obdržite fotografije,\nki vam veliko pomenijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll de bilder\nsom betyder något för dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปไหนที่อยากเก็บ\nก็เก็บไว้ได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứ giữ lại những tấm\nbạn muốn giữ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把珍惜的照片，\n好好留下來。"
          }
        }
      }
    },
