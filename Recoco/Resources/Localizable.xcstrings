        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν άνοιξε η σύνδεση. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el inicio de sesión. Inténtalo de nuevo en unos instantes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisselogimisvaadet ei saanud avada. Proovi veidi hiljem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumista ei voitu avata. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir la connexion. Réessayez dans un instant."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir síniú isteach a oscailt. Bain triail eile as ar ball."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće otvoriti prijavu. Pokušajte ponovno za koji trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült megnyitni a bejelentkezést. Próbáld újra kis idő múlva."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að opna innskráningu. Reyndu aftur eftir smástund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire l’accesso. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン画面を開けませんでした。しばらくしてから、もう一度お試しください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko atverti prisijungimo lango. Bandyk po kurio laiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās atvērt pierakstīšanos. Pēc brīža mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex niftħu l-paġna tad-dħul. Erġa’ pprova dalwaqt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innloggingen kunne ikke åpnes. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen kon niet worden geopend. Probeer het over een ogenblik opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć logowania. Spróbuj ponownie za chwilę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o início de sessão. Tenta novamente dentro de instantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut deschide autentificarea. Încearcă din nou în curând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie sa nepodarilo otvoriť. Skúste to o chvíľu znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijave ni bilo mogoče odpreti. Čez trenutek poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen kunde inte öppnas. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าลงชื่อเข้าไม่ได้ โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được màn hình đăng nhập. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟登入畫面，請稍候再試。"
          }
        }
      }
    },
