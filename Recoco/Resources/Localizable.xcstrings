    "아직 정리할 사진을 찾지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 정리할 사진을 찾지 못했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We haven’t found photos to tidy up yet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още не открихме снимки за разчистване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím jsme nenašli fotky k pročištění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har ikke fundet fotos at rydde op i endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben noch keine Fotos zum Aufräumen gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρήκαμε ακόμα φωτογραφίες για ξεκαθάρισμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no encontramos fotos para hacer limpieza."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Me pole veel leidnud fotosid, mida korrastada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme ole vielä löytäneet kuvia siivottavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas encore trouvé de photos à trier."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor aimsíomar grianghraif le glanadh fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nismo pronašli fotografije za pospremanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem találtunk rendszerezhető fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við höfum ekki fundið myndir til að taka til í enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo ancora trovato foto da riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理する写真はまだ見つかっていません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar neradome nuotraukų, kurias būtų galima sutvarkyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl neesam atraduši fotoattēlus sakārtošanai."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadna ma sibniex ritratti biex tirranġa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har ikke funnet bilder å rydde i ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben nog geen foto’s gevonden om op te ruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie znaleźliśmy zdjęć do uporządkowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não encontrámos fotografias para organizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu am găsit fotografii de organizat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ sme nenašli fotky na pretriedenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografij za urejanje še nismo našli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har inte hittat foton att rensa bland ännu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่พบรูปภาพที่แนะนำให้จัดระเบียบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tìm thấy ảnh để dọn dẹp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒找到適合整理的照片。"
          }
        }
      }
    },
    "아직 사진을 모두 살펴보지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 사진을 모두 살펴보지 못했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We haven’t checked all your photos yet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още не сме прегледали всички снимки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ještě jsme neprošli všechny fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har ikke gennemgået alle dine fotos endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben noch nicht alle Fotos geprüft."
