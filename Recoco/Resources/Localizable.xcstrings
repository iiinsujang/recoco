            "state": "translated",
            "value": "Não foi possível iniciar sessão. Tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea a eșuat. Încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie zlyhalo. Skúste to znova."
