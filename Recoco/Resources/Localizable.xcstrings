    "기록을 저장하지 못했어요. 작성한 글은 화면에 그대로 있어요. 다시 저장해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 저장하지 못했어요. 작성한 글은 화면에 그대로 있어요. 다시 저장해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save your note. Your text is still here. Try saving again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележката не беше запазена. Текстът е тук. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku se nepodařilo uložit. Váš text je stále zde. Zkuste uložení znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noten kunne ikke gemmes. Teksten er her stadig. Prøv at gemme igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz konnte nicht gespeichert werden. Dein Text ist noch da. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημείωση δεν αποθηκεύτηκε. Το κείμενό σου είναι ακόμη εδώ. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la nota. Tu texto sigue aquí. Intenta guardarla de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märget ei saanud salvestada. Tekst on alles. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanoa ei voitu tallentaa. Tekstisi on yhä tässä. Yritä tallentaa uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la note. Votre texte est conservé. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor sábháladh an nóta. Tá an téacs fós anseo. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješka nije spremljena. Tekst je i dalje ovdje. Pokušajte ga ponovno spremiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült menteni a jegyzetet. A szöveged megvan. Próbáld meg újra menteni."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vista minnispunktinn. Textinn er enn hér. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la nota. Il tuo testo è ancora qui. Prova a salvarla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを保存できませんでした。文章は残っています。もう一度保存してください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko išsaugoti užrašo. Tekstas liko. Bandyk išsaugoti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmi neizdevās saglabāt. Teksts ir saglabājies. Mēģini vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-nota ma ġietx salvata. It-test għadu hawn. Erġa’ pprova ssalva."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatet kunne ikke lagres. Teksten er fortsatt her. Prøv å lagre igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notitie kon niet worden bewaard. De tekst staat er nog. Probeer opnieuw op te slaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać notatki. Tekst jest nadal tutaj. Spróbuj zapisać go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a nota. O texto continua aqui. Tenta guardar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița nu a putut fi salvată. Textul a rămas aici. Încearcă să salvezi din nou."
