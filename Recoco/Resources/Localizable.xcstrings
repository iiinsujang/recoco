    "30초 안에 촬영된 두 사진의 이미지가 비슷해요. 표정·작은 글자까지 같다는 뜻은 아니니 비교해서 골라주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30초 안에 촬영된 두 사진의 이미지가 비슷해요. 표정·작은 글자까지 같다는 뜻은 아니니 비교해서 골라주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These photos look similar and were taken within 30 seconds. Compare expressions and small details before choosing."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадрите си приличат и са заснети в рамките на 30 секунди. Сравни израженията и детайлите, преди да избереш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky jsou podobné a vznikly v rozmezí 30 sekund. Před výběrem porovnejte výrazy a drobné detaily."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse fotos ligner hinanden og er taget inden for 30 sekunder. Sammenlign ansigtsudtryk og små detaljer, før du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ähnlichen Fotos entstanden innerhalb von 30 Sekunden. Vergleiche Gesichtsausdrücke und kleine Details, bevor du dich entscheidest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δύο παρόμοιες φωτογραφίες τραβήχτηκαν με διαφορά έως 30 δευτερολέπτων. Σύγκρινε τις εκφράσεις και τις μικρές λεπτομέρειες πριν επιλέξεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fotos se parecen y se tomaron con menos de 30 segundos de diferencia. Compara las expresiones y los pequeños detalles antes de elegir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotod on sarnased ja tehtud kuni 30-sekundilise vahega. Enne valimist võrdle näoilmeid ja pisiasju."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat näyttävät samankaltaisilta ja ne otettiin 30 sekunnin sisällä. Vertaa ilmeitä ja pieniä yksityiskohtia ennen valintaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces photos similaires ont été prises à moins de 30 secondes d’intervalle. Comparez les expressions et les petits détails avant de choisir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá cuma chosúil orthu agus tógadh iad laistigh de 30 soicind. Cuir dreacha agus mionsonraí i gcomparáid sula roghnóidh tú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije su slične i snimljene unutar 30 sekundi. Usporedite izraze lica i sitne pojedinosti prije odabira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A két hasonló fotó 30 másodpercen belül készült. Választás előtt hasonlítsd össze az arckifejezéseket és az apró részleteket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndirnar eru svipaðar og voru teknar með innan við 30 sekúndna millibili. Berðu saman svipbrigði og smáatriði áður en þú velur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste foto simili sono state scattate a distanza di non più di 30 secondi. Confronta le espressioni e i piccoli dettagli prima di scegliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30秒以内に撮った2枚がよく似ています。表情や小さな文字まで同じとは限らないので、見比べて選んでください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukos panašios ir padarytos ne didesniu kaip 30 sekundžių skirtumu. Prieš rinkdamasis palygink veidų išraiškas ir smulkias detales."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēli ir līdzīgi un uzņemti ne vairāk kā ar 30 sekunžu starpību. Pirms izvēles salīdzini sejas izteiksmes un nianses."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-ritratti jixxiebhu u ttieħdu fi żmien 30 sekonda minn xulxin. Qabbel l-espressjonijiet u d-dettalji żgħar qabel tagħżel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene ligner og ble tatt innen 30 sekunder. Sammenlign ansiktsuttrykk og små detaljer før du velger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto’s lijken op elkaar en zijn binnen 30 seconden gemaakt. Vergelijk gezichtsuitdrukkingen en kleine details voordat je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te zdjęcia są podobne i powstały w odstępie do 30 sekund. Przed wyborem porównaj mimikę i drobne szczegóły."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas fotografias são parecidas e foram tiradas num intervalo de 30 segundos. Compara as expressões e os pequenos pormenores antes de escolher."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele două poze seamănă și au fost făcute la cel mult 30 de secunde distanță. Compară expresiile și micile detalii înainte de a alege."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky sú podobné a vznikli v priebehu 30 sekúnd. Pred výberom porovnajte výrazy a drobné detaily."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiji sta podobni in posneti v razmiku največ 30 sekund. Pred izbiro primerjajte izraze in podrobnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotona liknar varandra och togs inom 30 sekunder. Jämför ansiktsuttryck och små detaljer innan du väljer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปเหล่านี้ดูคล้ายกันและถ่ายห่างกันไม่เกิน 30 วินาที ลองเทียบสีหน้าและรายละเอียดก่อนเลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ảnh trông giống nhau và được chụp cách nhau không quá 30 giây. Hãy so biểu cảm và chi tiết nhỏ trước khi chọn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這兩張照片相隔不到 30 秒，看起來很相似。表情或小字可能不同，請比較後再決定。"
          }
        }
      }
    },
