        }
      }
    },
    "아직 살펴보지 않은 사진에서 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 살펴보지 않은 사진에서 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll look through photos you haven’t reviewed yet."
