    "선택 상태는 유지돼요. 사진을 다시 확인한 뒤 비우기를 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 상태는 유지돼요. 사진을 다시 확인한 뒤 비우기를 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection is saved. Check the photos, then try deleting again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изборът е запазен. Провери снимките и опитай да ги изтриеш отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výběr je uložený. Zkontrolujte fotky a zopakujte smazání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valg er gemt. Tjek dine fotos, og prøv derefter at slette dem igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl ist gespeichert. Prüfe die Fotos und versuche erneut, sie zu löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή διατηρήθηκε. Έλεγξε τις φωτογραφίες και δοκίμασε ξανά να τις διαγράψεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu selección está guardada. Comprueba las fotos antes de intentar borrarlas de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valik on salvestatud. Kontrolli fotosid ja proovi uuesti kustutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintasi on tallessa. Tarkista kuvat ja yritä poistamista uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sélection est conservée. Vérifiez les photos avant de réessayer de les supprimer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá do rogha sábháilte. Seiceáil na grianghraif agus déan iarracht iad a scriosadh arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabir je sačuvan. Provjerite fotografije i pokušajte ponovno izbrisati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölés megmaradt. Ellenőrizd a fotókat, majd próbáld meg újra a törlést."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valið þitt er vistað. Athugaðu myndirnar og reyndu að eyða þeim aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione è salvata. Ricontrolla le foto prima di riprovare a eliminarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択はそのままです。写真を確認してから、もう一度削除してください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkimas išsaugotas. Patikrink nuotraukas ir bandyk ištrinti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlase saglabāta. Pārbaudi attēlus un mēģini dzēst vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-għażla hija salvata. Iċċekkja r-ritratti u erġa’ pprova tħassarhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valget ditt er beholdt. Sjekk bildene og prøv deretter å slette igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je selectie is bewaard. Controleer de foto’s en probeer ze daarna te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór jest zachowany. Sprawdź zdjęcia i spróbuj ponownie je usunąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção está guardada. Verifica as fotografias e tenta apagá-las de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecția este păstrată. Verifică pozele și încearcă să le ștergi din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výber je uložený. Skontrolujte fotky a skúste ich znova vymazať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbor je ohranjen. Preverite fotografije in znova poskusite z brisanjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt val finns kvar. Kontrollera fotona och försök sedan radera dem igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บตัวเลือกของคุณไว้แล้ว ตรวจสอบรูปแล้วลองลบอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lựa chọn của bạn đã được lưu. Hãy kiểm tra ảnh rồi thử xóa lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取狀態已保留。請先檢查照片，再試著刪除。"
          }
        }
      }
    },
    "선택 상태와 남긴 기록은 유지돼요. 사진을 비운 것으로 처리하지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 상태와 남긴 기록은 유지돼요. 사진을 비운 것으로 처리하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection and notes are saved. Nothing is counted as deleted."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изборът и бележките ти са запазени. Нито една снимка не е отчетена като изтрита."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výběr a poznámky zůstávají uložené. Žádná fotka se nezapočítala jako smazaná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valg og dine noter er gemt. Intet er talt som slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl und deine Notizen bleiben erhalten. Es wird nichts als gelöscht gezählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή και οι σημειώσεις διατηρούνται. Καμία φωτογραφία δεν καταγράφεται ως διαγραμμένη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservarán tu selección y tus notas. No se contará ninguna foto como borrada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu valik ja märkmed on salvestatud. Ühtegi fotot ei loetud kustutatuks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintasi ja muistiinpanosi ovat tallessa. Mitään ei lasketa poistetuksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sélection et vos notes sont conservées. Aucune photo n’est comptée comme supprimée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá do rogha agus do nótaí sábháilte. Níor comhaireadh aon ghrianghraf mar cheann scriosta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabir i bilješke su spremljeni. Nijedna fotografija nije uračunata kao izbrisana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölés és a jegyzetek megmaradnak. Ez nem számít törlésnek."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valið og minnispunktarnir eru vistuð. Engin mynd telst hafa verið eydd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione e le note vengono conservate. Nessuna foto viene conteggiata come eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択やメモは残ります。写真を削除した数には含まれません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkimas ir užrašai išsaugoti. Nė viena nuotrauka nepriskaičiuota kaip ištrinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlase un piezīmes ir saglabātas. Neviens attēls nav ieskaitīts kā dzēsts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-għażla u n-noti huma salvati. Xejn ma ngħadd bħala mħassar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valget og notatene dine er lagret. Ingenting er regnet som slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je selectie en notities zijn bewaard. Er is niets als verwijderd geteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór i notatki są zachowane. Żadnego zdjęcia nie zaliczono jako usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção e as notas são mantidas. Nenhuma fotografia é contada como apagada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecția și notițele rămân. Nicio poză nu este numărată ca ștearsă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výber a poznámky zostávajú uložené. Žiadna fotka sa nezapočítala ako vymazaná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbor in beležke so ohranjeni. Nobena fotografija ni štela kot izbrisana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt val och dina anteckningar finns kvar. Inget har räknats som raderat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บตัวเลือกและบันทึกของคุณไว้แล้ว ยังไม่นับว่าลบรูป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lựa chọn và ghi chú của bạn đã được lưu. Chưa có ảnh nào được tính là đã xóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取狀態和筆記都會保留，不會計入已刪除的照片。"
          }
        }
      }
    },
