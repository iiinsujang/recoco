    "iPhone 설정에서 알림을 허용한 뒤 다시 켜주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 설정에서 알림을 허용한 뒤 다시 켜주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications in iPhone Settings, then turn them on here."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши известията в Настройки на iPhone, след което ги включи отново тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte oznámení v nastavení iPhonu a poté je zapněte zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad notifikationer i iPhones indstillinger, og slå dem derefter til her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen in den iPhone-Einstellungen und schalte sie dann hier ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε τις γνωστοποιήσεις στις Ρυθμίσεις του iPhone και μετά ενεργοποίησέ τες εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones en los ajustes del iPhone y actívalas aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba märguanded iPhone’i seadetes ja lülita need siin uuesti sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli ilmoitukset iPhonen asetuksissa ja kytke ne sitten päälle täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications dans les réglages de l’iPhone, puis activez-les ici."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh fógraí i Socruithe an iPhone, ansin cuir ar siúl anseo iad."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite obavijesti u postavkama iPhonea pa ih ovdje uključite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd az értesítéseket az iPhone Beállításaiban, majd kapcsold be itt is."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu tilkynningar í Stillingum iPhone og kveiktu síðan á þeim hér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche nelle impostazioni di iPhone, poi attivale qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの設定で通知を許可してから、ここでオンにしてください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk pranešimus „iPhone“ nuostatose ir įjunk juos čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj paziņojumus iPhone iestatījumos un pēc tam ieslēdz tos šeit."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ħalli n-notifiki fis-Settings tal-iPhone u mbagħad ixgħelhom hawn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat varslinger i iPhone-innstillingene, og slå dem deretter på her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen toe in de instellingen van je iPhone en schakel ze hier in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia w Ustawieniach iPhone'a, a potem włącz je tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite notificações nas Definições do iPhone e ativa-as aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite notificările în Configurări pe iPhone, apoi activează-le aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte hlásenia v nastaveniach iPhonu a potom ich zapnite tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite obvestila v nastavitvah iPhona in jih nato vklopite tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt notiser i iPhone-inställningarna och slå sedan på dem här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการแจ้งเตือนในการตั้งค่า iPhone แล้วกลับมาเปิดการเตือนที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép thông báo trong Cài đặt của iPhone, rồi quay lại bật lời nhắc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 iPhone 的「設定」中允許通知，再回到這裡開啟。"
          }
        }
      }
    },
