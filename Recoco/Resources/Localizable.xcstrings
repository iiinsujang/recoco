    "마음이 바뀌었다면 · 복구 방법": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음이 바뀌었다면 · 복구 방법"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed your mind? How to recover a photo"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Размисли? Как да възстановиш снимка"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak fotku obnovit, pokud si to rozmyslíte"
