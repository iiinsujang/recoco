    "미리보기에서 수정한 글은 그대로예요. 이어서 다듬을 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 수정한 글은 그대로예요. 이어서 다듬을 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your edits are still here. Pick up where you left off."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените ти са тук. Продължи оттам, докъдето стигна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úpravy z náhledu zůstaly zachované. Můžete pokračovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine ændringer er bevaret. Fortsæt, hvor du slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen sind noch da. Du kannst weiterschreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές σου είναι ακόμη εδώ. Συνέχισε από εκεί που σταμάτησες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios siguen aquí. Puedes seguir escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu muudatused on alles. Jätka sealt, kus pooleli jäid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutoksesi ovat tallessa. Voit jatkaa siitä, mihin jäit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications sont conservées. Reprenez là où vous en étiez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá do chuid athruithe fós anseo. Lean ort ón áit ar stop tú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše izmjene iz pregleda su sačuvane. Možete nastaviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosításaid megvannak. Folytathatod, ahol abbahagytad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Breytingarnar þínar eru hér enn. Haltu áfram þar sem frá var horfið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche sono ancora qui. Riprendi da dove avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューで編集した文章はそのままです。続きを書けます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavo pakeitimai liko. Gali tęsti nuo ten, kur sustojai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Labojumi ir saglabājušies. Turpini rakstīt no iepriekšējās vietas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-bidliet tiegħek għadhom hawn. Kompli minn fejn ħallejt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringene dine er beholdt. Fortsett der du slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wijzigingen zijn behouden. Ga verder waar je was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zmiany w podglądzie są zachowane. Możesz dalej pisać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações continuam aqui. Podes continuar de onde ficaste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările sunt încă aici. Poți continua de unde ai rămas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úpravy z náhľadu zostali zachované. Môžete pokračovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši popravki iz predogleda so ohranjeni. Lahko nadaljujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina ändringar finns kvar. Fortsätt där du slutade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่แก้ไขยังอยู่ เขียนต่อจากเดิมได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đã sửa vẫn còn đây. Bạn có thể viết tiếp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽時編輯的文字還在，可以繼續修改。"
          }
        }
      }
    },
