          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Me pole veel kõiki fotosid läbi vaadanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme ole vielä käyneet läpi kaikkia kuviasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas encore examiné toutes vos photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
