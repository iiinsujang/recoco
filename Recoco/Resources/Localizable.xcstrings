    "연결이 어려워 작성한 글을 그대로 준비했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 어려워 작성한 글을 그대로 준비했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect. Your own words are ready to use."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма връзка. Можеш да използваш своя текст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení se nezdařilo. Můžete použít vlastní text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen lykkedes ikke. Din egen tekst er klar til brug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Du kannst deinen eigenen Text verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η σύνδεση. Μπορείς να χρησιμοποιήσεις το δικό σου κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar. Puedes usar el texto que has escrito."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendust ei saadud. Saad kasutada enda kirjutatud teksti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyttä ei saatu. Voit jatkaa omalla tekstilläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Vous pouvez utiliser votre propre texte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir ceangal. Is féidir leat do chuid focal féin a úsáid."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje nije uspjelo. Vaš je tekst spreman za uporabu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült kapcsolódni. A saját szövegedet használhatod."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenging mistókst. Þú getur notað þína eigin texta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione non riuscita. Puoi usare il testo che hai scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できませんでした。入力した文章はそのまま使えます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko prisijungti prie tinklo. Gali naudoti savo tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās izveidot savienojumu. Vari izmantot savu tekstu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex nikkonnettjaw. Tista’ tuża l-kliem li ktibt int."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke koble til. Din egen tekst er klar til bruk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden is niet gelukt. Je kunt verder met je eigen tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia. Możesz użyć tekstu w swojej wersji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível estabelecer ligação. Podes usar o texto que escreveste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea a eșuat. Poți folosi textul scris de tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie zlyhalo. Môžete použiť vlastný text."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezava ni uspela. Uporabite lahko svoje besedilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att ansluta. Din egen text är redo att användas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อไม่ได้ ใช้ข้อความที่เขียนเองได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể kết nối. Bạn vẫn có thể dùng nội dung đã viết."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線。你仍可使用自己寫下的文字。"
          }
        }
      }
    },
