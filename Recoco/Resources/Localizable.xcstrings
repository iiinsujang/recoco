    "사진 미리보기를 보관하지 못했어요. 다시 시도하거나 글만 저장할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 미리보기를 보관하지 못했어요. 다시 시도하거나 글만 저장할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the photo preview. Try again or save the text only."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледът на снимката не беше запазен. Опитай отново или запази само текста."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhled fotky se nepodařilo uložit. Zkuste to znovu nebo uložte jen text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lille eksempelbillede kunne ikke gemmes. Prøv igen, eller gem kun teksten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotovorschau konnte nicht gespeichert werden. Versuche es erneut oder speichere nur den Text."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προεπισκόπηση δεν αποθηκεύτηκε. Δοκίμασε ξανά ή αποθήκευσε μόνο το κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la vista previa de la foto. Reintenta o guarda solo el texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto eelvaadet ei saanud salvestada. Proovi uuesti või salvesta ainult tekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvan esikatselua ei voitu tallentaa. Yritä uudelleen tai tallenna pelkkä teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer l’aperçu de la photo. Réessayez ou enregistrez uniquement le texte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor sábháladh an réamhamharc. Bain triail eile as nó sábháil an téacs amháin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregled fotografije nije spremljen. Pokušajte ponovno ili spremite samo tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó előnézetét nem sikerült menteni. Próbáld újra, vagy mentsd csak a szöveget."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vista forskoðun myndar. Reyndu aftur eða vistaðu eingöngu textann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’anteprima della foto. Riprova oppure salva solo il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のプレビューを保存できませんでした。やり直すか、文章だけを保存できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko išsaugoti nuotraukos peržiūros. Bandyk dar kartą arba išsaugok tik tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēla priekšskatījumu neizdevās saglabāt. Mēģini vēlreiz vai saglabā tikai tekstu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex insalvaw il-previżjoni tar-ritratt. Erġa’ pprova jew salva t-test biss."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisningen av bildet kunne ikke lagres. Prøv igjen, eller lagre bare teksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het fotovoorbeeld kon niet worden bewaard. Probeer het opnieuw of bewaar alleen de tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać podglądu zdjęcia. Spróbuj ponownie lub zapisz sam tekst."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a pré-visualização da fotografia. Tenta novamente ou guarda apenas o texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Previzualizarea pozei nu a putut fi salvată. Reîncearcă sau salvează doar textul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhľad fotky sa nepodarilo uložiť. Skúste to znova alebo uložte iba text."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predogleda fotografije ni bilo mogoče shraniti. Poskusite znova ali shranite le besedilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsvisningen av fotot kunde inte sparas. Försök igen eller spara enbart texten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรูปตัวอย่างไม่ได้ ลองอีกครั้งหรือบันทึกเฉพาะข้อความ"
