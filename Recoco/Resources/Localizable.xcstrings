    "데이터가 사용될 수 있어요. 원본은 리코코 서버로 보내지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 사용될 수 있어요. 원본은 리코코 서버로 보내지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may use mobile data. Your originals aren’t sent to Recoco."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Може да бъдат използвани мобилни данни. Оригиналите не се изпращат до Recoco."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Může dojít k využití mobilních dat. Originály se na servery Recoco neodesílají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan bruge mobildata. Originalerne sendes ikke til Recocos servere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei können mobile Daten verwendet werden. Deine Originale werden nicht an Recoco gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενδέχεται να χρησιμοποιηθούν δεδομένα κινητής. Τα πρωτότυπα δεν αποστέλλονται στο Recoco."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se usen datos móviles. Los originales no se envían a Recoco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See võib kasutada mobiilset andmesidet. Originaale ei saadeta Recocole."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä voi käyttää mobiilidataa. Alkuperäisiä kuvia ei lähetetä Recocon palvelimille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des données mobiles peuvent être utilisées. Les originaux ne sont pas envoyés à Recoco."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "D’fhéadfadh sé seo sonraí móibíleacha a úsáid. Ní sheoltar na bunchóipeanna chuig Recoco."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu se koristiti mobilni podaci. Izvornici se ne šalju na poslužitelje aplikacije Recoco."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez mobiladat-forgalommal járhat. Az eredeti fotóidat nem küldjük a Recoco szerverére."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta gæti notað farsímagögn. Frummyndirnar eru ekki sendar til Recoco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbero essere utilizzati dati mobili. Gli originali non vengono inviati a Recoco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信を使用する場合があります。原本をRecocoのサーバーに送ることはありません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gali būti naudojami mobilieji duomenys. Originalai „Recoco“ nesiunčiami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā var tikt izmantoti mobilie dati. Oriģināli netiek sūtīti Recoco."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan jista’ juża data mobbli. L-oriġinali ma jintbagħtux lil Recoco."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan bruke mobildata. Originalene sendes ikke til Recocos servere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan mobiele data verbruiken. De originelen worden niet naar Recoco gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może to wymagać użycia danych komórkowych. Oryginały nie są wysyłane na serwery Recoco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podem ser usados dados móveis. Os originais não são enviados para a Recoco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pot folosi date mobile. Originalele nu sunt trimise către Recoco."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžu sa použiť mobilné dáta. Originály sa neodosielajú na servery Recoco."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Morda bodo uporabljeni mobilni podatki. Izvirniki se ne pošiljajo v strežnike aplikacije Recoco."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobildata kan användas. Originalen skickas inte till Recocos servrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจใช้ข้อมูลมือถือ โดยไม่ส่งรูปต้นฉบับให้รีโคโค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị có thể dùng dữ liệu di động. Ảnh gốc không được gửi đến Recoco."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能會使用行動數據。原始照片不會傳送到 Recoco 的伺服器。"
