    "오늘은 제가\n최대 세 장 골라볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 제가\n최대 세 장 골라볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’ll pick up to three\nphotos for you today."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Днес ще подбера за теб\nдо три снимки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes pro vás vyberu\naž tři fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag vælger jeg op til\ntre billeder til dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute suche ich dir\nbis zu drei Fotos aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σήμερα σου προτείνω\nέως τρεις φωτογραφίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy te propongo\nhasta tres fotos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valin sulle täna\nkuni kolm fotot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsen tänään enintään\nkolme kuvaa katsottavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, je te propose\njusqu’à trois photos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
