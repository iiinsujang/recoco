    "알림 설정을 변경하지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 설정을 변경하지 못했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t change your notification settings."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройките за известия не бяха променени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení oznámení se nepodařilo změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine indstillinger for notifikationer kunne ikke ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungseinstellungen konnten nicht geändert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αλλαγή των ρυθμίσεων γνωστοποιήσεων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cambiar los ajustes de notificaciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märguannete seadeid ei saanud muuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusasetuksia ei voitu muuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier les réglages des notifications."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir socruithe na bhfógraí a athrú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće promijeniti postavke obavijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült módosítani az értesítési beállításokat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að breyta tilkynningastillingum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare le impostazioni delle notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知設定を変更できませんでした。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko pakeisti pranešimų nuostatų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās mainīt paziņojumu iestatījumus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma stajniex nibdlu s-settings tan-notifiki."
