    "화면에서 읽은 기한이 지났어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에서 읽은 기한이 지났어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date we found on screen has passed."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Датата, намерена на екрана, вече е минала."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lhůta uvedená na snímku už uplynula."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen på billedet er overskredet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das im Bild erkannte Datum ist verstrichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία που εντοπίσαμε στην οθόνη έχει περάσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha que aparece en pantalla ya ha pasado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekraanilt leitud kuupäev on möödunud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvassa näkyvä määräaika on päättynyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date repérée à l’écran est passée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an dáta a fuaireamar ar an scáileán imithe tharainn."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rok prikazan na slici već je prošao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyőn felismert dátum már elmúlt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagsetningin sem fannst á skjánum er liðin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data rilevata sullo schermo è passata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面から読み取った期限が過ぎています。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrano kopijoje rasta data jau praėjo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrānā redzamais datums ir pagājis."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Id-data li sibna fuq l-iskrin għaddiet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen som vises i bildet, har gått ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uiterste datum op de afbeelding is verstreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Termin widoczny na obrazie już minął."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data que lemos no ecrã já passou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data citită pe ecran a trecut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Termín uvedený na snímke už uplynul."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rok, prikazan na sliki, je potekel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sista datumet som syns i bilden har passerat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ที่พบบนภาพหน้าจอผ่านไปแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày tìm thấy trên ảnh chụp màn hình đã qua."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面上辨識到的期限已過。"
          }
        }
      }
    },
    "화면의 행사일·사용 기한을 %@로 읽었어요. 날짜가 맞는지, 아직 필요한지 확인해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 행사일·사용 기한을 %@로 읽었어요. 날짜가 맞는지, 아직 필요한지 확인해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We read the event or expiry date as %@. Check the date and whether you still need the screenshot."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разчетохме датата на събитието или крайния срок като %@. Провери датата и дали още ти трябва екранната снимка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznané datum události nebo platnosti: %@. Zkontrolujte datum a zvažte, zda snímek ještě potřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi læste %@ som datoen for begivenheden eller udløbsdatoen. Tjek datoen, og se, om du stadig har brug for skærmbilledet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben %@ als Veranstaltungs- oder Ablaufdatum gelesen. Prüfe, ob das Datum stimmt und ob du den Screenshot noch brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντοπίσαμε την ημερομηνία %@ ως ημερομηνία εκδήλωσης ή λήξης. Έλεγξε αν είναι σωστή και αν χρειάζεσαι το στιγμιότυπο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de evento o caducidad que hemos leído es %@. Comprueba que sea correcta y si aún necesitas la captura."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leidsime sündmuse või kehtivuse lõpukuupäevaks %@. Kontrolli kuupäeva ja seda, kas kuvatõmmist on veel vaja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luimme tapahtuman ajankohdaksi tai määräpäiväksi %@. Tarkista päivämäärä ja se, tarvitsetko kuvaa edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons relevé le %@ comme date d’événement ou d’expiration. Vérifiez la date et si la capture vous est encore utile."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léamar %@ mar dháta imeachta nó éaga. Seiceáil an dáta agus an bhfuil an seat scáileáin de dhíth ort fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznati datum događaja ili isteka: %@. Provjerite datum i trebate li još snimku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felismert esemény- vagy lejárati dátum: %@. Ellenőrizd a dátumot, és hogy kell-e még a képernyőkép."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við lásum %@ sem dagsetningu viðburðar eða gildisloka. Athugaðu dagsetninguna og hvort þú þurfir skjámyndina enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo letto %@ come data dell’evento o di scadenza. Verifica la data e se lo screenshot ti serve ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の開催日または期限を%@と読み取りました。日付が合っているか、まだ必要か、ご確認ください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Renginio ar galiojimo pabaigos datą perskaitėme kaip %@. Patikrink datą ir ar ekrano kopijos dar reikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notikuma vai derīguma datumu nolasījām kā %@. Pārbaudi datumu un to, vai ekrānuzņēmums vēl vajadzīgs."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qrajna %@ bħala d-data tal-avveniment jew tal-iskadenza. Iċċekkja d-data u ara jekk għadx għandek bżonn l-iscreenshot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi leste %@ som arrangements- eller utløpsdato. Sjekk datoen og om du fortsatt trenger skjermbildet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We lezen %@ als de evenementdatum of vervaldatum. Controleer de datum en of je de schermafbeelding nog nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytana data wydarzenia lub ważności to %@. Sprawdź datę i zdecyduj, czy zrzut jest nadal potrzebny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemos %@ como data do evento ou de validade. Confirma a data e se ainda precisas da captura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am citit %@ ca dată a evenimentului sau a expirării. Verifică data și dacă mai ai nevoie de captură."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznaný dátum udalosti alebo platnosti: %@. Overte dátum aj to, či snímku ešte potrebujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznani datum dogodka ali izteka: %@. Preverite datum in ali posnetek še potrebujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi läste %@ som evenemangs- eller slutdatum. Kontrollera datumet och om du fortfarande behöver skärmbilden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราอ่านวันที่จัดงานหรือวันหมดอายุได้ว่า %@ ลองตรวจสอบวันที่แล้วยังจำเป็นต้องเก็บภาพนี้ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoco đọc được ngày tổ chức hoặc hết hạn là %@. Hãy kiểm tra ngày và xem bạn còn cần ảnh này không."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面上辨識到的活動日期或使用期限是%@。請確認日期是否正確，以及是否還需要這張截圖。"
          }
        }
      }
    },
