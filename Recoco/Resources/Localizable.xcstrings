    "남긴 글과 작은 사진 미리보기는 기록에 남아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남긴 글과 작은 사진 미리보기는 기록에 남아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note and its saved thumbnail will stay."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележката и запазеното умалено изображение ще останат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámka i její miniatura zůstanou uložené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din note og det gemte miniaturebillede bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notiz und die gespeicherte Fotovorschau bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημείωση και η αποθηκευμένη μικρογραφία θα παραμείνουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservarán tu nota y la miniatura guardada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märge ja selle salvestatud pisipilt jäävad alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanosi ja sen tallennettu esikatselukuva säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre note et sa miniature enregistrée seront conservées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanfaidh do nóta agus a mhioníomhá shábháilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješka i spremljena minijatura ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzet és a mentett bélyegkép megmarad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnispunkturinn og vistuð smámynd verða áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota e la miniatura salvata saranno conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの文章と保存済みのサムネイルは残ります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užrašas ir jo išsaugota miniatiūra liks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīme un saglabātais sīktēls paliks."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-nota u l-minjatura salvata jibqgħu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatet og det lagrede miniatyrbildet beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notitie en de bewaarde miniatuur blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatka i jej miniatura zostaną zachowane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota e a miniatura guardada mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița și miniatura salvată vor fi păstrate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámka aj jej miniatúra zostanú uložené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležka in shranjena sličica ostaneta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din anteckning och den sparade miniatyrbilden finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกและรูปย่อที่เก็บไว้จะยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú và ảnh thu nhỏ đã lưu vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記文字與已儲存的縮圖都會保留。"
          }
        }
      }
    },
    "남긴 글과 저장된 작은 미리보기는 남아요. 미리보기가 없는 기록에서는 사진이 보이지 않을 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남긴 글과 저장된 작은 미리보기는 남아요. 미리보기가 없는 기록에서는 사진이 보이지 않을 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes and saved thumbnails will stay. Photos may no longer appear in notes without a thumbnail."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките и запазените умалени изображения ще останат. В бележки без такова изображение снимката може да изчезне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky a uložené miniatury zůstanou. U poznámek bez miniatury se fotka už nemusí zobrazit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter og gemte miniaturebilleder bevares. Fotos i noter uden miniaturebillede er måske ikke længere synlige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen und gespeicherte Vorschauen bleiben erhalten. Bei Notizen ohne Vorschau ist das Foto möglicherweise nicht mehr sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις και οι αποθηκευμένες μικρογραφίες θα παραμείνουν. Σε σημειώσεις χωρίς μικρογραφία, η φωτογραφία ίσως να μην εμφανίζεται πλέον."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas y las miniaturas guardadas se conservarán. Las fotos podrían dejar de aparecer en las notas sin miniatura."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkmed ja salvestatud pisipildid jäävad alles. Ilma pisipildita märkmetes ei pruugi fotot enam näha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot ja tallennetut esikatselukuvat säilyvät. Kuva ei välttämättä enää näy muistiinpanossa, jossa ei ole esikatselukuvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes et miniatures enregistrées seront conservées. Une photo peut ne plus s’afficher dans une note sans miniature."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanfaidh na nótaí agus na mioníomhánna sábháilte. Seans nach dtaispeánfar grianghraif i nótaí gan mhioníomhá."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke i spremljene minijature ostaju. U bilješkama bez minijature fotografija se možda više neće prikazivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetek és a mentett bélyegképek megmaradnak. A bélyegkép nélküli jegyzetekben előfordulhat, hogy a fotó már nem látszik."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnispunktar og vistaðar smámyndir verða áfram. Myndir birtast kannski ekki lengur í minnispunktum án smámyndar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note e le miniature salvate saranno conservate. Nelle note senza miniatura, la foto potrebbe non essere più visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの文章と保存済みのサムネイルは残ります。サムネイルのないメモでは、写真が表示されなくなることがあります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užrašai ir išsaugotos miniatiūros liks. Užrašuose be miniatiūros nuotraukos gali nebebūti rodomos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmes un saglabātie sīktēli paliks. Piezīmēs bez sīktēla attēls var vairs nebūt redzams."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti u l-minjaturi salvati jibqgħu. Ritratti f’noti bla minjatura jistgħu ma jibqgħux jidhru."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notater og lagrede miniatyrbilder beholdes. Bilder vises kanskje ikke lenger i notater uten miniatyrbilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities en bewaarde miniaturen blijven behouden. In notities zonder miniatuur is de foto mogelijk niet meer zichtbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki i zapisane miniatury pozostaną. W notatkach bez miniatur zdjęcia mogą przestać się wyświetlać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas e as miniaturas guardadas mantêm-se. As fotografias podem deixar de aparecer em notas sem miniatura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele și miniaturile salvate vor fi păstrate. În notițele fără miniatură, poza ar putea să nu mai apară."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky a uložené miniatúry zostanú. V poznámkach bez miniatúry sa fotka už nemusí zobraziť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležke in shranjene sličice ostanejo. Pri beležkah brez sličice se fotografija morda ne bo več prikazovala."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar och sparade miniatyrbilder finns kvar. I anteckningar utan miniatyrbild kanske fotot inte längre visas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกและรูปย่อที่เก็บไว้ยังอยู่ บันทึกที่ไม่มีรูปย่ออาจไม่แสดงรูปอีก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú và ảnh thu nhỏ vẫn còn. Ghi chú nào không có ảnh thu nhỏ có thể không hiển thị ảnh nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記文字和已儲存的縮圖都會保留。沒有縮圖的筆記可能無法再顯示照片。"
          }
        }
      }
    },
    "남긴 글은 유지되지만, 기록의 사진은 보이지 않을 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남긴 글은 유지되지만, 기록의 사진은 보이지 않을 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note will stay, but its photo may no longer appear."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележката ще остане, но снимката може вече да не се показва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámka zůstane, fotka se už ale nemusí zobrazit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din note bevares, men fotoet er måske ikke længere synligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notiz bleibt erhalten, das Foto ist dort aber möglicherweise nicht mehr sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημείωση θα παραμείνει, αλλά η φωτογραφία ενδέχεται να μην εμφανίζεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nota se conservará, pero es posible que su foto ya no se muestre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märge jääb alles, kuid foto ei pruugi selles enam nähtav olla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanosi säilyy, mutta sen kuva ei välttämättä enää näy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre note sera conservée, mais sa photo pourrait ne plus s’afficher."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanfaidh an nóta, ach seans nach dtaispeánfar an grianghraf ann a thuilleadh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješka ostaje, no fotografija se možda više neće prikazivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzet megmarad, de a fotó lehet, hogy már nem jelenik meg benne."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnispunkturinn verður áfram en myndin birtist kannski ekki lengur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota sarà conservata, ma la foto potrebbe non essere più visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの文章は残りますが、写真は表示されなくなることがあります。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užrašas liks, bet nuotrauka jame gali nebebūti rodoma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīme paliks, taču attēls tajā var vairs nebūt redzams."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-nota tibqa’, iżda r-ritratt jista’ ma jibqax jidher fiha."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatet beholdes, men bildet vises kanskje ikke lenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notitie blijft bewaard. De foto is mogelijk niet meer zichtbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatka zostanie, ale zdjęcie może przestać się wyświetlać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota mantém-se, mas a fotografia poderá deixar de aparecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița se păstrează, dar poza ar putea să nu mai fie vizibilă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámka zostane, ale fotka sa už nemusí zobraziť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležka ostane, vendar fotografije morda ne bo več mogoče prikazati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din anteckning finns kvar, men fotot kanske inte längre visas."
          }
        },
        "th": {
