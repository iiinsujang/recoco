    "%lld일 뒤부터 다시 확인할 사진에 넣어둘게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 뒤부터 다시 확인할 사진에 넣어둘게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days until we can suggest this photo again: %lld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни до следващо възможно предложение на тази снимка: %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet dní do dalšího doporučení: %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dage, før fotoet kan foreslås igen: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage bis zum nächsten möglichen Vorschlag: %lld."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ημέρες μέχρι να μπορεί να προταθεί ξανά η φωτογραφία: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días hasta que podamos volver a sugerir esta foto: %lld."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päevi järgmise võimaliku soovituseni: %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päiviä siihen, että kuvaa voidaan ehdottaa uudelleen: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours avant de pouvoir proposer à nouveau cette photo : %lld."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Laethanta go dtí gur féidir an grianghraf a mholadh arís: %lld."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj dana do sljedećeg prijedloga: %lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napok a fotó következő lehetséges javaslatáig: %lld."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagar þar til hægt er að stinga aftur upp á þessari mynd: %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni prima di poter riproporre questa foto: %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日後から、また見直す候補に入れます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienų, kol vėl galėsime pasiūlyti šią nuotrauką: %lld."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienas līdz nākamajam iespējamajam ieteikumam: %lld."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiem sakemm nistgħu nerġgħu nissuġġerixxu dan ir-ritratt: %lld."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dager til bildet kan foreslås igjen: %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen tot deze foto weer kan worden voorgesteld: %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba dni do ponownej propozycji: %lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias até esta fotografia poder ser sugerida de novo: %lld."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zile până când poza poate fi sugerată din nou: %lld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet dní do ďalšieho odporúčania: %lld."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Število dni do naslednjega predloga: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagar tills fotot kan föreslås igen: %lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีก %lld วันจึงจะแนะนำรูปนี้ได้อีกครั้ง"
