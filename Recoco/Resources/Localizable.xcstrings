          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny funkce můžete používat bez přihlášení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bruge alle funktioner uden at logge ind."
