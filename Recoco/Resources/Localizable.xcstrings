            "state": "translated",
            "value": "Αυτό είναι πρόχειρο. Αποθήκευσέ το για να κρατήσεις το κείμενο και μια μικρή προεπισκόπηση στη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un borrador. Guárdalo para conservar el texto y una pequeña vista previa de la foto en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
