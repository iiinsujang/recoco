        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es el día que elegiste para volver a revisar esta foto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna on päev, mille valisid selle foto uuesti vaatamiseks."
