    "선택한 사진 안에서만 추천을 찾아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사진 안에서만 추천을 찾아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll only look through the photos you select."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще търсим само сред снимките, които избереш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projdeme jen fotky, které vyberete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi søger kun blandt de fotos, du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir suchen nur unter den Fotos, die du auswählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ψάχνουμε μόνο στις φωτογραφίες που επιλέγεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo buscaremos entre las fotos que selecciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatame ainult sinu valitud fotosid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsimme vain valitsemistasi kuvista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les photos que vous sélectionnez seront examinées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní sheiceáilfimid ach na grianghraif a roghnaíonn tú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledat ćemo samo fotografije koje odaberete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az általad kijelölt fotók között keresünk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við skoðum aðeins myndirnar sem þú velur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlleremo solo le foto che selezioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ写真の中だけから探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieškosime tik tavo pasirinktose nuotraukose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meklēsim tikai tevis atlasītajos attēlos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Infittxu biss fost ir-ritratti li tagħżel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi søker bare blant bildene du velger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We bekijken alleen de foto’s die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzimy tylko wybrane przez Ciebie zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só procuramos nas fotografias que selecionares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutăm doar printre pozele selectate de tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezrieme iba fotky, ktoré vyberiete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledali bomo le fotografije, ki jih izberete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi söker enbart bland de foton du väljer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะค้นหาเฉพาะในรูปที่คุณเลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoco chỉ tìm trong những ảnh bạn chọn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們只會從你選取的照片中尋找建議。"
          }
        }
      }
    },
    "선택한 사진만 삭제합니다. iOS 확인창에서 한 번 더 확인할 수 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사진만 삭제합니다. iOS 확인창에서 한 번 더 확인할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected photos will be deleted. iOS will ask you to confirm."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще бъдат изтрити само избраните снимки. iOS ще поиска потвърждение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažou se jen vybrané fotky. iOS vás ještě požádá o potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de valgte billeder slettes. iOS beder dig om at bekræfte først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte Fotos werden gelöscht. iOS bittet dich noch einmal um Bestätigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα διαγραφούν μόνο οι επιλεγμένες φωτογραφίες. Το iOS θα σου ζητήσει επιβεβαίωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borrarán las fotos seleccionadas. iOS te pedirá que confirmes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse ainult valitud fotod. iOS palub sul seda kinnitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain valitsemasi kuvat poistetaan. iOS pyytää vielä vahvistuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les photos sélectionnées seront supprimées. iOS vous demandera de confirmer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní scriosfar ach na grianghraif roghnaithe. Iarrfaidh iOS ort é a dheimhniú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisat će se samo odabrane fotografije. iOS će zatražiti potvrdu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kijelölt fotók törlődnek. Az iOS még egyszer megerősítést kér."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins völdum myndum verður eytt. iOS biður þig um staðfestingu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminate solo le foto selezionate. iOS ti chiederà di confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ写真だけを削除します。iOSの確認画面でもう一度確認できます。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus ištrintos tik pasirinktos nuotraukos. „iOS“ paprašys patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks dzēsti tikai atlasītie attēli. iOS lūgs apstiprinājumu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitħassru biss ir-ritratti magħżula. iOS jitolbok tikkonferma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare de valgte bildene blir slettet. iOS ber deg om å bekrefte først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de geselecteerde foto’s worden verwijderd. iOS vraagt je eerst om bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte zostaną tylko zaznaczone zdjęcia. iOS poprosi jeszcze o potwierdzenie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só serão apagadas as fotografias selecionadas. O iOS pede uma confirmação final."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vor șterge doar pozele selectate. iOS îți va cere să confirmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažú sa iba vybrané fotky. iOS vás ešte požiada o potvrdenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisane bodo le izbrane fotografije. iOS vas bo prosil za potrditev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara markerade bilder raderas. iOS ber dig först att bekräfta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเฉพาะรูปที่เลือก iOS จะขอให้คุณยืนยันอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ảnh đã chọn mới bị xóa. iOS sẽ yêu cầu bạn xác nhận."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除所選照片，iOS 還會請你再次確認。"
          }
        }
      }
    },
    "선택한 사진만 허용해도 괜찮아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사진만 허용해도 괜찮아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can allow access to selected photos only."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш да разрешиш достъп само до избрани снимки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup můžete povolit jen k vybraným fotkám."
          }
        },
        "da": {
