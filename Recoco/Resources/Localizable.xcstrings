    },
    "비운 사진은 앱에서 삭제 완료를 확인한 수예요. 확보한 저장 공간이나 최근 삭제된 항목에서의 영구 삭제를 뜻하지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비운 사진은 앱에서 삭제 완료를 확인한 수예요. 확보한 저장 공간이나 최근 삭제된 항목에서의 영구 삭제를 뜻하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleared photos count confirmed deletions in Recoco. This doesn’t measure freed storage or permanent deletions from Recently Deleted."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Броим потвърдените изтривания в Recoco. Това не измерва освободеното място или окончателното изтриване от „Наскоро изтрити“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítávají se potvrzená smazání v Recoco. Číslo neudává uvolněné místo ani trvalá odstranění z alba Nedávno smazané."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun bekræftede sletninger i Recoco tæller med. Tallet måler ikke frigivet lagerplads eller fotos, der er slettet permanent fra Slettet for nylig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt werden bestätigte Löschungen in Recoco. Die Zahl steht weder für freigegebenen Speicherplatz noch für dauerhafte Löschungen aus „Zuletzt gelöscht“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετράμε τις επιβεβαιωμένες διαγραφές στο Recoco. Το σύνολο δεν μετρά τον χώρο που ελευθερώθηκε ούτε τις οριστικές διαγραφές από τις «Πρόσφατες διαγραφές»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuentan los borrados confirmados en Recoco. No se mide el espacio liberado ni las fotos borradas definitivamente de «Eliminado»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatute arv näitab Recocos kinnitatud kustutamisi. See ei mõõda vabastatud ruumi ega albumist Hiljuti kustutatud jäädavalt eemaldatud fotosid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistettujen kuvien määrä sisältää Recocossa vahvistetut poistot. Se ei mittaa vapautunutta tallennustilaa eikä pysyviä poistoja Äskettäin poistetut -kokoelmasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le total correspond aux suppressions confirmées dans Recoco. Il ne mesure ni l’espace libéré ni les suppressions définitives de « Supprimées récemment »."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní chomhairtear ach scriosadh a dheimhnigh Recoco. Ní thomhaistear an spás a saoradh ná scriosadh buan ón albam Scriosta le déanaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubrojena su potvrđena brisanja u aplikaciji Recoco. Broj ne pokazuje oslobođeni prostor ni trajna brisanja iz albuma Nedavno obrisano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a Recocóban megerősített törléseket számoljuk. A szám nem a felszabadult tárhelyet vagy a Nemrég törölt albumból végleg törölt fotókat jelzi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins staðfestar eyðingar í Recoco telja. Ekki er mælt losað geymslupláss eða endanleg eyðing úr Nýlega eytt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il totale conta le eliminazioni confermate in Recoco. Non misura lo spazio liberato né le eliminazioni definitive da “Eliminati di recente”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Recocoで削除を確認できた写真を数えます。空いた容量や「最近削除した項目」からの完全削除を測るものではありません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaičiuojamos tik „Recoco“ patvirtintos ištrintos nuotraukos. Tai nereiškia atlaisvintos vietos ar visam laikui iš albumo „Neseniai ištrinta“ ištrintų nuotraukų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēsto attēlu skaitā ir Recoco apstiprinātās dzēšanas. Tas nerāda atbrīvoto vietu vai neatgriezenisku dzēšanu no albuma Nesen dzēstie."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jingħaddu biss it-tħassiriet ikkonfermati f’Recoco. Ma jitkejjilx l-ispazju meħlus jew it-tħassir permanenti mill-album Imħassra reċentement."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare bekreftede slettinger i Recoco telles. Dette måler verken frigjort lagringsplass eller bilder slettet permanent fra Nylig slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bevestigde verwijderingen via Recoco tellen mee. Dit zegt niets over vrijgekomen opslagruimte of permanent verwijderde foto’s in ‘Recent verwijderd’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba usuniętych zdjęć obejmuje potwierdzone usunięcia w Recoco. Nie oznacza ilości zwolnionego miejsca ani liczby zdjęć trwale usuniętych z albumu „Ostatnio usunięte”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contamos apenas as fotografias cujo apagamento foi confirmado na Recoco. O total não mede o espaço libertado nem o apagamento definitivo em «Apagado recentemente»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărăm doar ștergerile confirmate în Recoco. Totalul nu măsoară spațiul eliberat și nici ștergerile definitive din „Șterse recent”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítavajú sa potvrdené vymazania v Recoco. Číslo neudáva uvoľnené miesto ani trvalé odstránenia z albumu Nedávno vymazané."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Štejejo le potrjeni izbrisi v aplikaciji Recoco. Podatek ne meri sproščenega prostora ali trajnih izbrisov iz razdelka Nedavno izbrisano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast bekräftade raderingar i Recoco räknas. Det här mäter varken frigjort lagringsutrymme eller foton som raderats permanent från Senast raderade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดรูปที่ลบนับเฉพาะการลบที่ยืนยันแล้วในรีโคโค ไม่ได้วัดพื้นที่ว่างหรือการลบถาวรจากอัลบั้มที่ลบล่าสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số ảnh đã xóa chỉ tính những lần Recoco xác nhận xóa thành công, không phải dung lượng đã giải phóng hay số ảnh đã xóa vĩnh viễn khỏi mục Đã xóa gần đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅計算已確認透過 Recoco 刪除的照片，不代表實際釋出的空間，也不包含從「最近刪除」永久刪除的數量。"
          }
        }
      }
    },
