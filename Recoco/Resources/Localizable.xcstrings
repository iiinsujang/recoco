    "비우기를 취소했어요. 사진은 그대로예요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비우기를 취소했어요. 사진은 그대로예요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion canceled. Your photos are unchanged."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтриването е отменено. Снимките ти не са променени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mazání zrušeno. Váš výběr se nezměnil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletning annulleret. Dit valg er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen abgebrochen. Deine Fotos bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή ακυρώθηκε. Οι φωτογραφίες δεν άλλαξαν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cancelado el borrado. Tus fotos siguen intactas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutamine katkestati. Sinu fotod jäid alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poisto peruutettiin. Valintasi säilyi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppression annulée. Vos photos sont intactes."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cealaíodh an scriosadh. Tá do ghrianghraif gan athrú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje je otkazano. Vaš odabir ostaje isti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törlés megszakítva. A fotók változatlanok."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hætt var við eyðingu. Myndirnar þínar eru óbreyttar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminazione annullata. Le foto non sono state modificate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除をキャンセルしました。写真はそのままです。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrynimas atšauktas. Tavo nuotraukos nepakito."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēšana atcelta. Attēli ir neskarti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tħassir ġie kkanċellat. Ir-ritratti tiegħek ma nbidlux."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettingen ble avbrutt. Utvalget ditt er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen geannuleerd. Je selectie is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano usuwanie. Zaznaczenie pozostaje bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O apagamento foi cancelado. As fotografias estão intactas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea a fost anulată. Pozele au rămas neschimbate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazanie bolo zrušené. Váš výber zostal nezmenený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje je preklicano. Vaš izbor je ohranjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderingen avbröts. Dina val är kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการลบแล้ว รูปของคุณยังอยู่เหมือนเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy xóa. Ảnh của bạn vẫn còn nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消刪除，照片都還在。"
          }
        }
      }
    },
