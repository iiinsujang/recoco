    "다시 홈에 오면 이어서 찾아볼게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 홈에 오면 이어서 찾아볼게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll pick up where we left off when you return to Home."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще продължим, когато се върнете на началния екран."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až se vrátíte na hlavní obrazovku, budeme pokračovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fortsætter, når du vender tilbage til Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du zur Startseite zurückkehrst, suchen wir weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα συνεχίσουμε όταν επιστρέψεις στην αρχική οθόνη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguiremos donde lo dejamos cuando vuelvas a Inicio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätkame, kui naased avakuvale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkamme, kun palaat aloitusnäkymään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous reprendrons à votre retour à l’accueil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Leanfaimid ar aghaidh nuair a fhillfidh tú ar an scáileán baile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavit ćemo kad se vratite na početni zaslon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor visszatérsz a kezdőlapra, folytatjuk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við höldum áfram þegar þú kemur aftur á heimaskjáinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprenderemo quando tornerai alla schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームに戻ると、続きから探します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grįžus į pradžios ekraną, tęsime paiešką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turpināsim, kad atgriezīsieties sākuma ekrānā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomplu minn fejn ħallejna meta terġa’ lura għall-paġna ewlenija."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fortsetter når du kommer tilbake til Hjem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gaan verder wanneer je terugkomt op het startscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrócimy do przeglądania, gdy otworzysz ekran główny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuaremos quando regressar ao ecrã inicial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom continua când revii la ecranul principal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa vrátite na úvodnú obrazovku, budeme pokračovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaljevali bomo, ko se vrnete na začetni zaslon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fortsätter när du kommer tillbaka till Hem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะค้นหาต่อเมื่อคุณกลับมาที่หน้าหลัก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn quay lại Trang chủ, chúng mình sẽ tiếp tục tìm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到首頁時，我們會接著尋找。"
          }
        }
      }
    }
  },
  "version": "1.0"
