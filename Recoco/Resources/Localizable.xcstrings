    "기록에 적었던 다른 단어로 찾아보세요. 저장한 기록은 그대로 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에 적었던 다른 단어로 찾아보세요. 저장한 기록은 그대로 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another word from your note. Your saved notes are still here."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опитай с друга дума от бележката. Запазените бележки са си тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste jiné slovo z poznámky. Vaše uložené poznámky zůstaly zachované."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv et andet ord fra noten. Dine gemte noter er her stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es mit einem anderen Wort aus der Notiz. Deine gespeicherten Notizen sind noch da."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε άλλη λέξη από τη σημείωση. Οι αποθηκευμένες σημειώσεις σου είναι ακόμη εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otra palabra de la nota. Tus notas guardadas siguen ahí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi mõnda muud sõna oma märkest. Salvestatud märkmed on alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile toista muistiinpanossa olevaa sanaa. Tallennetut muistiinpanosi ovat tallella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez avec un autre mot de la note. Vos notes enregistrées sont toujours là."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bain triail as focal eile ón nóta. Tá na nótaí sábháilte fós anseo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte s drugom riječi iz bilješke. Vaše spremljene bilješke još su tu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálj másik szót a jegyzetből. A mentett jegyzeteid továbbra is megvannak."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Prófaðu annað orð úr minnispunktinum. Vistaðir minnispunktar eru hér enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova con un’altra parola della nota. Le note salvate sono ancora qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの文章にある別の言葉で探してみてください。保存したメモは残っています。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandyk kitą žodį iš užrašo. Išsaugoti užrašai tebėra čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēģini citu vārdu no piezīmes. Saglabātās piezīmes joprojām ir šeit."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipprova kelma oħra min-nota. In-noti salvati għadhom hawn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv et annet ord fra notatet. De lagrede notatene dine er fortsatt her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een ander woord uit je notitie. Je bewaarde notities staan er nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj wyszukać inne słowo z notatki. Twoje notatki nadal są zapisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
