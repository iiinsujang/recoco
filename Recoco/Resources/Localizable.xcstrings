    "모두 살펴봤어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 살펴봤어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reviewed them all."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледа ги всички."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prošli jste všechny fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har gennemgået dem alle."
          }
        },
        "de": {
