    "홈에서 오늘의 사진을\n정리해보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈에서 오늘의 사진을\n정리해보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Home to look through\ntoday’s photos."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори началото, за да разгледаш\nснимките за днес."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na domovské obrazovce si prohlédněte\ndnešní fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til Start for at gennemgå\ndagens fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Start-Tab und sieh dir\ndie Fotos für heute an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε την αρχική για να δεις\nτις σημερινές φωτογραφίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Inicio para revisar\nlas fotos de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava avaleht, et vaadata\ntänaseid fotosid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Koti ja käy läpi\ntämän päivän kuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’accueil pour examiner\nles photos du jour."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscail Baile chun grianghraif\nan lae inniu a fheiceáil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite početni zaslon i pregledajte\ndanašnje fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a kezdőlapot, és nézd át\na mai fotókat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu heimaflipann til að skoða\nmyndir dagsins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la Home per rivedere\nle foto di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームを開いて、\n今日の写真を見てみましょう。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atverk pradžią ir peržiūrėk\nšiandienos nuotraukas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atver sākumlapu, lai pārskatītu\nšodienas attēlus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iftaħ il-paġna ewlenija biex tara\nr-ritratti tal-lum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Hjem for å se gjennom\ndagens bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar Start om de foto’s van vandaag\nte bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ekran główny, aby obejrzeć\ndzisiejsze zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o início para rever\nas fotografias de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide pagina principală pentru a vedea\npozele de astăzi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na domovskej obrazovke si prezrite\ndnešné fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite začetni zaslon in si oglejte\ndanašnje fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Hem för att granska\ndagens foton."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่หน้าหลักเพื่อดู\nรูปของวันนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào Trang chủ để xem lại\nnhững ảnh của hôm nay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到首頁，\n看看今天的照片。"
          }
        }
      }
    },
