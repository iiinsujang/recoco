        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar neperžiūrėjome visų nuotraukų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl neesam pārskatījuši visus fotoattēlus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadna ma ċċekkjajniex ir-ritratti kollha."
