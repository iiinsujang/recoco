    "앱의 로그인 연결을 확인해야 해요. 계정이나 비밀번호의 문제는 아니에요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 로그인 연결을 확인해야 해요. 계정이나 비밀번호의 문제는 아니에요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in needs to be set up in the app. Your account and password are fine."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Трябва да се провери настройката за вход в приложението. Акаунтът и паролата ти са наред."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení je potřeba nastavit v aplikaci. Váš účet i heslo jsou v pořádku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login skal konfigureres i appen. Der er ikke noget galt med din konto eller adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist in der App noch nicht eingerichtet. Account und Passwort sind in Ordnung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση πρέπει να ρυθμιστεί στην εφαρμογή. Ο λογαριασμός και το συνθηματικό σου είναι εντάξει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que configurar el inicio de sesión en la app. Tu cuenta y contraseña son correctas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduse sisselogimise seadistus vajab kontrollimist. Sinu konto ja parool on korras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuminen on vielä määritettävä appiin. Tilissäsi tai salasanassasi ei ole vikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion doit être configurée dans l’app. Votre compte et votre mot de passe ne sont pas en cause."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní mór síniú isteach a shocrú san aip. Níl fadhb le do chuntas ná do phasfhocal."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavu treba postaviti u aplikaciji. S vašim računom i lozinkom sve je u redu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app bejelentkezési beállításait kell beállítani. A fiókoddal és a jelszavaddal nincs gond."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Setja þarf upp innskráningu í appinu. Ekkert er að reikningnum þínum eða lykilorðinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso deve essere configurato nell’app. Il problema non riguarda il tuo account o la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ側でサインインの設定が必要です。アカウントやパスワードに問題はありません。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reikia patikrinti programos prisijungimo sąranką. Tavo paskyra ir slaptažodis tvarkingi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jāpārbauda pierakstīšanās konfigurācija lietotnē. Tavs konts un parole ir kārtībā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Id-dħul irid jiġi kkonfigurat fl-app. Il-kont u l-password tiegħek huma tajbin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlogging må konfigureres i appen. Kontoen og passordet ditt er i orden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen moet nog worden ingesteld in de app. Je account en wachtwoord zijn in orde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wymaga konfiguracji w aplikacji. Twoje konto i hasło są w porządku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso configurar o início de sessão na app. A tua conta e palavra-passe estão corretas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea trebuie configurată în aplicație. Contul și parola ta sunt în regulă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie treba nastaviť v apke. Váš účet aj heslo sú v poriadku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavo je treba nastaviti v aplikaciji. Z vašim računom in geslom je vse v redu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggning måste ställas in i appen. Ditt konto och lösenord fungerar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องตรวจสอบการตั้งค่าการลงชื่อเข้าของแอป บัญชีและรหัสผ่านของคุณไม่มีปัญหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cần thiết lập lại kết nối đăng nhập. Tài khoản và mật khẩu của bạn không có vấn đề."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 的登入功能尚待設定，你的帳號和密碼沒有問題。"
          }
        }
      }
    },
    "어떻게 골라주나요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떻게 골라주나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you choose?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Как избираш?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak fotky vybíráš?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan vælger du dem?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wählst du sie aus?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς τις διαλέγεις;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo las eliges?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas sa valid?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miten valitset kuvat?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment les choisis-tu ?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Conas a roghnaítear iad?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako ih biraš?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogyan választasz?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvernig velurðu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come le scegli?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どうやって選ぶの？"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaip atrenki?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kā tu izvēlies?"
          }
        },
        "mt": {
          "stringUnit": {
