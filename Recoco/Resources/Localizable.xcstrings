    "기록을 삭제해도 저장 활동은 남아요. 보관 중인 전체 기록은 현재 남아 있는 기록 수예요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 삭제해도 저장 활동은 남아요. 보관 중인 전체 기록은 현재 남아 있는 기록 수예요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a note leaves the original save in your activity. Your total shows the notes you still have."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При изтриване на бележка първоначалното запазване остава в историята. Общият брой показва бележките, които все още имаш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I po smazání poznámky zůstane její původní uložení v historii aktivity. Celkový počet uvádí poznámky, které stále máte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter du en note, tæller den oprindelige lagring stadig med i din aktivitet. Totalen viser de noter, du har nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Notiz löschst, bleibt das ursprüngliche Speichern im Verlauf. Die Gesamtsumme zeigt nur noch vorhandene Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή σημείωσης διατηρεί στο ιστορικό την αρχική αποθήκευση. Το σύνολο δείχνει τις σημειώσεις που έχεις ακόμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar una nota no borra del historial la acción de guardarla. El total indica las notas que todavía conservas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märke kustutamine ei eemalda selle salvestamist tegevuste ajaloost. Koguarv näitab allesolevaid märkmeid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanon poistaminen ei poista alkuperäistä tallennusta toimintatilastosta. Kokonaismäärä kertoo, montako muistiinpanoa on tallella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer une note n’efface pas sa création de l’historique. Le total indique les notes encore conservées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má scriosann tú nóta, fanann an tsábháil sa stair. Ní léiríonn an t-iomlán ach na nótaí atá agat fós."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad izbrišete bilješku, njezino prvotno spremanje ostaje u povijesti aktivnosti. Ukupan broj prikazuje bilješke koje još imate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzet törlése nem törli az eredeti mentést az előzményekből. Az összesítő a még meglévő jegyzeteket mutatja."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þótt minnispunkti sé eytt helst vistunin í virknisögunni. Heildarfjöldinn sýnir minnispunktana sem þú geymir núna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare una nota non cancella dalla cronologia il salvataggio iniziale. Il totale indica le note ancora conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを削除しても、保存したときの履歴は残ります。メモの総数は、今も保存している件数です。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrynus užrašą pirminis išsaugojimas lieka veiklos istorijoje. Bendras skaičius rodo šiuo metu turimus užrašus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēšot piezīmi, sākotnējā saglabāšana paliek darbību vēsturē. Kopskaits rāda pašlaik paturētās piezīmes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jekk tħassar nota, l-azzjoni oriġinali tas-salvataġġ tibqa’ fl-attività. It-total juri n-noti li għadek iżżomm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du sletter et notat, teller den opprinnelige lagringen fortsatt i aktiviteten. Totalen viser notatene du har nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een notitie verwijdert, blijft de oorspronkelijke opslagactie meetellen. Je totaal toont hoeveel notities je nu bewaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po usunięciu notatki jej pierwotny zapis pozostaje w historii aktywności. Łączna liczba pokazuje notatki, które nadal masz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar uma nota mantém o registo da ação de a guardar. O total mostra só as notas que ainda tens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea unei notițe păstrează în istoric salvarea inițială. Totalul arată notițele pe care le mai ai."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aj po vymazaní poznámky zostane jej pôvodné uloženie v histórii aktivity. Celkový počet uvádza poznámky, ktoré stále máte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko izbrišete beležko, njena prvotna shranitev ostane v zgodovini dejavnosti. Skupno število prikazuje beležke, ki jih še imate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du raderar en anteckning räknas den ursprungliga sparåtgärden fortfarande i aktiviteten. Totalt visas hur många anteckningar du har kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อลบบันทึก ประวัติการบันทึกครั้งเดิมยังอยู่ ยอดรวมแสดงจำนวนบันทึกที่ยังเก็บไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa ghi chú không xóa lượt lưu khỏi lịch sử hoạt động. Tổng số ghi chú chỉ tính những ghi chú bạn còn giữ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除筆記後，當初儲存的活動紀錄仍會保留。筆記總數只計算目前仍保留的筆記。"
          }
        }
      }
    },
