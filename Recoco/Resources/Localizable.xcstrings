    "리포트에는 리코코에서 비운 이력이 남아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리포트에는 리코코에서 비운 이력이 남아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report keeps a history of photos deleted with Recoco."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В отчета остава история на снимките, изтрити с Recoco."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V přehledu najdete historii fotek smazaných v aplikaci Recoco."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten viser historikken for de fotos, du har slettet med Recoco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Bericht bleibt vermerkt, welche Fotos du mit Recoco gelöscht hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναφορά διατηρεί το ιστορικό διαγραφών που έγιναν στο Recoco."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe mantiene un historial de lo que se ha borrado desde Recoco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülevaates säilib Recocoga kustutatud fotode ajalugu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportti sisältää Recocolla poistettujen kuvien historian."
          }
