        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bilan garde une trace des suppressions effectuées dans Recoco."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Coinnítear stair na ngrianghraf a scriosadh le Recoco sa tuairisc."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U izvješću se vidi povijest fotografija izbrisanih u aplikaciji Recoco."
