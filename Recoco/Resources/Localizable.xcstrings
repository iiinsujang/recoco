    "오늘 고른 사진을 모두 살펴봤어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 고른 사진을 모두 살펴봤어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reviewed all of today’s picks."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледа всички снимки, подбрани за днес."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny dnešní návrhy už máte prohlédnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har set alle dagens forslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle Vorschläge für heute durchgesehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είδες όλες τις σημερινές προτάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has revisado todas las sugerencias de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänased soovitused on sul kõik läbi vaadatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet katsonut kaikki tämän päivän ehdotukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez vu toutes les suggestions du jour."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá gach grianghraf a roghnaíodh inniu feicthe agat."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledali ste sve današnje prijedloge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mára az összes javaslatot átnézted."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur skoðað allar tillögur dagsins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai rivisto tutte le foto proposte oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日選んだ写真は、すべて見終わりました。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peržiūrėjai visas šiandien parinktas nuotraukas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visi šodien ieteiktie attēli ir pārskatīti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajt ir-ritratti kollha magħżula għal-lum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har sett på alle dagens forslag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt alle suggesties van vandaag bekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To już wszystkie zdjęcia zaproponowane na dziś."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já reveste todas as sugestões de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai văzut toate pozele sugerate astăzi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky dnešné návrhy už máte prezreté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogledali ste si vse današnje predloge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har tittat på alla dagens förslag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูรูปที่คัดให้วันนี้ครบแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xem hết ảnh gợi ý hôm nay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天挑出的照片都看完了。"
          }
        }
      }
    },
