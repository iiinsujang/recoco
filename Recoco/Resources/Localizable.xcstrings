    "기기 저장으로 전환하지 못했어요. 기존 기록은 그대로 있어요. 다시 시도해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 저장으로 전환하지 못했어요. 기존 기록은 그대로 있어요. 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t switch to local storage. Your records are safe. Please try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да превключим към локално съхранение. Бележките ти са запазени. Опитай отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přechod na místní úložiště se nezdařil. Vaše záznamy jsou v bezpečí. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kunne ikke skiftes til lokal lagring. Dine optegnelser er bevaret. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel zum lokalen Speicher ist fehlgeschlagen. Deine Einträge sind erhalten. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η μετάβαση σε τοπική αποθήκευση. Οι καταγραφές διατηρούνται. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cambiar al almacenamiento local. Tus registros siguen guardados. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadmesse salvestamisele ei saanud üle minna. Märkmed on alles. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliseen tallennukseen vaihtaminen ei onnistunut. Tietosi ovat tallessa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de passer au stockage local. Vos données sont conservées. Réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir aistriú go stóráil áitiúil. Tá do nótaí slán. Bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće prijeći na lokalnu pohranu. Vaši su zapisi sačuvani. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült átváltani a helyi tárhelyre. A feljegyzéseid megvannak. Próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að skipta yfir í vistun á tækinu. Minnispunktarnir þínir eru óhultir. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile passare all’archivio locale. I tuoi dati sono conservati. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の保存に切り替えられませんでした。記録は残っています。もう一度お試しください。"
